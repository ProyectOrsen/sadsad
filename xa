end
local function nearestBodyPoint(char, cursor)
local parts = visibleParts(char)
if #parts == 0 then return nil end
local origin = camera.CFrame.Position
local ray = camera:ViewportPointToRay(cursor.X, cursor.Y).Direction
local bestPart, bestQ, bestD, bestScore = nil, nil, 0, math.huge
for _, p in ipairs(parts) do
local cf, half = p.CFrame, p.Size * 0.5
local t = math.max((cf.Position - origin):Dot(ray), 0.5)
local lp = cf:PointToObjectSpace(origin + ray * t)
local q = Vector3.new(clamp(lp.X, -half.X, half.X), clamp(lp.Y, -half.Y, half.Y), clamp(lp.Z, -half.Z, half.Z))
local sp = camera:WorldToViewportPoint(cf:PointToWorldSpace(q))
if sp.Z > 0 then
local d = vlen(sp.X - cursor.X, sp.Y - cursor.Y)
local score = d - (PART_BIAS[p.Name] or 0) - ((p == st.aimPart) and C.PART_STICK_PX or 0)
if score < bestScore then bestScore, bestPart, bestQ, bestD = score, p, q, d end
end
end
if not bestPart then return nil end
-- lejos: tira hacia el centro de la parte. Encima de la parte: no te mueve.
local inward = C.PART_CENTER_PULL * smoothstep(0, C.PART_CENTER_PX, bestD)
return bestPart, bestQ:Lerp(Vector3.zero, inward), bestD
end
local function getAimPoint(char, cursor, dt, commit)
local part, q = nearestBodyPoint(char, cursor)
if not part then return nil end
return part.CFrame:PointToWorldSpace(q)
