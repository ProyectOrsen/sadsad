local function medianOf(arr)
local n = #arr
if n == 0 then return nil end
local tmp = {}
for i = 1, n do tmp[i] = arr[i] end
table.sort(tmp)
if n % 2 == 1 then return tmp[math.floor((n + 1) / 2)] end
return (tmp[n / 2] + tmp[n / 2 + 1]) * 0.5
end
local function pushSample(arr, v, maxN)
table.insert(arr, v)
while #arr > maxN do table.remove(arr, 1) end
end
local function rayBox(ox, oy, oz, dx, dy, dz, hx, hy, hz)
local tmin, tmax = -math.huge, math.huge
local o = {ox, oy, oz}; local d = {dx, dy, dz}; local h = {hx, hy, hz}
for i = 1, 3 do
local oi, di, hi = o[i], d[i], h[i]
if math.abs(di) < 1e-9 then
if oi < -hi - 1e-6 or oi > hi + 1e-6 then return nil end
else
local t1 = (-hi - oi) / di
local t2 = ( hi - oi) / di
if t1 > t2 then t1, t2 = t2, t1 end
if t1 > tmin then tmin = t1 end
if t2 < tmax then tmax = t2 end
if tmin > tmax then return nil end
end
end
return tmin, tmax
end
local function chordBox(ox, oy, oz, dx, dy, dz, hx, hy, hz)
local tmin, tmax = rayBox(ox, oy, oz, dx, dy, dz, hx, hy, hz)
if not tmin then return 0 end
return math.max(tmax - math.max(tmin, 0), 0)
end
local function chordSphere(ox, oy, oz, dx, dy, dz, r)
local b = ox * dx + oy * dy + oz * dz
local c = ox * ox + oy * oy + oz * oz - r * r
local disc = b * b - c
if disc <= 0 then return 0 end
local s = math.sqrt(disc)
local t1, t2 = -b - s, -b + s
return math.max(t2 - math.max(t1, 0), 0)
end
local function newSeparator(cfg)
local N = 8
local S = {
frame = 0, ringX = {}, ringY = {},
err = {0.0, 3.0, 6.0, 9.0}, lat = 1,
camInit = false, lastYaw = 0, lastPitch = 0,
kxs = {}, kys = {}, kx = nil, ky = nil,
rawX = 0, rawY = 0, userX = 0, userY = 0, aimX = 0, aimY = 0,
gameYaw = 0, gamePitch = 0, gamePxX = 0, gamePxY = 0,
camDYaw = 0, camDPitch = 0,
gx = 1, gy = 1, sxxX = 4, sxyX = 4, sxxY = 4, sxyY = 4,
}
for i = 0, N - 1 do S.ringX[i] = 0; S.ringY[i] = 0 end
function S.recordSend(ix, iy)
local slot = S.frame % N
S.ringX[slot] = S.ringX[slot] + ix
S.ringY[slot] = S.ringY[slot] + iy
end
function S.step(rawX, rawY, yaw, pitch, dt, camOk)
S.frame = S.frame + 1
local slot = S.frame % N
S.ringX[slot] = 0; S.ringY[slot] = 0
S.rawX, S.rawY = rawX, rawY
local ex, ey, anySend = {}, {}, 0
for L = 1, 4 do
local s = (S.frame - L) % N
ex[L] = S.ringX[s]; ey[L] = S.ringY[s]
anySend = anySend + math.abs(ex[L]) + math.abs(ey[L])
end
if anySend > 0.5 then
local a = cfg.latAlpha
for L = 1, 4 do
local dx, dy = rawX - S.gx * ex[L], rawY - S.gy * ey[L]
S.err[L] = S.err[L] * (1 - a) + (dx * dx + dy * dy) * a
end
end
local wsum, expX, expY, bestL, bestW = 0, 0, 0, 1, -1
for L = 1, 4 do
local w = 1 / ((S.err[L] + 0.5) ^ 2)
wsum = wsum + w
expX = expX + ex[L] * w; expY = expY + ey[L] * w
if w > bestW then bestW = w; bestL = L end
end
expX, expY = expX / wsum, expY / wsum
S.lat = bestL
if math.abs(expX) > 1.5 then
S.sxxX = S.sxxX * cfg.gainDecay + expX * expX
S.sxyX = S.sxyX * cfg.gainDecay + expX * rawX
S.gx = math.max(0.4, math.min(2.2, S.sxyX / S.sxxX))
end
if math.abs(expY) > 1.5 then
S.sxxY = S.sxxY * cfg.gainDecay + expY * expY
S.sxyY = S.sxyY * cfg.gainDecay + expY * rawY
S.gy = math.max(0.4, math.min(2.2, S.sxyY / S.sxxY))
end
expX, expY = expX * S.gx, expY * S.gy
S.aimX, S.aimY = expX, expY
local ux, uy = rawX - expX, rawY - expY
local slackX = cfg.deadbandMin + cfg.deadbandRel * math.abs(expX)
local slackY = cfg.deadbandMin + cfg.deadbandRel * math.abs(expY)
if math.abs(ux) > slackX then ux = ux - (ux > 0 and slackX or -slackX) else ux = 0 end
if math.abs(uy) > slackY then uy = uy - (uy > 0 and slackY or -slackY) else uy = 0 end
S.userX, S.userY = ux, uy
-- === FIX CLAUDE: deteccion de mouse cuando el script no manda nada ===
local quiet = 0
for L = 1, 6 do
local s = (S.frame - L) % N
quiet = quiet + math.abs(S.ringX[s]) + math.abs(S.ringY[s])
end
if quiet <= 0.5 then
ux, uy = rawX, rawY
S.userX, S.userY = ux, uy
end
-- ======================================================================
S.gameYaw, S.gamePitch, S.camDYaw, S.camDPitch = 0, 0, 0, 0
if camOk and S.camInit then
local dYaw = yaw - S.lastYaw
if dYaw > math.pi then dYaw = dYaw - 2 * math.pi elseif dYaw < -math.pi then dYaw = dYaw + 2 * math.pi end
local dPitch = pitch - S.lastPitch
S.camDYaw, S.camDPitch = dYaw, dPitch
local pitchOk = math.abs(pitch) < cfg.pitchLimit
if math.abs(rawX) >= cfg.kMinRaw then
local r = dYaw / rawX
if math.abs(r) > 1e-5 and math.abs(r) < 0.05 then pushSample(S.kxs, r, cfg.kSamples); S.kx = medianOf(S.kxs) end
end
if pitchOk and math.abs(rawY) >= cfg.kMinRaw then
local r = dPitch / rawY
if math.abs(r) > 1e-5 and math.abs(r) < 0.05 then pushSample(S.kys, r, cfg.kSamples); S.ky = medianOf(S.kys) end
end
if S.kx and #S.kxs >= 6 then S.gameYaw = dYaw - S.kx * rawX end
if S.ky and #S.kys >= 6 and pitchOk then S.gamePitch = dPitch - S.ky * rawY end
if math.abs(S.gameYaw) < cfg.gameDeadRad then S.gameYaw = 0 end
if math.abs(S.gamePitch) < cfg.gameDeadRad then S.gamePitch = 0 end
end
if camOk then S.lastYaw, S.lastPitch, S.camInit = yaw, pitch, true else S.camInit = false end
S.gamePxX = (S.kx and math.abs(S.kx) > 1e-6) and S.gameYaw / S.kx or 0
S.gamePxY = (S.ky and math.abs(S.ky) > 1e-6) and S.gamePitch / S.ky or 0
end
return S
end
