local function raycastToPosition(from, to, wallStop)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {}
    if player.Character then table.insert(exclude, player.Character) end
    if st.targetChar then table.insert(exclude, st.targetChar) end
    if st.aimBlock then table.insert(exclude, st.aimBlock) end
    if st.predictBlock then table.insert(exclude, st.predictBlock) end
    rp.FilterDescendantsInstances = exclude
    local dir = to - from
    if dir.Magnitude < 0.001 then return to end
    local result = workspace:Raycast(from, dir, rp)
    if result then return result.Position + result.Normal * wallStop end
    return to
end

local function updateAimBlock(targetPos, dt)
