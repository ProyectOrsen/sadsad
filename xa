fx = fx * C.ASSIST_STRENGTH * fovFade * lf * rb * ib
fy = fy * C.ASSIST_STRENGTH * fovFade * lf * rb * ib
if C.FF_ENABLE and st.aimWorldLast and st.tpIgnoreTimer <= 0 and st.tpActive < 0.3 then
