local t = clock()
if inAir and vy > C.PRED_Y_JUMP_DETECT_VEL then
if not st.jumpActive then
st.jumpActive = true
st.jumpStartTime = t
st.jumpPeakYVel = vy
st.jumpApexDetected = false
st.jumpApexTime = 0
st.jumpJustStarted = true
st.jumpV0 = vy
end
if vy > st.jumpPeakYVel then st.jumpPeakYVel = vy; st.jumpV0 = vy end
if not st.jumpApexDetected and vy < st.jumpPeakYVel * C.PRED_Y_APEX_RATIO then
st.jumpApexDetected = true
st.jumpApexTime = t
end
elseif not inAir then
st.jumpActive = false
st.jumpApexDetected = false
end
local py = 0
if inAir then
local g = workspace.Gravity
if vy > 0 then
py = math.min(vy * C.AIR_LEAD_RISE, (vy * vy) / (2 * g))
else
py = vy * C.AIR_LEAD_FALL
end
py = clamp(py, -C.AIR_Y_MAX, C.AIR_Y_MAX)
end
st.predYSmooth = expDecay(st.predYSmooth, py, C.PRED_Y_SMOOTH_TAU, dt)
return st.predYSmooth
end
local function updatePredLearn(rootPos, predOffset)
if not C.PRED_LEARN_ENABLE then return end
local t = clock()
local vx, vz = st.ffVelX, st.ffVelZ
local sp = math.sqrt(vx * vx + vz * vz)
local log = st.predLog
if sp > C.PRED_LEARN_MIN_SPEED then
log[#log + 1] = {
t = t, pos = rootPos, dx = vx / sp, dz = vz / sp,
lead = predOffset.X * vx / sp + predOffset.Z * vz / sp,
}
end
local h = C.PRED_LEARN_H_BASE + C.PRED_LEARN_H_DIST * (st.targetWorldD or 0)
while #log > 0 and (t - log[1].t) >= h do
local e = table.remove(log, 1)
if (t - e.t) < h * 2.5 and e.lead > 0.25 then
local disp = (rootPos.X - e.pos.X) * e.dx + (rootPos.Z - e.pos.z) * e.dz
local r = clamp(disp / e.lead, 0.2, 3.0)
st.predLearn = clamp(lerp(st.predLearn, st.predLearn * r, C.PRED_LEARN_RATE), C.PRED_LEARN_MIN, C.PRED_LEARN_MAX)
end
end
while #log > 90 do table.remove(log, 1) end
end
local function computePredictionConfidence(dt)
local conf = 1.0
if st.predVarSmooth > C.PRED_VARIANCE_MAX then
local over = st.predVarSmooth - C.PRED_VARIANCE_MAX
conf = conf * clamp(1 - over / C.PRED_CONFIDENCE_VAR_PENALTY, 0.0, 1.0)
end
if st.predictability < C.PRED_CONSISTENCY_MIN then
local under = C.PRED_CONSISTENCY_MIN - st.predictability
conf = conf * clamp(1 - under * C.PRED_CONFIDENCE_CONSIST_PENALTY, 0.0, 1.0)
end
if st.dirChangePending then
conf = conf * C.PRED_CONFIDENCE_DIRCHANGE_PENALTY
end
conf = math.max(C.PRED_CONFIDENCE_MIN, conf)
st.predConfidence = expDecay(st.predConfidence or 1.0, conf, C.PRED_CONFIDENCE_SMOOTH_TAU, dt)
