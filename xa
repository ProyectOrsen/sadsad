local function clamp(v, lo, hi)
  if v < lo then return lo end
  if v > hi then return hi end
  return v
end
local function lerp(a, b, t) return a + (b - a) * t end
local function smoothstep(a, b, x)
  local t = clamp((x - a) / (b - a + 1e-9), 0, 1)
  return t * t * (3 - 2 * t)
end
local function expDecay(cur, tgt, tau, dt)
  return tgt + (cur - tgt) * math.exp(-dt / math.max(tau, 1e-6))
end
local function rRange(a, b) return a + math.random() * (b - a) end
local function vlen(x, y) return math.sqrt(x * x + y * y) end
local function bell(t) return math.sin(clamp(t, 0, 1) * math.rad(180)) end
local function easeInOutCos(t) return (1 - math.cos(clamp(t, 0, 1) * math.rad(180))) * 0.5 end
local function rotate2D(x, y, ang)
  local c, s = math.cos(ang), math.sin(ang)
  return x * c - y * s, x * s + y * c
end
local function flickCurve(t)
  t = clamp(t, 0, 1)
  local ramp = 0.42
  local peak = 0.92
  if t < ramp then
    local x = t / ramp
    return peak * (x * x * (3 - 2 * x))
  elseif t > 1 - ramp then
    local x = (1 - t) / ramp
    return peak * (x * x * (3 - 2 * x))
  else
    return peak
  end
end

local function rerollAll()
  st.predVar = rRange(C.PRED_VAR_MIN, C.PRED_VAR_MAX)
  st.noiseVar = rRange(C.NOISE_VAR_MIN, C.NOISE_VAR_MAX)
  st.predInertiaVar = rRange(1 - C.PRED_INERTIA_VAR, 1 + C.PRED_INERTIA_VAR)
end

local function getCursor()
  if C.CENTER_AIM and camera then
