  dirChangePending = false,
  frozenDirValidUntil = 0,
}

local function clamp(v, lo, hi) if v < lo then return lo end; if v > hi then return hi end; return v end
local function lerp(a, b, t) return a + (b - a) * t end
local function smoothstep(a, b, x)
  local t = clamp((x - a) / (b - a + 1e-9), 0, 1); return t * t * (3 - 2 * t)
end
local function expDecay(cur, tgt, tau, dt) return tgt + (cur - tgt) * math.exp(-dt / math.max(tau, 1e-6)) end
local function rRange(a, b) return a + math.random() * (b - a) end
local function vlen(x, y) return math.sqrt(x * x + y * y) end

local function rerollAll()
  st.speedVar = 1.0
  st.predVar = rRange(C.PRED_VAR_MIN, C.PRED_VAR_MAX)
  st.noiseVar = rRange(C.NOISE_VAR_MIN, C.NOISE_VAR_MAX)
  st.predInertiaVar = rRange(1 - C.PRED_INERTIA_VAR, 1 + C.PRED_INERTIA_VAR)
end

local function getCursor()
  if C.CENTER_AIM and camera then
    local vp = camera.ViewportSize
    return Vector2.new(vp.X * 0.5 + C.CENTER_X, vp.Y * 0.5 + C.CENTER_Y)
  end
  return UserInputService:GetMouseLocation()
end

local function isMouseAtCenter()
  if not C.CENTER_REQUIRE_MOUSE then return true end
  if not camera then return false end
  local rm = UserInputService:GetMouseLocation()
  local vp = camera.ViewportSize
  local cx = vp.X * 0.5 + C.CENTER_X
  local cy = vp.Y * 0.5 + C.CENTER_Y
  return vlen(rm.X - cx, rm.Y - cy) <= C.CENTER_REQUIRE_RADIUS
end

local function isJudgeChar(char)
  if not char then return false end
  for _, kw in ipairs(C.JUDGE_KEYWORDS) do if string.find(char.Name, kw) then return true end end
  return false
end
local function hasFilter(name)
  for _, f in ipairs(USER.TARGET_FILTERS) do if f == name then return true end end
  return false
end
local function findPart(char, name)
