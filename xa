local function getMouse()
    return UserInputService:GetMouseLocation()
end

local function getAimCursor()
    if C.CENTER_AIM and camera then
        local vp = camera.ViewportSize
        return Vector2.new(
            (vp.X / 2) + C.CENTER_OFFSET_X,
            (vp.Y / 2) + C.CENTER_OFFSET_Y
        )
    end

    return getMouse()
end

local function rRange(a, b)
    return a + math.random() * (b - a)
end

local function clamp(v, l, h)
    return v < l and l or (v > h and h or v)
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function takeAccumulator(acc, step)
    if step <= 0 then
        return acc, 0
    end

    if math.abs(acc) < step then
        return 0, acc
    end

    local steps = math.floor(math.abs(acc) / step)
    local send = steps * step

    if acc < 0 then
        send = -send
    end

    return send, acc - send
end

local function sendMouseRelative(x, y)
    x = x * (C.MOUSE_OUTPUT_SCALE or 1.0)
    y = y * (C.MOUSE_OUTPUT_SCALE or 1.0)

    st.moveAccX = (st.moveAccX or 0) + x
    st.moveAccY = (st.moveAccY or 0) + y

    local minStep = C.MOUSE_MIN_STEP or 0.0

    local sendX, remX = takeAccumulator(st.moveAccX, minStep)
    local sendY, remY = takeAccumulator(st.moveAccY, minStep)

    st.moveAccX = remX
    st.moveAccY = remY

    if sendX ~= 0 or sendY ~= 0 then
        pcall(function()
            mousemoverel(sendX, sendY)
        end)
    end

    st.lastCmdX = sendX
    st.lastCmdY = sendY
end

