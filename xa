local fvz = st.hiddenNow and st.lastVisVelZ or st.ffVelZ
local p0 = camera:WorldToViewportPoint(st.aimWorldLast)
local p1 = camera:WorldToViewportPoint(st.aimWorldLast + Vector3.new(fvx, 0, fvz) * 0.05)
if p0.Z > 0 and p1.Z > 0 then
local ffs = (1 - st.userMoveInf) * (st.predConfidence or 1) * reactRamp * acqEnv * fovFade * lf * (1 - manualCut * C.MANUAL_CUT_MAX)
local ffx = clamp((p1.X - p0.X) / 0.05 * dt * C.FF_GAIN * ffs, -C.FF_MAX_PX, C.FF_MAX_PX)
local ffy = clamp((p1.Y - p0.Y) / 0.05 * dt * C.FF_GAIN * ffs, -C.FF_MAX_PX, C.FF_MAX_PX)
fx = fx + ffx
fy = fy + ffy
end
end
local oa = 1 - math.exp(-dt / math.max(C.OUT_SMOOTH_TAU, 0.001))
local tx = st.outX + (fx - st.outX) * oa
local ty = st.outY + (fy - st.outY) * oa
