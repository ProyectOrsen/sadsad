local function pushHistory(rootPos)
local t = clock()
if st.lastHistPos and st.lastHistTime > 0 then
local dt_ = t - st.lastHistTime
if dt_ > 0.0001 then
local jump = (rootPos - st.lastHistPos).Magnitude
local vel = jump / dt_
if jump > C.PRED_SAMPLE_MAX_JUMP or vel > C.PRED_SAMPLE_MAX_VEL then
st.hist = {}; st.predLog = {}; st.tpIgnoreTimer = C.PRED_TP_RESET_TIME
st.predVelInit = false; st.predVelSmoothX = 0; st.predVelSmoothZ = 0
st.predVelYSmooth = 0
st.lastHistPos = rootPos; st.lastHistTime = t
table.insert(st.hist, {pos = rootPos, t = t}); return
end
end
end
if st.lastHistTime > 0 and (t - st.lastHistTime) < C.PRED_HIST_SAMPLE_MIN_DT then return end
table.insert(st.hist, {pos = rootPos, t = t})
while #st.hist > C.PRED_HISTORY do table.remove(st.hist, 1) end
st.lastHistPos = rootPos; st.lastHistTime = t
end
local function computeBlendedVelocity()
local n = #st.hist; if n < 2 then return Vector3.zero end
local a, b = st.hist[n - 1], st.hist[n]
local dtI = math.max(b.t - a.t, 0.001)
local instX = (b.pos.X - a.pos.X) / dtI
local instY = (b.pos.Y - a.pos.Y) / dtI
local instZ = (b.pos.Z - a.pos.Z) / dtI
local hX, hY, hZ, wSum = 0, 0, 0, 0
for i = 2, n do
local p1, p2 = st.hist[i - 1], st.hist[i]
local dt_ = math.max(p2.t - p1.t, 0.001)
if dt_ >= C.PRED_HIST_SAMPLE_MIN_DT and dt_ <= 0.5 then
local w = i / n
hX = hX + (p2.pos.X - p1.pos.X) / dt_ * w
hY = hY + (p2.pos.Y - p1.pos.Y) / dt_ * w
hZ = hZ + (p2.pos.Z - p1.pos.Z) / dt_ * w
wSum = wSum + w
end
end
if wSum > 0 then hX, hY, hZ = hX / wSum, hY / wSum, hZ / wSum end
local instMag = math.sqrt(instX * instX + instZ * instZ)
local histMag = math.sqrt(hX * hX + hZ * hZ)
if histMag > 0.5 and instMag > histMag * C.PRED_INST_SPIKE_RATIO then
instX = hX; instY = hY; instZ = hZ
end
local targetAdapt = Vector3.new(hX, hY, hZ)
st.adaptVel = st.adaptVel:Lerp(targetAdapt, math.min(1, 0.22))
local wTotal = C.PRED_W_INSTANT + C.PRED_W_HISTORY + C.PRED_W_ADAPT
local bx = (instX * C.PRED_W_INSTANT + hX * C.PRED_W_HISTORY + st.adaptVel.X * C.PRED_W_ADAPT) / wTotal
local by = (instY * C.PRED_W_INSTANT + hY * C.PRED_W_HISTORY + st.adaptVel.Y * C.PRED_W_ADAPT) / wTotal
local bz = (instZ * C.PRED_W_INSTANT + hZ * C.PRED_W_HISTORY + st.adaptVel.Z * C.PRED_W_ADAPT) / wTotal
return Vector3.new(bx, by, bz)
end
local function updatePredictability(vel, dt)
local vmag = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
if vmag > 0.3 then
local dx, dz = vel.X / vmag, vel.Z / vmag
if st.lastDirSet then
local dot = dx * st.lastDirX + dz * st.lastDirZ
st.predictability = expDecay(st.predictability, (dot + 1) * 0.5, C.PRED_DIR_CONSISTENCY_TAU, dt)
end
st.lastDirX, st.lastDirZ, st.lastDirSet = dx, dz, true
else
st.predictability = expDecay(st.predictability, 0.5, 0.5, dt)
end
end
local function updateVelocityInertia(vel, dt)
local srcX, srcZ = vel.X, vel.Z
local srcY = vel.Y
local vmag = math.sqrt(srcX * srcX + srcZ * srcZ)
local tau = C.PRED_INERTIA_TAU * st.predInertiaVar
if vmag > C.PRED_INERTIA_FAST_VEL then tau = C.PRED_INERTIA_FAST_TAU * st.predInertiaVar end
if not st.predVelInit then
st.predVelX = srcX; st.predVelY = srcY; st.predVelZ = srcZ
st.predVelSmoothX = srcX; st.predVelSmoothZ = srcZ
st.predVelYSmooth = srcY
st.predVelInit = true; st.prevPredVelX = srcX; st.prevPredVelZ = srcZ
else
st.prevPredVelX = st.predVelX; st.prevPredVelZ = st.predVelZ
st.predVelX = expDecay(st.predVelX, srcX, tau, dt)
st.predVelY = expDecay(st.predVelY, srcY, 0.05, dt)
st.predVelZ = expDecay(st.predVelZ, srcZ, tau, dt)
end
st.predVelSmoothX = expDecay(st.predVelSmoothX, st.predVelX, C.PRED_VEL_EMA_TAU, dt)
st.predVelSmoothZ = expDecay(st.predVelSmoothZ, st.predVelZ, C.PRED_VEL_EMA_TAU, dt)
