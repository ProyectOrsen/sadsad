function Vis.line(origin, target, model)
local rp = Vis.params()
local ex = nil
local function run()
local pos = origin
local total, parts, free = 0, 0, 0
for _ = 1, C.WB_MAX_STEPS do
local rem = target - pos
local dist = rem.Magnitude
if dist < 0.05 then return true end
local dir = rem / dist
local res = workspace:Raycast(pos, rem, rp)
if not res then return true end
if (res.Position - target).Magnitude <= C.VIS_TARGET_RADIUS then return true end
local inst = res.Instance
if model and inst:IsDescendantOf(model) then return true end
local step, pass = 0, false
local charModel = C.WB_IGNORE_CHARACTERS and isCharacterPart(inst) or nil
if charModel then
if not ex then ex = {} for i = 1, #Vis.baseEx do ex[i] = Vis.baseEx[i] end end
table.insert(ex, charModel)
rp.FilterDescendantsInstances = ex
pass = true
elseif inst.Transparency >= C.TRANSP_BYPASS then
pass = true
elseif C.WB_SOFT_MATERIALS[inst.Material.Name] then
pass = true
elseif C.WB_ENABLE then
local allow = C.WB_MAX_THICK - total
local chord = Vis.chord(inst, res.Position, dir, math.max(allow, C.EDGE_THIN))
if chord <= C.EDGE_THIN then
free = free + 1
if free <= C.MAX_THIN then pass = true; step = chord end
elseif chord <= allow and parts < C.WB_MAX_PARTS then
parts = parts + 1; total = total + chord; pass = true; step = chord
end
end
if not pass then return false end
pos = res.Position + dir * (step + 0.04)
end
return false
end
local ok = run()
if ex then rp.FilterDescendantsInstances = Vis.baseEx end
return ok
end
function Vis.point(char, key, pos, isCurrent)
if not C.WALLCHECK then return true end
local t = clock()
local cc = Vis.cache[char]
if not cc then cc = {}; Vis.cache[char] = cc end
local e = cc[key]
if e then
local ttl = lerp(C.VIS_CACHE_MAX, C.VIS_CACHE, clamp(Vis.motion, 0, 1))
if (t - e.t) < ttl and (pos - e.p).Magnitude < C.VIS_POS_INVALIDATE and (Vis.camPos - e.c).Magnitude < 0.35 then
return e.v
end
end
if Vis.budget <= 0 then
if e then return e.v end
return isCurrent and true or false
end
Vis.budget = Vis.budget - 1
local vis = Vis.line(Vis.camPos, pos, char)
if not e then e = {h = 0, v = vis}; cc[key] = e end
if vis then
e.h = 0; e.v = true
else
e.h = e.h + 1
if e.h >= C.VIS_HYST or not e.v then e.v = false end
end
e.t = t; e.p = pos; e.c = Vis.camPos
return e.v
end
