local function isFriend(p)
    if not C.IGNORE_FRIENDS then
        return false
    end

    local uid = p.UserId
    local now = tick()
    local e = st.fCache[uid]

    if e and e.exp > now then
        return e.val
    end

    local ok, r = pcall(function()
        return player:IsFriendsWith(uid)
    end)

    local val = ok and r or false
    st.fCache[uid] = {val = val, exp = now + 30}

