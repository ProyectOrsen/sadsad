local connR = RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera or camera
    if not st.enabled or not player.Character or not camera then
        return
    end
    local actualMouse = getMouse()
    local frameEventDX = st.mouseDeltaX
    local frameEventDY = st.mouseDeltaY
    st.mouseDeltaX = 0
    st.mouseDeltaY = 0
    local frameCursorDX, frameCursorDY = 0, 0
    if st.prevActualX == nil or st.prevActualY == nil then
        st.prevActualX = actualMouse.X
        st.prevActualY = actualMouse.Y
    else
        frameCursorDX = actualMouse.X - st.prevActualX
        frameCursorDY = actualMouse.Y - st.prevActualY
        st.prevActualX = actualMouse.X
        st.prevActualY = actualMouse.Y
    end

    if C.CENTER_CHECK_ENABLE then
        local vp = camera.ViewportSize
        local center = Vector2.new(
            (vp.X / 2) + C.CENTER_OFFSET_X,
            (vp.Y / 2) + C.CENTER_OFFSET_Y
        )
        local maxD = math.min(vp.X, vp.Y) * C.CENTER_CHECK_RADIUS
        if (actualMouse - center).Magnitude > maxD then
            mv.outX = mv.outX * math.max(1 - C.MANUAL_FADE_SPEED * dt, 0)
            mv.outY = mv.outY * math.max(1 - C.MANUAL_FADE_SPEED * dt, 0)
            st.lastCmdX = 0
            st.lastCmdY = 0
            st.moveAccX = 0
            st.moveAccY = 0
            sendMouseRelative(mv.outX * 0.25, mv.outY * 0.25)
            return
        end
    end

    local cursor = getAimCursor()
    if C.AUTO_AIM then
        local c = getCandidates(cursor, C.FOV)
        if #c > 0 then
            if not st.holding then
                st.holding = true
                st.visCache = {}
                createBlocks()
            end
        elseif not st.holdM1 and not st.holdM2 then
            st.holding = false
            st.manualOverride = 0
            st.manualDownFactor = 0
            destroyBlocks()
        end
    end
    if not st.holding then
        st.manualOverride = 0
        st.manualDownFactor = 0
        return
    end

    local eventMag = frameEventDX * frameEventDX + frameEventDY * frameEventDY
    local cursorMag = frameCursorDX * frameCursorDX + frameCursorDY * frameCursorDY
    local rawDX, rawDY
    if eventMag >= cursorMag then
        rawDX = frameEventDX
        rawDY = frameEventDY
    else
        rawDX = frameCursorDX
        rawDY = frameCursorDY
    end
    local rawMag = math.sqrt(rawDX * rawDX + rawDY * rawDY)
    local expMag = math.sqrt(st.lastCmdX * st.lastCmdX + st.lastCmdY * st.lastCmdY)
    local manualDX, manualDY
    if expMag > 0.5 and rawMag < expMag * 0.18 then
        manualDX = 0
        manualDY = 0
    else
        manualDX = rawDX - st.lastCmdX
        manualDY = rawDY - st.lastCmdY
    end
    local manualMag = math.sqrt(manualDX * manualDX + manualDY * manualDY)
    if manualMag < 0.8 then
        manualDX = 0
        manualDY = 0
        manualMag = 0
    end
    local sdt = math.max(dt, 0.001)
    local manualSpeed = manualMag / sdt
    local manualTarget = manualSpeed > C.MANUAL_DELTA_THRESH and 1 or 0
    local mLerp = manualTarget > st.manualOverride and C.MANUAL_RISE or C.MANUAL_FALL
    st.manualOverride = st.manualOverride + (manualTarget - st.manualOverride) * math.min(mLerp * dt, 1)
    st.manualOverride = clamp(st.manualOverride, 0, 1)
    local downSpeed = manualDY / sdt
    local downTarget = downSpeed > C.MANUAL_DOWN_THRESH and 1 or 0
    local dLerp = downTarget > st.manualDownFactor and C.MANUAL_DOWN_RISE or C.MANUAL_DOWN_FALL
    st.manualDownFactor = st.manualDownFactor + (downTarget - st.manualDownFactor) * math.min(dLerp * dt, 1)
    st.manualDownFactor = clamp(st.manualDownFactor, 0, 1)

    local manualSuppress = 1 - st.manualOverride * C.MANUAL_SUPPRESS
    if st.manualOverride > C.MANUAL_HARD_YIELD then
        st.manualFade = math.min(st.manualFade + dt * 4.0, 1)
        local fade = 1 - st.manualFade
        mv.outX = mv.outX * math.max(1 - C.MANUAL_FADE_SPEED * dt, 0)
        mv.outY = mv.outY * math.max(1 - C.MANUAL_FADE_SPEED * dt, 0)
        st.moveAccX = st.moveAccX * fade
        st.moveAccY = st.moveAccY * fade
        sendMouseRelative(mv.outX * fade * 0.35, mv.outY * fade * 0.35)
        return
    else
        st.manualFade = math.max(st.manualFade - dt * 3.5, 0)
    end

    if C.MOUSE_ADAPT_ENABLE then
        local mag = math.sqrt(rawDX * rawDX + rawDY * rawDY)
        if mag > 0.5 then
            table.insert(st.mouseAdaptMemory, {mag = mag, time = tick()})
            if #st.mouseAdaptMemory > C.MOUSE_ADAPT_MEMORY_SIZE then
                table.remove(st.mouseAdaptMemory, 1)
            end
        end
        if #st.mouseAdaptMemory >= 5 then
            local avgMag = 0
            local count = 0
            for _, m in ipairs(st.mouseAdaptMemory) do
                if tick() - m.time < 2.0 then
                    avgMag = avgMag + m.mag
                    count = count + 1
                end
            end
            if count > 0 then
                avgMag = avgMag / count
                local targetMult = clamp(avgMag / 13.0, C.MOUSE_ADAPT_MIN_MULT, C.MOUSE_ADAPT_MAX_MULT)
                st.mouseAdaptSmooth = st.mouseAdaptSmooth + (targetMult - st.mouseAdaptSmooth) * C.MOUSE_ADAPT_SMOOTHING
            end
        end
        st.mouseAdaptMult = st.mouseAdaptSmooth
    end

    local head, hsp, isTrailing = findTarget(cursor, dt)
    if C.MANUAL_RELEASE_ENABLE and head and hsp then
        local distToCursor = (hsp - cursor).Magnitude
        if st.manualOverride > 0.52 and distToCursor > C.FOV_DETECT then
            st.manualReleased = true
        elseif distToCursor <= C.FOV_DETECT or st.manualOverride < 0.18 then
            st.manualReleased = false
        end
    end

    local reactMult = getReactionMultiplier(dt)
    if not C.FLICK_ENABLE then
        fk.active = false
        fk.cooldown = 0
    else
        fk.cooldown = math.max(fk.cooldown - dt, 0)
        if fk.active then
            fk.timer = fk.timer + dt
            if fk.phase == 0 then
                if fk.timer >= fk.delay then
                    fk.phase = 1
                    fk.timer = 0
                end
            elseif fk.phase == 1 then
                if fk.timer >= fk.burst then
                    fk.phase = 2
                    fk.timer = 0
                end
            elseif fk.phase == 2 then
                if fk.timer >= fk.recover then
                    fk.active = false
                    fk.cooldown = rRange(C.FLICK_COOLDOWN_MIN, C.FLICK_COOLDOWN_MAX)
                    if mv.motionClass == "strafe" then
                        fk.cooldown = fk.cooldown * 0.8
                    end
                end
            end
        end
    end
    if st.switchBlendActive then
        st.switchBlend = math.max(st.switchBlend - dt / C.SWITCH_BLEND_TIME, 0)
        if st.switchBlend <= 0 then
            st.switchBlendActive = false
        end
    end
    st.miniOSCooldown = math.max(st.miniOSCooldown - dt, 0)

    if not head then
        fk.active = false
        fk.phase = 0
        fk.timer = 0
        fk.lastDirSet = false
        fk.lastScreenX = nil
        fk.lastScreenY = nil
        st.targetStopTimer = 0
        st.justTargetStop = false
        st.lastRdSmooth = 0
        st.predYComp = st.predYComp * math.max(1 - 5.5 * dt, 0)
        mv.outX = mv.outX * math.max(1 - 5.5 * dt, 0)
        mv.outY = mv.outY * math.max(1 - 5.5 * dt, 0)
        st.miniOSActive = false
        local fadeMult = 1
        if st.lostFadeActive then
            st.lostFadeTimer = st.lostFadeTimer + dt
            fadeMult = 1 - clamp(st.lostFadeTimer / C.LOST_FADE_TIME, 0, 1)
        end
        local fx = mv.outX * fadeMult * manualSuppress
        local fy = mv.outY * fadeMult * manualSuppress
        sendMouseRelative(fx, fy)
        return
    end

    local targetRoot = st.targetChar and st.targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then
        st.target = nil
        st.targetChar = nil
        st.lockTime = nil
        st.lastRdSmooth = 0
        st.lastCmdX = 0
        st.lastCmdY = 0
        st.moveAccX = 0
        st.moveAccY = 0
        return
    end

    local t2 = tick()
    table.insert(st.history, {pos = targetRoot.Position, t = t2})
    if #st.history > 12 then
        table.remove(st.history, 1)
    end
    local vel = getVel()
    local vm = vel.Magnitude
    st.targetStopTimer = math.max(st.targetStopTimer - dt, 0)
    st.justTargetStop = false
    if mv.prevTargetSpeed > C.TARGET_STOP_PREV_SPEED and vm < C.TARGET_STOP_SPEED and st.lockTime and not isTrailing then
        st.targetStopTimer = rRange(C.TARGET_STOP_REACT_MIN, C.TARGET_STOP_REACT_MAX)
        st.justTargetStop = true
    end
    mv.prevTargetSpeed = lerp(mv.prevTargetSpeed, vm, 0.22)
    mv.smoothSpeed = lerp(mv.smoothSpeed, vm, 0.15)

    if C.TARGET_SPEED_ADAPT then
        local speedT = clamp(
            (mv.smoothSpeed - C.TARGET_SPEED_MIN) / math.max(C.TARGET_SPEED_FULL - C.TARGET_SPEED_MIN, 0.001),
            0, 1
        )
        local desiredMult = lerp(C.TARGET_SPEED_MULT_MIN, C.TARGET_SPEED_MULT_MAX, speedT)
        st.targetSpeedMult = st.targetSpeedMult + (desiredMult - st.targetSpeedMult) * math.min(C.TARGET_SPEED_SMOOTH * 60 * dt, 1)
    end

    local newClass = "static"
    if mv.smoothSpeed < C.MOTION_STATIC then
        newClass = "static"
    elseif mv.smoothSpeed < C.MOTION_WALK then
        newClass = "walk"
    elseif mv.smoothSpeed < C.MOTION_RUN then
        newClass = "run"
    else
        newClass = "run"
    end
    if vm > 0.7 then
        local dirX = vel.X / vm
        local dirZ = vel.Z / vm
        if mv.lastDirSet then
            local dot = dirX * mv.lastDirX + dirZ * mv.lastDirZ
            if dot < C.MOTION_STRAFE_DOT then
                newClass = "strafe"
            end
        end
        mv.lastDirX = dirX
        mv.lastDirZ = dirZ
        mv.lastDirSet = true
    end
    mv.motionClass = newClass
    st.lastMotionSpeed = vm
    st.lastMotionVel = vel

    -- Landing reaction más suave y raro
    if st.justLanded then
        st.justLanded = false
        local nowLand = tick()
        if nowLand - st.lastLandReact > (C.LANDING_REACT_COOLDOWN or 0.7) then
            -- Solo micro-reacción, no freeze
            if st.reactState == "TRACK" or st.reactState == "IDLE" then
                startHumanReaction(st.isJudgeTarget, true, nil)
            end
            st.lastLandReact = nowLand
        end
    end

    local lockAgeFlick = st.lockTime and (tick() - st.lockTime) or 0
    local targetDistNow = hsp and (hsp - cursor).Magnitude or 9999
    local canFlick =
        C.FLICK_ENABLE and
        not isTrailing and
        lockAgeFlick > (C.FLICK_MIN_LOCK_AGE or 0.08) and
        (st.reactState == "CORRECT" or st.reactState == "TRACK") and
        not st.motionReactActive and
        st.manualOverride < 0.3 and
        not fk.active and
        fk.cooldown <= 0 and
        targetDistNow > (C.FLICK_MIN_ERROR_PX or 18)

    local curDirX, curDirZ, curDirSet = 0, 0, false
    if vm > 0.7 then
        curDirX = vel.X / vm
        curDirZ = vel.Z / vm
        curDirSet = true
    end
    if curDirSet then
        if fk.lastDirSet and canFlick and vm > C.FLICK_MIN_SPEED then
            local dot = curDirX * fk.lastDirX + curDirZ * fk.lastDirZ
            if dot < C.FLICK_TURN_DOT then
                triggerFlick("turn")
            end
        end
        fk.lastDirX = curDirX
        fk.lastDirZ = curDirZ
        fk.lastDirSet = true
    else
        fk.lastDirSet = false
    end
    if canFlick and mv.motionClass == "strafe" and not mv.wasStrafe then
        if vm > (C.FLICK_MIN_SPEED + 0.6) and targetDistNow > (C.FLICK_MIN_ERROR_PX + 8) then
            triggerFlick("strafe")
        end
    end
    mv.wasStrafe = mv.motionClass == "strafe"

    st.adaptVelocity = st.adaptVelocity:Lerp(vel, math.min((C.PREDICT_ADAPT_LERP or 0.16) * 60 * dt, 1))
    local velCon = 1 - clamp((st.adaptVelocity - vel).Magnitude / math.max(vm + 0.1, 1), 0, 1)
    st.adaptConfidence = st.adaptConfidence + ((0.08 + velCon * 0.14) - st.adaptConfidence) * math.min((C.PREDICT_CONF_LERP or 0.08) * 60 * dt, 1)
    if st.lockTime then
        st.predictRampTimer = st.predictRampTimer + dt
    end
    local prRaw = clamp(
        (st.predictRampTimer - (C.PREDICT_RAMP_DELAY or 0.12)) /
        math.max(C.PREDICT_RAMP_TIME or 0.14, 0.001),
        0, 1
    )
    local prFactor = prRaw ^ (C.PREDICT_RAMP_CURVE or 1.05)
    if st.reactState == "DELAY" then
        prFactor = prFactor * (C.PREDICT_REACT_DELAY_MULT or 0.0)
    elseif st.reactState == "ACCEL" then
        prFactor = prFactor * (C.PREDICT_REACT_ACCEL_MULT or 0.08)
    elseif st.reactState == "CORRECT" then
        prFactor = prFactor * (C.PREDICT_REACT_CORRECT_MULT or 0.55)
    end
    local predInputSpeed = mv.smoothSpeed
    local velFactor = clamp(
        (predInputSpeed - C.PREDICT_MIN_VEL) /
        math.max(C.PREDICT_MAX_VEL - C.PREDICT_MIN_VEL, 0.001),
        0, 1
    )
    local sCurve = velFactor ^ C.PREDICT_CURVE
    if st.targetStopTimer > 0 or vm < C.TARGET_STOP_SPEED then
        sCurve = sCurve * 0.3
    end
    local mc = player.Character
    local mr = mc and mc:FindFirstChild("HumanoidRootPart")
    local wDist = mr and (targetRoot.Position - mr.Position).Magnitude or 9999
    local dSuppress = clamp((wDist - C.PREDICT_MIN_DIST) / 24, 0, 1)
    if vm > (C.CLOSE_RANGE_MOVING_VEL or 1.25) then
        dSuppress = math.max(dSuppress, 0.25)
    end
    local tPS = clamp(sCurve, 0, 1.0) * dSuppress * prFactor
    local effR = tPS < st.predictScale and (C.PREDICT_STOP_SMOOTH or 0.4) or (0.035 + sCurve * 0.24)
    st.predictScale = st.predictScale + (tPS - st.predictScale) * math.min(effR * 60 * dt, 1)
    st.predictScaleSmooth = st.predictScaleSmooth + (st.predictScale - st.predictScaleSmooth) * math.min(C.PREDICT_BLEND_LERP * 60 * dt, 1)
    st.pVarTime = st.pVarTime + dt * C.PREDICT_VAR_SPEED
    local pVar = 1 + math.sin(st.pVarTime) * C.PREDICT_VAR_DEPTH
    local predBlend = clamp(st.adaptConfidence, 0, 1) * 0.62
    local predVel = st.adaptVelocity:Lerp(vel, predBlend)
    local gradualFactor = 1.0
    if C.PREDICT_GRADUAL_ENABLE then
        local gradualVel = clamp(
            (vm - C.PREDICT_GRADUAL_MIN_VEL) / math.max(C.PREDICT_GRADUAL_FULL_VEL - C.PREDICT_GRADUAL_MIN_VEL, 0.001),
            0, 1
        )
        gradualFactor = gradualVel ^ C.PREDICT_GRADUAL_CURVE
        gradualFactor = C.PREDICT_GRADUAL_MIN_MULT + (C.PREDICT_GRADUAL_MAX_MULT - C.PREDICT_GRADUAL_MIN_MULT) * gradualFactor
        st.predictGradualFactor = st.predictGradualFactor + (gradualFactor - st.predictGradualFactor) * math.min(C.PREDICT_GRADUAL_SMOOTH * 60 * dt, 1)
        gradualFactor = st.predictGradualFactor
    end
    local pScale = C.PREDICT_X * pVar * st.predictScaleSmooth * gradualFactor
    local aimBase, air = getDynamicAimWorldPos(st.targetChar, dt, st.manualDownFactor, st.isJudgeTarget)
    if not aimBase then
        st.lastCmdX = 0
        st.lastCmdY = 0
        st.moveAccX = 0
        st.moveAccY = 0
        return
    end

    -- Solo corta el seguimiento en aire si TÚ estás bajando el mouse
    if C.AIR_DOWN_DISABLE and st.manualDownFactor > 0.35 then
        st.airDownFactor = st.airDownFactor + (1 - st.airDownFactor) * math.min(8 * dt, 1)
    else
        st.airDownFactor = st.airDownFactor + (0 - st.airDownFactor) * math.min(10 * dt, 1)
    end

    st.airFlickCooldown = math.max(st.airFlickCooldown - dt, 0)
    if C.FLICK_ENABLE and air and not st.lastAirState and st.airFlickCooldown <= 0 then
        if (st.reactState == "CORRECT" or st.reactState == "TRACK") and st.manualOverride < 0.3 and st.airDownFactor < 0.4 then
            local airDistNow = hsp and (hsp - cursor).Magnitude or 9999
            if airDistNow > (C.FLICK_MIN_ERROR_PX or 18) then
                triggerFlick("screen")
                st.airFlickCooldown = C.AIR_FLICK_COOLDOWN or 0.25
            end
        end
    end
    st.lastAirState = air

    if st.isJudgeTarget and wDist > C.JUDGE_MAX_DIST then
        mv.outX = mv.outX * math.max(1 - 6 * dt, 0)
        mv.outY = mv.outY * math.max(1 - 6 * dt, 0)
        st.lastCmdX = 0
        st.lastCmdY = 0
        st.moveAccX = 0
        st.moveAccY = 0
        return
    end
    if st.manualReleased then
        mv.outX = mv.outX * math.max(1 - 7 * dt, 0)
        mv.outY = mv.outY * math.max(1 - 7 * dt, 0)
        st.lastCmdX = 0
        st.lastCmdY = 0
        st.moveAccX = 0
        st.moveAccY = 0
        return
    end

    local targetYComp = 0
    if C.PREDICT_Y_ENABLE then
        targetYComp = clamp(predVel.Y * pScale * C.PREDICT_Y_MULT, -C.PREDICT_Y_MAX, C.PREDICT_Y_MAX)
        if air then
            -- En aire sigue fuerte (salvo si tú bajas el mouse)
            if predVel.Y < 0 then
                targetYComp = targetYComp * 1.15
            else
                targetYComp = targetYComp * 1.05
            end
        else
            targetYComp = targetYComp * 0.4
        end
        targetYComp = targetYComp * (1 - st.airDownFactor * (1 - C.AIR_DOWN_PREDICT_CUT))
    end
    st.predYComp = st.predYComp + (targetYComp - st.predYComp) * math.min(C.PREDICT_Y_SMOOTH * 60 * dt, 1)
    local closeRangeFactor = 1.0
    if wDist < C.CLOSE_RANGE_STUDS then
        local denom = math.max(C.CLOSE_RANGE_STUDS - 4, 0.001)
        local t = clamp((wDist - 4) / denom, 0, 1)
        closeRangeFactor = lerp(C.CLOSE_RANGE_DAMPENING, 1.0, t)
    end
    local predOffsetX = predVel.X * pScale * closeRangeFactor
    local predOffsetZ = predVel.Z * pScale * closeRangeFactor
    if C.PREDICT_DISTANCE_CLAMP_ENABLE then
        local predOffsetMag = math.sqrt(predOffsetX * predOffsetX + predOffsetZ * predOffsetZ)
        if predOffsetMag > C.PREDICT_MAX_DISTANCE then
            local scale = C.PREDICT_MAX_DISTANCE / predOffsetMag
            predOffsetX = predOffsetX * scale
            predOffsetZ = predOffsetZ * scale
        end
    end
    local rawWorldPos = Vector3.new(
        aimBase.X + predOffsetX,
        aimBase.Y + st.predYComp * closeRangeFactor,
        aimBase.Z + predOffsetZ
    )
    if st.targetChar then
        if C.AIM_BLOCK_ENABLE and st.aimBlock then
            updateAimBlock(aimBase, dt)
        end
        if C.PREDICT_BLOCK_ENABLE and st.predictBlock then
            updatePredictBlock(rawWorldPos, dt)
        end
    end
    local spV3 = camera:WorldToViewportPoint(rawWorldPos)
    if not spV3 or spV3.Z <= 0 then
        st.lastCmdX = 0
        st.lastCmdY = 0
        st.moveAccX = 0
        st.moveAccY = 0
        return
    end
    if fk.lastScreenX and canFlick then
        local dxs = spV3.X - cursor.X
        local dys = spV3.Y - cursor.Y
        local roughRd = math.sqrt(dxs * dxs + dys * dys)
        local jump = math.sqrt(
            (spV3.X - fk.lastScreenX) * (spV3.X - fk.lastScreenX) +
            (spV3.Y - fk.lastScreenY) * (spV3.Y - fk.lastScreenY)
        )
        if jump > C.FLICK_SCREEN_JUMP and roughRd > (C.FLICK_MIN_ERROR_PX or 18) and vm > C.FLICK_MIN_SPEED * 0.55 then
            triggerFlick("screen")
        end
    end
    fk.lastScreenX = spV3.X
    fk.lastScreenY = spV3.Y
    local alpha = C.TARGET_FILTER_ALPHA
    if isTrailing then
        alpha = alpha * 0.65
    end
    if st.landingWindow > 0 then
        alpha = C.LANDING_FILTER_ALPHA
    end
    if not st.smoothTargetInit then
        st.smoothTargetX = spV3.X
        st.smoothTargetY = spV3.Y
        st.lastSmoothX = spV3.X
        st.lastSmoothY = spV3.Y
        st.smoothTargetInit = true
    else
        local jumpX = math.abs(spV3.X - st.lastSmoothX)
        local jumpY = math.abs(spV3.Y - st.lastSmoothY)
        local jump = math.sqrt(jumpX * jumpX + jumpY * jumpY)
        if jump > C.LAG_JUMP_THRESHOLD then
            st.lagFactor = 1.0
        else
            st.lagFactor = st.lagFactor * math.max(1 - 3.0 * dt, 0)
        end
        local lagMult = lerp(1.0, C.LAG_SMOOTH_MULT, st.lagFactor)
        local a = math.min(alpha * lagMult * 60 * dt, 1)
        st.smoothTargetX = st.smoothTargetX + (spV3.X - st.smoothTargetX) * a
        st.smoothTargetY = st.smoothTargetY + (spV3.Y - st.smoothTargetY) * a
        st.lastSmoothX = st.smoothTargetX
        st.lastSmoothY = st.smoothTargetY
    end
    local tSX = st.smoothTargetX
    local tSY = st.smoothTargetY
    if st.reactState == "DELAY" or st.reactState == "ACCEL" then
        local errFade = 1.0
        if st.reactState == "ACCEL" then
            local p = clamp(st.reactTimer / math.max(C.REACT_ACCEL_TIME, 0.001), 0, 1)
            errFade = 1.0 - p
        end
        tSX = tSX + st.reactErrorOffset.X * errFade
        tSY = tSY + st.reactErrorOffset.Y * errFade
    end
    local sil = getSilhouette(st.targetChar)
    local inside = checkBody(cursor, sil)
    local aimTX, aimTY = tSX, tSY

    if fk.active and fk.phase == 1 then
        local preDX = tSX - cursor.X
        local preDY = tSY - cursor.Y
        local preDist = math.sqrt(preDX * preDX + preDY * preDY)
        if preDist > 1 then
            local nx = preDX / preDist
            local ny = preDY / preDist
            local px = -ny
            local py = nx
            local closeNo = C.FLICK_CLOSE_NO_OS_PX or 18
            local osRange = C.FLICK_OS_RANGE_PX or 72
            local osScale = clamp((preDist - closeNo) / math.max(osRange - closeNo, 0.001), 0, 1)
            osScale = osScale * osScale
            local os = fk.overshoot * osScale
            local angScale = osScale
            aimTX = tSX + nx * os + px * fk.angleOffset * angScale
            aimTY = tSY + ny * os + py * fk.angleOffset * angScale
        end
    end

    local dX = aimTX - cursor.X
    local dY = aimTY - cursor.Y
    local rd = math.sqrt(dX * dX + dY * dY)

    if C.MINI_OVERSHOOT_ENABLE and not st.miniOSActive and st.miniOSCooldown <= 0 and not fk.active then
        if rd > C.MINI_OVERSHOOT_TRIGGER_PX and rd < C.MINI_OVERSHOOT_START_PX and st.reactState == "TRACK" then
            local dx = tSX - cursor.X
            local dy = tSY - cursor.Y
            local dist = math.sqrt(dx * dx + dy * dy)
            if dist > 1 then
                st.miniOSActive = true
                st.miniOSPhase = 0
                st.miniOSTimer = 0
                st.miniOSAmount = rRange(C.MINI_OVERSHOOT_AMOUNT_MIN, C.MINI_OVERSHOOT_AMOUNT_MAX)
                st.miniOSDirX = dx / dist
                st.miniOSDirY = dy / dist
            end
        end
    end

    if st.miniOSActive then
        st.miniOSTimer = st.miniOSTimer + dt
        if st.miniOSPhase == 0 then
            local progress = clamp(st.miniOSTimer / C.MINI_OVERSHOOT_SPEED, 0, 1)
            local ease = progress * progress * (3 - 2 * progress)
            aimTX = tSX + st.miniOSDirX * st.miniOSAmount * ease
            aimTY = tSY + st.miniOSDirY * st.miniOSAmount * ease
            if progress >= 1 then
                st.miniOSPhase = 1
                st.miniOSTimer = 0
            end
        else
            local progress = clamp(st.miniOSTimer / C.MINI_OVERSHOOT_RECOVER, 0, 1)
            local ease = 1 - (1 - progress) * (1 - progress)
            aimTX = tSX + st.miniOSDirX * st.miniOSAmount * (1 - ease)
            aimTY = tSY + st.miniOSDirY * st.miniOSAmount * (1 - ease)
            if progress >= 1 then
                st.miniOSActive = false
                st.miniOSCooldown = C.MINI_OVERSHOOT_COOLDOWN
            end
        end
        dX = aimTX - cursor.X
        dY = aimTY - cursor.Y
        rd = math.sqrt(dX * dX + dY * dY)
    end

    local isOT = rd < 48
    st.onTargetFactor = st.onTargetFactor + ((isOT and 1 or 0) - st.onTargetFactor) * math.min(0.72 * 60 * dt, 1)
    local rdJump = rd - st.lastRdSmooth
    if canFlick and rdJump > (C.FLICK_ERROR_JUMP_PX or 32) and rd > (C.FLICK_MIN_ERROR_PX or 18) and vm > (C.FLICK_MIN_SPEED or 1.5) then
        triggerFlick("screen")
    end
    st.lastRdSmooth = lerp(st.lastRdSmooth, rd, 0.16)
    if st.justTargetStop and rd > (C.FLICK_MIN_ERROR_PX or 18) and canFlick then
        triggerFlick("stop")
    end

    local deadzone = C.STOP_DEADZONE_PX
    if vm < C.TARGET_STOP_SPEED then
        deadzone = deadzone * C.STATIC_DEADZONE_MULT
    end
    if st.targetStopTimer > 0 then
        deadzone = deadzone * 1.04
    end
    local stopSoft = C.STOP_SOFT_PX
    local stopFactor = 1
    if rd < stopSoft then
        local t = clamp((rd - deadzone) / math.max(stopSoft - deadzone, 0.001), 0, 1)
        stopFactor = t * t * (3 - 2 * t)
        if inside then
            stopFactor = stopFactor * C.INSIDE_STOP_MULT
        end
    end
    if rd < deadzone then
        stopFactor = 0
    end

    local lockAge = st.lockTime and (tick() - st.lockTime) or 1
    local acquireRamp = clamp(lockAge / math.max(C.ACQUIRE_RAMP_TIME, 0.001), 0, 1) ^ C.ACQUIRE_RAMP_CURVE
    local activeMult = reactMult * (0.82 + 0.18 * acquireRamp)
    if st.reactState == "DELAY" then
        activeMult = 0.0
        mv.outX = mv.outX * math.max(1 - 10 * dt, 0)
        mv.outY = mv.outY * math.max(1 - 10 * dt, 0)
    end
    activeMult = activeMult * manualSuppress * st.mouseAdaptMult * st.targetSpeedMult
    if st.manualOverride > 0.32 then
        local yield = clamp((st.manualOverride - 0.32) / 0.68, 0, 1)
        activeMult = activeMult * (1 - yield * 0.9)
        mv.outX = mv.outX * math.max(1 - 9 * dt * yield, 0)
        mv.outY = mv.outY * math.max(1 - 9 * dt * yield, 0)
    end
    if isTrailing then
        activeMult = activeMult * (C.TRAILING_FORCE_MULT or 0.42)
    end
    if mv.motionClass == "static" then
        activeMult = activeMult * 0.97
    elseif mv.motionClass == "walk" then
        activeMult = activeMult * 1.0
    elseif mv.motionClass == "run" then
        activeMult = activeMult * 1.02
    elseif mv.motionClass == "strafe" then
        activeMult = activeMult * 0.99
    end
    if st.targetStopTimer > 0 and not (fk.active and fk.phase == 1) then
        activeMult = activeMult * 0.78
        mv.outX = mv.outX * math.max(1 - C.TARGET_STOP_BRAKE * dt, 0)
        mv.outY = mv.outY * math.max(1 - C.TARGET_STOP_BRAKE * dt, 0)
    end

    if C.SETTLE_BEAUTY_ENABLE and rd < C.SETTLE_BEAUTY_RADIUS then
        local settleT = clamp(rd / C.SETTLE_BEAUTY_RADIUS, 0, 1)
        local beautyFactor = 1 - (1 - C.SETTLE_BEAUTY_SPEED_MULT) * (1 - settleT) ^ C.SETTLE_BEAUTY_CURVE
        activeMult = activeMult * beautyFactor
    end

    local flickMult = 1
    local flickResponse = 1
    if fk.active then
        if fk.phase == 0 then
            flickMult = 0.58
            flickResponse = 0.72
        elseif fk.phase == 1 then
            flickMult = fk.boost
            flickResponse = C.FLICK_RESPONSE_BOOST
        elseif fk.phase == 2 then
            flickMult = 1.02
            flickResponse = 1.04
        end
        if rd < (C.FLICK_CLOSE_NO_OS_PX or 18) then
            flickMult = flickMult * 0.7
            flickResponse = flickResponse * 0.7
        elseif rd < 28 then
            local closeFlickT = clamp((rd - (C.FLICK_CLOSE_NO_OS_PX or 18)) / 10, 0, 1)
            flickMult = flickMult * lerp(0.7, 1, closeFlickT)
            flickResponse = flickResponse * lerp(0.7, 1, closeFlickT)
        end
    end
    if st.switchBlendActive then
        activeMult = activeMult * lerp(1.0, 0.7, st.switchBlend)
    end
    activeMult = activeMult * flickMult * stopFactor

    -- En aire: no frena, solo si tú bajas el mouse
    if air and st.airDownFactor < 0.25 then
        activeMult = activeMult * (C.AIR_BOOST_MULT or 1.18)
    elseif air then
        activeMult = activeMult * (1 - st.airDownFactor * (1 - C.AIR_DOWN_FOLLOW_CUT))
    end

    if rd < 8 then
        local speedNow = math.sqrt(mv.outX * mv.outX + mv.outY * mv.outY)
        if speedNow > 3.5 then
            local dampT = clamp((speedNow - 3.5) / 5.5, 0, 1)
            local damp = 1 - dampT * 0.38
            mv.outX = mv.outX * damp
            mv.outY = mv.outY * damp
        end
    end

    if activeMult <= 0.001 then
        mv.outX = mv.outX * math.max(1 - 7 * dt, 0)
        mv.outY = mv.outY * math.max(1 - 7 * dt, 0)
        st.lastCmdX = 0
        st.lastCmdY = 0
        st.moveAccX = 0
        st.moveAccY = 0
        return
    end

    local distSpeedMult = C.SPEED_FAR_MULT
    if wDist < C.SPEED_DIST_START then
        local t = clamp((C.SPEED_DIST_START - wDist) / math.max(C.SPEED_DIST_START - C.SPEED_DIST_FULL, 0.001), 0, 1)
        distSpeedMult = lerp(C.SPEED_FAR_MULT, C.SPEED_NEAR_MULT, t)
    end

    local closeBoost = 1.0
    local responseMod = 1.0
    if wDist < C.CLOSE_RANGE_STUDS then
        local denom = math.max(C.CLOSE_RANGE_STUDS - 3, 0.001)
        local t = clamp((wDist - 3) / denom, 0, 1)
        closeBoost = lerp(C.CLOSE_RANGE_DAMPENING, 1.0, t)
        responseMod = lerp(C.CLOSE_RANGE_RESPONSE_BOOST or 1.16, 1.0, t)
        if vm > (C.CLOSE_RANGE_MOVING_VEL or 1.25) or rd > 26 then
            closeBoost = math.max(closeBoost, 1.0)
            responseMod = math.max(responseMod, 1.0)
        end
        if vm > (C.CLOSE_RANGE_MOVING_VEL or 1.25) then
            closeBoost = closeBoost * (C.CLOSE_RANGE_MOVING_BOOST or 1.14)
        end
    end
    local catchBoost = 1 + clamp(
        (rd - C.CATCH_START_PX) / math.max(C.CATCH_FULL_PX - C.CATCH_START_PX, 0.001),
        0, 1
    ) * (C.CATCH_BOOST_MAX - 1)

    local dynamicSpeed = C.BASE_SPEED * distSpeedMult * (0.74 + 0.42 * (1 - math.exp(-rd / 85)))
    local maxVel = dynamicSpeed * activeMult * closeBoost * catchBoost * st.adaptiveSpeedMult
    if inside then
        maxVel = maxVel * 0.96
    end
    local desiredX, desiredY = 0, 0
    if rd > 0.28 then
        local ramp = C.RAMP_DIST * (inside and 0.92 or 1)
        if fk.active then
            if fk.phase == 0 then
                ramp = ramp * 1.04
            elseif fk.phase == 1 then
                ramp = ramp * 0.62
            elseif fk.phase == 2 then
                ramp = ramp * 0.94
            end
        end
        if st.targetStopTimer > 0 then
            ramp = ramp * 1.02
        end
        local speedMult = 1.0
        if rd < C.MICRO_ADJUST_RADIUS and not fk.active and vm <= (C.CLOSE_RANGE_MOVING_VEL or 1.25) then
            local microT = clamp(rd / math.max(C.MICRO_ADJUST_RADIUS, 0.001), 0, 1)
            speedMult = lerp(C.MICRO_ADJUST_SPEED, 1.0, microT)
        end
        local desiredMag = maxVel * (1 - math.exp(-rd / math.max(ramp, 1))) * speedMult
        desiredX = dX / rd * desiredMag
        desiredY = dY / rd * desiredMag
    else
        desiredX = dX * 0.38 * activeMult
        desiredY = dY * 0.38 * activeMult
    end
    local response = lerp(C.RESPONSE_NEAR, C.RESPONSE_FAR, clamp(rd / 155, 0, 1))
    if air and st.airDownFactor < 0.3 then
        response = response * (C.AIR_RESPONSE_BOOST or 1.2)
    elseif air then
        response = response * (1 - st.airDownFactor * (1 - C.AIR_DOWN_FOLLOW_CUT))
    end
    response = response * responseMod
    if inside then
        response = response * 0.96
    end
    if isTrailing then
        response = response * (C.TRAILING_RESPONSE_MULT or 0.28)
    end
    response = response * (0.7 + 0.3 * acquireRamp)
    response = response * flickResponse
    response = response * lerp(0.68, 1.0, stopFactor)
    if st.targetStopTimer > 0 then
        response = response * 0.78
    end
    if st.switchBlendActive then
        response = response * lerp(1.0, 0.78, st.switchBlend)
    end
    response = math.min(response, 0.9)
    local respT = math.min(response * 60 * dt, 1)
    mv.outX = mv.outX + (desiredX - mv.outX) * respT
    mv.outY = mv.outY + (desiredY - mv.outY) * respT
    mv.noiseX = mv.noiseX + dt * C.HUMAN_NOISE_SPEED_X
    mv.noiseY = mv.noiseY + dt * C.HUMAN_NOISE_SPEED_Y
    local noiseAmp = C.HUMAN_NOISE_AMP * clamp(rd / 75, 0, 1) * manualSuppress * (1 - st.onTargetFactor * 0.45)
    local nx = perlin1d(mv.noiseX) * noiseAmp
    local ny = perlin1d(mv.noiseY + 137.7) * noiseAmp * 0.68
    local finalX = (mv.outX + nx) * C.FORCE_MULTIPLIER
    local finalY = (mv.outY + ny) * C.FORCE_MULTIPLIER
    finalY = finalY + C.RECOIL_FORCE * activeMult
    local maxForce = C.MAX_FORCE_PER_FRAME_BASE * closeBoost * (isTrailing and 0.7 or 1)
    if fk.active and fk.phase == 1 then
        maxForce = maxForce * clamp(fk.boost, 1.02, 1.22)
    end
    local mag = math.sqrt(finalX * finalX + finalY * finalY)
    if mag > maxForce then
        local scale = maxForce / mag
        finalX = finalX * scale
        finalY = finalY * scale
    end
    if math.abs(finalX) < 0.00035 then
        finalX = 0
    end
    if math.abs(finalY) < 0.00035 then
        finalY = 0
    end
    sendMouseRelative(finalX, finalY)
end)

_G.AA = {connR, connB, connE, connM}
