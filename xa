local function isEdgeThin(result, fromPos)
    local inst = result.Instance

    if not inst or not inst:IsA("BasePart") then
        return false
    end

    if inst.Transparency >= C.TRANSPARENCY_BYPASS then
        return true
    end

    local rp2 = RaycastParams.new()
    rp2.FilterType = Enum.RaycastFilterType.Include
    rp2.FilterDescendantsInstances = {inst}

    local dir = fromPos - result.Position
    if dir.Magnitude < 0.001 then
        return true
    end

    local exit = workspace:Raycast(result.Position, dir * 1.05, rp2)

    local thickness
    if not exit then
        local sz = inst.Size
        thickness = math.min(sz.X, sz.Y, sz.Z)
    else
        thickness = (result.Position - exit.Position).Magnitude
    end

    return thickness <= C.EDGE_THICKNESS
end

local function canSee(head, model)
    if not C.WALLCHECK then
        return true
    end

    local now = tick()
    local cached = st.visCache[model]

    if cached and (now - cached.time) < 0.1 then
        return cached.result
    end

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude

    local excludeList = {model}
    if player.Character then
        table.insert(excludeList, player.Character)
    end

    rp.FilterDescendantsInstances = excludeList

    local pos = camera.CFrame.Position
    local thinCount = 0
    local visible = false

    for _ = 1, C.WALL_BOUNCES do
        local dir = head.Position - pos

        if dir.Magnitude < 0.001 then
            visible = true
            break
        end

        local result = workspace:Raycast(pos, dir, rp)

        if not result then
            visible = true
            break
        end

        if (result.Position - head.Position).Magnitude < 0.05 then
            visible = true
            break
        end

        if isEdgeThin(result, head.Position) then
            thinCount = thinCount + 1

            if thinCount > C.MAX_THIN_LAYERS then
                visible = false
                break
            end

            local newEx = {table.unpack(rp.FilterDescendantsInstances)}
            table.insert(newEx, result.Instance)
            rp.FilterDescendantsInstances = newEx

            pos = result.Position
        else
            visible = false
            break
        end
    end

    st.visCache[model] = {time = now, result = visible}
    return visible
end

local function isJudgeChar(char)
