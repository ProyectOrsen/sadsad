end
local vy = st.predVelYSmooth
local rootT = st.targetChar and st.targetChar:FindFirstChild("HumanoidRootPart")
if rootT then
local rv = rootT.AssemblyLinearVelocity.Y
if math.abs(rv) > 1 then vy = vy * 0.5 + rv * 0.5 end
end
