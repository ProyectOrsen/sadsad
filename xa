local function updateYankDetection(dt)
  -- Desactivado por STICKY_YANK_ENABLE = false
  if not C.STICKY_YANK_ENABLE then return end
  if not st.target or not st.targetChar or not st.targetChar.Parent then return end
  local root = st.targetChar:FindFirstChild("HumanoidRootPart")
  if not root then return end
  local sp = camera:WorldToViewportPoint(root.Position)
  if sp.Z <= 0 then return end
  local now = tick()
  if st.lastTargetScreenInit then
    local dtime = now - st.lastTargetScreenTime
    if dtime > 0.001 and dtime < C.STICKY_YANK_TIME then
      local dx = sp.X - st.lastTargetScreenX
      local dy = sp.Y - st.lastTargetScreenY
      local d = math.sqrt(dx * dx + dy * dy)
      if d > C.STICKY_YANK_PIXELS then
        st.yankDetected = true
        st.yankTimer = C.STICKY_YANK_DROP_TIME
      end
    end
  end
  st.lastTargetScreenX = sp.X
  st.lastTargetScreenY = sp.Y
  st.lastTargetScreenTime = now
  st.lastTargetScreenInit = true
end

local function updateUserMove(dt)
  if not C.USER_MOVE_REDUCE_ENABLE then st.userMoveInf = 0; return end
  local spd = st.mouseSpeedSmooth or 0
  local demand = 0
  if spd > C.USER_MOVE_VEL_THRESH then
    local t = clamp((spd - C.USER_MOVE_VEL_THRESH) / C.USER_MOVE_VEL_THRESH, 0, 1)
    demand = t
  end
  local tau = (demand > st.userMoveInf) and C.USER_MOVE_ATTACK_TAU or C.USER_MOVE_RELEASE_TAU
  st.userMoveInf = expDecay(st.userMoveInf, demand, tau, dt)
  if st.userMoveInf < 0.003 then st.userMoveInf = 0 end
end

local function updateUserYank(dt)
  if not C.USER_YANK_ENABLE then return end
  local spd = st.mouseSpeedSmooth or 0
  if spd > C.USER_YANK_VEL_THRESH then
    local curX = st.mouseDeltaX or 0
    local curY = st.mouseDeltaY or 0
    local cmag = vlen(curX, curY)
    if cmag > 0.001 then
      local nx, ny = curX / cmag, curY / cmag
      if st.prevUserDirInit then
        local dot = nx * st.prevUserDirX + ny * st.prevUserDirY
        if dot < C.USER_YANK_DOT_THRESH then
          st.userYankTimer = C.USER_YANK_TIME
        end
      end
      st.prevUserDirX, st.prevUserDirY = nx, ny
      st.prevUserDirInit = true
    end
  end
  if st.userYankTimer > 0 then
    st.userYankTimer = st.userYankTimer - dt
    if st.smartFlickActive and st.smartFlickHoldTimer > 0
       and (st.mouseSpeedSmooth or 0) > C.USER_YANK_VEL_THRESH * 0.6 then
      st.smartFlickHoldTimer = 0
      st.smartFlickActive = false
      st.smartFlickCooldown = C.SMART_FLICK_COOLDOWN
    end
  end
end

local function updateStickyTimers(dt)
  if st.yankDetected then
    st.yankTimer = st.yankTimer - dt
    if st.yankTimer <= 0 then dropTarget(); return end
  end
end

-- ===== NUEVO selectTarget: NUNCA suelta por estar fuera de FOV =====
-- Solo suelta si el usuario tiene intención clara de escape (jala opuesto al aim)
local function selectTarget(cursor, dt)
  local c = getCandidates(cursor, C.FOV, st.targetChar, dt)
  local escapeIntent = computeUserEscapeIntent()
  st.escapeIntent = escapeIntent

  -- Verificar si target actual sigue vivo
  local hasValid = st.target and st.targetChar and st.targetChar.Parent
  if hasValid then
    local hum = st.targetChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then hasValid = false end
  end

  if #c == 0 then
    -- NO hay nadie en FOV. Mantener el target SIEMPRE.
    if not hasValid then
      if st.target then dropTarget() end
      return
    end

    -- Solo soltar si el escape intent es MUY fuerte Y sostenido
    if escapeIntent >= C.USER_ESCAPE_RELEASE_THRESH then
      st.escapeHoldTimer = st.escapeHoldTimer + dt
      if st.escapeHoldTimer >= C.USER_ESCAPE_HOLD_TIME then
        dropTarget()
        return
      end
    else
      st.escapeHoldTimer = 0
    end

    -- Mantener - no soltar por FOV
    st.lostFade = expDecay(st.lostFade, 1, 0.15, dt)
    return
  end

  local bestCandidate = c[1]
  local bestIsCurrent = st.targetChar and bestCandidate.char == st.targetChar

  if bestIsCurrent then
    st.targetWorldD = bestCandidate.wd
    st.lostTimer = 0
    st.lastTargetValidTime = tick()
    st.lastTargetVisibleTime = tick()
    st.lostFade = expDecay(st.lostFade, 1, 0.08, dt)
    st.stickyOutTimer = 0
    st.escapeHoldTimer = 0
    return
  end

  -- Hay candidato en FOV distinto al current. ¿Cambiar?
  -- REGLA: solo cambiar si el usuario tiene intención clara de escape
  if not hasValid then
    -- No hay current, adquirir el candidato
    local isNear = false
    if C.SMART_SWITCH_ENABLE and st.aimScreenInit and bestCandidate.spos then
      local dx = bestCandidate.spos.X - cursor.X
      local dy = bestCandidate.spos.Y - cursor.Y
      local d = math.sqrt(dx * dx + dy * dy)
      if d <= C.SMART_SWITCH_NEAR_SCREEN then isNear = true end
    end
    acquireTarget(bestCandidate, st.target ~= nil, isNear, cursor)
    st.lastSwitchTime = tick()
    return
  end

  -- Current válido → solo cambiar con escape intent
  if escapeIntent >= C.USER_ESCAPE_RELEASE_THRESH then
    st.escapeHoldTimer = st.escapeHoldTimer + dt
    if st.escapeHoldTimer >= C.USER_ESCAPE_HOLD_TIME then
      local isNear = false
      if C.SMART_SWITCH_ENABLE and st.aimScreenInit and bestCandidate.spos then
        local dx = bestCandidate.spos.X - cursor.X
        local dy = bestCandidate.spos.Y - cursor.Y
        local d = math.sqrt(dx * dx + dy * dy)
        if d <= C.SMART_SWITCH_NEAR_SCREEN then isNear = true end
      end
      acquireTarget(bestCandidate, true, isNear, cursor)
      st.lastSwitchTime = tick()
      st.escapeHoldTimer = 0
      return
    end
  else
    st.escapeHoldTimer = 0
  end

  -- Mantener target actual
  st.lostFade = expDecay(st.lostFade, 1, 0.10, dt)
end

local function pushHistory(rootPos)
  local now = tick()
  if st.lastHistPos and st.lastHistTime > 0 then
    local dt_ = now - st.lastHistTime
    if dt_ > 0.0001 then
      local jump = (rootPos - st.lastHistPos).Magnitude
      local vel = jump / dt_
      if jump > C.PRED_SAMPLE_MAX_JUMP or vel > C.PRED_SAMPLE_MAX_VEL then
        st.hist = {}
        st.tpIgnoreTimer = C.PRED_TP_RESET_TIME
        st.predVelInit = false
        st.predVelSmoothX = 0
        st.predVelSmoothZ = 0
        st.predVelYSmooth = 0
        st.lastHistPos = rootPos
        st.lastHistTime = now
        table.insert(st.hist, {pos = rootPos, t = now})
        return
      end
    end
  end
  if st.lastHistTime > 0 and (now - st.lastHistTime) < C.PRED_HIST_SAMPLE_MIN_DT then return end
  table.insert(st.hist, {pos = rootPos, t = now})
  while #st.hist > C.PRED_HISTORY do table.remove(st.hist, 1) end
  st.lastHistPos = rootPos
  st.lastHistTime = now
end

local function computeBlendedVelocity()
  local n = #st.hist
  if n < 2 then return Vector3.zero end
  local a, b = st.hist[n - 1], st.hist[n]
  local dtI = math.max(b.t - a.t, 0.001)
  local instX = (b.pos.X - a.pos.X) / dtI
  local instY = (b.pos.Y - a.pos.Y) / dtI
  local instZ = (b.pos.Z - a.pos.Z) / dtI
  local hX, hY, hZ, wSum = 0, 0, 0, 0
  for i = 2, n do
    local p1, p2 = st.hist[i - 1], st.hist[i]
    local dt_ = math.max(p2.t - p1.t, 0.001)
    if dt_ >= C.PRED_HIST_SAMPLE_MIN_DT and dt_ <= 0.5 then
      local w = i / n
      hX = hX + (p2.pos.X - p1.pos.X) / dt_ * w
      hY = hY + (p2.pos.Y - p1.pos.Y) / dt_ * w
      hZ = hZ + (p2.pos.Z - p1.pos.Z) / dt_ * w
      wSum = wSum + w
    end
  end
  if wSum > 0 then hX, hY, hZ = hX / wSum, hY / wSum, hZ / wSum end
  local instMag = math.sqrt(instX * instX + instZ * instZ)
  local histMag = math.sqrt(hX * hX + hZ * hZ)
  if histMag > 0.5 and instMag > histMag * C.PRED_INST_SPIKE_RATIO then
    instX = hX; instY = hY; instZ = hZ
  end
  local targetAdapt = Vector3.new(hX, hY, hZ)
  st.adaptVel = st.adaptVel:Lerp(targetAdapt, math.min(1, 0.35))
  local wTotal = C.PRED_W_INSTANT + C.PRED_W_HISTORY + C.PRED_W_ADAPT
  local bx = (instX * C.PRED_W_INSTANT + hX * C.PRED_W_HISTORY + st.adaptVel.X * C.PRED_W_ADAPT) / wTotal
  local by = (instY * C.PRED_W_INSTANT + hY * C.PRED_W_HISTORY + st.adaptVel.Y * C.PRED_W_ADAPT) / wTotal
  local bz = (instZ * C.PRED_W_INSTANT + hZ * C.PRED_W_HISTORY + st.adaptVel.Z * C.PRED_W_ADAPT) / wTotal
  return Vector3.new(bx, by, bz)
end

local function updatePredictability(vel, dt)
  local vmag = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
  if vmag > 0.3 then
    local dx, dz = vel.X / vmag, vel.Z / vmag
    if st.lastDirSet then
      local dot = dx * st.lastDirX + dz * st.lastDirZ
      st.predictability = expDecay(st.predictability, (dot + 1) * 0.5, C.PRED_DIR_CONSISTENCY_TAU, dt)
    end
    st.lastDirX, st.lastDirZ, st.lastDirSet = dx, dz, true
  else
    st.predictability = expDecay(st.predictability, 0.5, 0.5, dt)
  end
end

local function updateVelocityInertia(vel, dt)
  local srcX, srcZ = vel.X, vel.Z
  local srcY = vel.Y
  local vmag = math.sqrt(srcX * srcX + srcZ * srcZ)
  local tau = C.PRED_INERTIA_TAU * st.predInertiaVar
  if vmag > C.PRED_INERTIA_FAST_VEL then tau = C.PRED_INERTIA_FAST_TAU * st.predInertiaVar end
  if not st.predVelInit then
    st.predVelX = srcX; st.predVelY = srcY; st.predVelZ = srcZ
    st.predVelSmoothX = srcX; st.predVelSmoothZ = srcZ; st.predVelYSmooth = srcY
    st.predVelInit = true; st.prevPredVelX = srcX; st.prevPredVelZ = srcZ
  else
    st.prevPredVelX = st.predVelX; st.prevPredVelZ = st.predVelZ
    st.predVelX = expDecay(st.predVelX, srcX, tau, dt)
    st.predVelY = expDecay(st.predVelY, srcY, tau, dt)
    st.predVelZ = expDecay(st.predVelZ, srcZ, tau, dt)
  end
  st.predVelSmoothX = expDecay(st.predVelSmoothX, st.predVelX, C.PRED_VEL_EMA_TAU, dt)
  st.predVelSmoothZ = expDecay(st.predVelSmoothZ, st.predVelZ, C.PRED_VEL_EMA_TAU, dt)
  st.predVelYSmooth = expDecay(st.predVelYSmooth, st.predVelY, 0.050, dt)
  local varX = srcX - st.predVelSmoothX
  local varZ = srcZ - st.predVelSmoothZ
  local variance = math.sqrt(varX * varX + varZ * varZ)
  st.predVarSmooth = expDecay(st.predVarSmooth, variance, 0.060, dt)
  st.lastTargetVelMag = math.sqrt(st.predVelSmoothX ^ 2 + st.predVelSmoothZ ^ 2)
end

local function computeYPredict(dt)
  if not C.PRED_Y_ENABLE then
    st.predYSmooth = expDecay(st.predYSmooth, 0, C.PRED_Y_SMOOTH_TAU, dt)
    return st.predYSmooth
  end
  local vy = st.predVelYSmooth
  local inAir = st.targetAirborne
  local now = tick()
  if inAir and vy > C.PRED_Y_JUMP_DETECT_VEL then
    if not st.jumpActive then
      st.jumpActive = true
      st.jumpStartTime = now
      st.jumpPeakYVel = vy
      st.jumpApexDetected = false
      st.jumpApexTime = 0
    end
    if vy > st.jumpPeakYVel then st.jumpPeakYVel = vy end
    if not st.jumpApexDetected and vy < st.jumpPeakYVel * C.PRED_Y_APEX_RATIO then
      st.jumpApexDetected = true
      st.jumpApexTime = now
    end
  elseif not inAir then
    st.jumpActive = false
    st.jumpApexDetected = false
  end
  local py = 0
  if st.jumpActive and st.jumpApexDetected then
    local el = now - st.jumpApexTime
    local rise = C.PRED_Y_PULSE_RISE
    local fall = C.PRED_Y_PULSE_FALL
    local amp = C.PRED_Y_PULSE_AMP
    if el < rise then
      local t = el / rise
      py = amp * (1 - (1 - t) * (1 - t))
    elseif el < rise + fall then
      local t = (el - rise) / fall
      py = amp * (1 - t * t)
    else
      py = 0
      st.jumpActive = false
      st.jumpApexDetected = false
    end
  end
  st.predYSmooth = expDecay(st.predYSmooth, py, C.PRED_Y_SMOOTH_TAU, dt)
  return st.predYSmooth
end

local function computePredictionConfidence(dt)
  local conf = 1.0
  if st.predVarSmooth > C.PRED_VARIANCE_MAX then
    local over = st.predVarSmooth - C.PRED_VARIANCE_MAX
    conf = conf * clamp(1 - over / C.PRED_CONFIDENCE_VAR_PENALTY, 0.0, 1.0)
  end
  if st.predictability < C.PRED_CONSISTENCY_MIN then
    local under = C.PRED_CONSISTENCY_MIN - st.predictability
    conf = conf * clamp(1 - under * C.PRED_CONFIDENCE_CONSIST_PENALTY, 0.0, 1.0)
  end
  if st.dirChangePending then conf = conf * C.PRED_CONFIDENCE_DIRCHANGE_PENALTY end
  conf = math.max(C.PRED_CONFIDENCE_MIN, conf)
  st.predConfidence = expDecay(st.predConfidence or 1.0, conf, C.PRED_CONFIDENCE_SMOOTH_TAU, dt)
  return st.predConfidence
end

local function computePredictionOffset(vel, dt)
  if st.tpIgnoreTimer > 0 then
    st.tpIgnoreTimer = st.tpIgnoreTimer - dt
    return Vector3.zero
  end
  local pvx = st.predVelSmoothX
  local pvz = st.predVelSmoothZ
  local vmag = math.sqrt(pvx * pvx + pvz * pvz)
  local py = computeYPredict(dt)
  if vmag < C.PRED_MIN_VEL then return Vector3.new(0, py, 0) end
  if C.PRED_STILL_CUTOFF and vmag < C.PRED_STILL_VEL then return Vector3.new(0, py, 0) end
  local conf = computePredictionConfidence(dt)
  local ramp = 1 - math.exp(-st.lockAge / C.PRED_RAMP_TAU)
  local vFactor = clamp((vmag - C.PRED_MIN_VEL) / (C.PRED_MAX_VEL - C.PRED_MIN_VEL), 0, 1)
  vFactor = vFactor ^ C.PRED_CURVE
  local scale = C.PRED_LEAD * vFactor * ramp * conf * st.predVar * (st.predBlend or 1.0)
  local px = pvx * scale
  local pz = pvz * scale
  if C.PRED_CLOSE_ENABLE and st.targetWorldD then
    local t = clamp((st.targetWorldD - C.PRED_CLOSE_NEAR) / math.max(C.PRED_CLOSE_FAR - C.PRED_CLOSE_NEAR, 1), 0, 1)
    t = t * t * (3 - 2 * t)
    local closeScale = lerp(C.PRED_CLOSE_MIN_SCALE, 1.0, t)
    px = px * closeScale
    py = py * closeScale
    pz = pz * closeScale
  end
  local hMag = math.sqrt(px * px + pz * pz)
  if hMag > C.PRED_MAX then
    local s = C.PRED_MAX / hMag
    px, pz = px * s, pz * s
  end
  return Vector3.new(px, py, pz)
end

local function applySurfacePrediction(predOffset)
  if not C.SURFACE_PREDICT_ENABLE then return predOffset end
  if not st.targetChar or not st.targetChar.Parent then return predOffset end
  local root = st.targetChar:FindFirstChild("HumanoidRootPart")
  if not root then return predOffset end
  local velX = st.predVelSmoothX or 0
  local velZ = st.predVelSmoothZ or 0
  local velMag = math.sqrt(velX * velX + velZ * velZ)
  if velMag < C.SURFACE_PREDICT_VEL_MIN then return predOffset end
  local dirX, dirZ = velX / velMag, velZ / velMag
  local horizPx = predOffset.X
  local horizPz = predOffset.Z
  local horizMag = math.sqrt(horizPx * horizPx + horizPz * horizPz)
  if horizMag < 0.1 then return predOffset end
  local rp = RaycastParams.new()
  rp.FilterType = Enum.RaycastFilterType.Exclude
  local ex = {}
  if st.targetChar then table.insert(ex, st.targetChar) end
  if player.Character then table.insert(ex, player.Character) end
  rp.FilterDescendantsInstances = ex
  rp.IgnoreWater = true
  local castLen = math.min(C.SURFACE_PREDICT_MAX_CAST, horizMag + C.SURFACE_PREDICT_MARGIN * 2 + 3)
  local castVec = Vector3.new(dirX, 0, dirZ) * castLen
  local result = workspace:Raycast(root.Position, castVec, rp)
  if result then
    local hitDist = (result.Position - root.Position).Magnitude
    local maxHoriz = math.max(0, hitDist - C.SURFACE_PREDICT_MARGIN)
    if maxHoriz < horizMag then
      local capScale = maxHoriz / horizMag
      predOffset = Vector3.new(predOffset.X * capScale, predOffset.Y, predOffset.Z * capScale)
    end
  end
  if C.SURFACE_PREDICT_GROUND_ENABLE and predOffset.Y < -0.5 then
    local downCast = Vector3.new(0, predOffset.Y - 2, 0)
    local gres = workspace:Raycast(root.Position, downCast, rp)
    if gres then
      local groundDist = (root.Position - gres.Position).Magnitude
      if math.abs(predOffset.Y) > groundDist then
        local newY = -math.max(0, groundDist - C.SURFACE_PREDICT_GROUND_MARGIN)
        predOffset = Vector3.new(predOffset.X, newY, predOffset.Z)
      end
    end
  end
  return predOffset
end

local function updateAimDrift(dt, eMag)
  st.aimDriftT = st.aimDriftT + dt
  if eMag > C.AIM_DRIFT_RANGE then return 0, 0 end
  local nearMul = 1.0
  if eMag < 4.0 then nearMul = C.AIM_DRIFT_NEAR_MULT end
  local fMod = 1 + n1(st.aimDriftT * 0.15, 130) * C.AIM_DRIFT_FREQ_MOD
  local dx = fbm1(st.aimDriftT * C.AIM_DRIFT_FREQ * fMod, 131, 3) * C.AIM_DRIFT_AMP_X * nearMul
  local dy = fbm1(st.aimDriftT * C.AIM_DRIFT_FREQ * fMod * 0.87, 132, 3) * C.AIM_DRIFT_AMP_Y * nearMul
  return dx, dy
end

local function updateAimSpot(dt)
  st.spotTimer = st.spotTimer - dt
  if st.spotTimer <= 0 then
    st.spotTimer = rRange(C.AIM_SPOT_MIN_T, C.AIM_SPOT_MAX_T)
    local r = C.AIM_SPOT_TORSO
    st.spotTX = rRange(-r, r) * 100
    st.spotTY = rRange(-r, r) * 100
  end
  st.spotNoiseT = st.spotNoiseT + dt * C.AIM_SPOT_NOISE_SPEED
  local nx = n1(st.spotNoiseT, 1) * C.AIM_SPOT_NOISE * 100
  local ny = n1(st.spotNoiseT, 2) * C.AIM_SPOT_NOISE * 100
  st.spotX = expDecay(st.spotX, st.spotTX + nx, C.AIM_SPOT_TAU, dt)
  st.spotY = expDecay(st.spotY, st.spotTY + ny, C.AIM_SPOT_TAU, dt)
end

local function updateBreathing(dt, targetVelMag, eMag)
  st.breathT = st.breathT + dt
  local idle = clamp(1 - targetVelMag / C.BREATH_VEL_THRESH, 0, 1)
  idle = idle * idle * (3 - 2 * idle)
  local proxScale = clamp(1 - eMag / C.BREATH_NEAR_SCALE, 0, 1)
  proxScale = proxScale * proxScale * (3 - 2 * proxScale)
  local amt = idle * proxScale
  if amt < 0.01 then return 0, 0, 0 end
  local freqModY = 1 + n1(st.breathT * 0.14, 92) * C.BREATH_FREQ_MOD_AMP
  local freqModX = 1 + n1(st.breathT * 0.11, 93) * C.BREATH_FREQ_MOD_AMP
  local freqModZ = 1 + n1(st.breathT * 0.09, 94) * C.BREATH_FREQ_MOD_AMP
  local bx = fbm1(st.breathT * C.BREATH_FREQ_X * freqModX, 101, 3) * C.BREATH_AMP_X * amt
  local by = fbm1(st.breathT * C.BREATH_FREQ_Y * freqModY, 102, 3) * C.BREATH_AMP_Y * amt
  local bz = fbm1(st.breathT * C.BREATH_FREQ_Z * freqModZ, 103, 3) * C.BREATH_AMP_Z * amt
  return bx, by, bz
end

local function updateSaccades(dt, eMag)
  st.saccadeTimer = st.saccadeTimer - dt
  if st.saccadeTimer <= 0 then
    st.saccadeTimer = rRange(C.SACCADE_MIN_INTERVAL, C.SACCADE_MAX_INTERVAL)
    local proxScale = clamp(1 - eMag / C.SACCADE_NEAR_SCALE, 0, 1)
    if math.random() < C.SACCADE_CHANCE * proxScale and eMag < C.SACCADE_ACTIVE_RANGE then
      local ang = math.random() * math.pi * 2
      local mag = rRange(0.4, 1.0) * C.SACCADE_AMP
      st.saccadeX = math.cos(ang) * mag * C.SACCADE_X_SCALE
      st.saccadeY = math.sin(ang) * mag * 0.65
    end
  end
  st.saccadeX = expDecay(st.saccadeX, 0, C.SACCADE_DECAY_TAU, dt)
  st.saccadeY = expDecay(st.saccadeY, 0, C.SACCADE_DECAY_TAU, dt)
  return st.saccadeX, st.saccadeY
end

local function updateTremor(dt, eMag)
  st.tremorT = st.tremorT + dt
  if eMag > C.TREMOR_ACTIVE_RANGE then return 0, 0 end
  local proxScale = clamp(1 - eMag / C.TREMOR_NEAR_SCALE, 0, 1)
  proxScale = proxScale * proxScale * (3 - 2 * proxScale)
  local freqMod = 1 + n1(st.tremorT * 0.5, 104) * C.TREMOR_FREQ_MOD_AMP
  local ampMod = 0.6 + (n1(st.tremorT * C.TREMOR_AMP_MOD_SPEED, 105) + 1) * 0.5 * 0.8
  local amp = C.TREMOR_AMP * ampMod * proxScale
  local tx = math.sin(st.tremorT * 2 * math.pi * C.TREMOR_FREQ * freqMod) * amp
  local ty = math.cos(st.tremorT * 2 * math.pi * C.TREMOR_FREQ * freqMod * 1.07) * amp * 0.55
  return tx, ty
end

local function updateVerticalMicro(dt, eMag, errorY)
  st.vertMicroT = st.vertMicroT + dt
  if eMag > C.VERT_MICRO_RANGE then return 0 end
  local rangeT = 1 - (eMag / C.VERT_MICRO_RANGE)
  rangeT = rangeT * rangeT * (3 - 2 * rangeT)
  local fMod = 1 + n1(st.vertMicroT * 0.18, 120) * C.VERT_MICRO_FREQ_MOD
  local aMod = 1 + n1(st.vertMicroT * 0.42, 121) * 0.45
  local m = fbm1(st.vertMicroT * C.VERT_MICRO_FREQ_BASE * fMod, 122, 3) * C.VERT_MICRO_AMP * rangeT * aMod
  return m
end

local function updateDoubleTap(dt, eMag)
  if not C.DOUBLE_TAP_ENABLE then return 0, 0 end
  st.doubleTapTimer = st.doubleTapTimer - dt
  if st.doubleTapTimer <= 0 then
    st.doubleTapTimer = rRange(C.DOUBLE_TAP_MIN_INTERVAL, C.DOUBLE_TAP_MAX_INTERVAL)
    if eMag > 3.0 and eMag < 40.0 and math.random() < C.DOUBLE_TAP_CHANCE then
      local ang = math.random() * math.pi * 2
      local mag = C.DOUBLE_TAP_AMP * rRange(0.6, 1.0)
      st.doubleTapX = math.cos(ang) * mag
      st.doubleTapY = math.sin(ang) * mag
    end
  end
  st.doubleTapX = expDecay(st.doubleTapX, 0, C.DOUBLE_TAP_TAU, dt)
  st.doubleTapY = expDecay(st.doubleTapY, 0, C.DOUBLE_TAP_TAU, dt)
  return st.doubleTapX, st.doubleTapY
end

local function updateGait(dt)
  if not C.GAIT_ENABLE then st.gaitMul = 1.0; return end
  st.gaitPhase = st.gaitPhase + dt / math.max(st.gaitPeriod, 0.05)
  if st.gaitPhase >= 1 then
    st.gaitPhase = 0
    if math.random() < C.GAIT_PAUSE_CHANCE then
      st.gaitPeriod = rRange(0.30, 0.55)
    else
      st.gaitPeriod = rRange(C.GAIT_PERIOD_MIN, C.GAIT_PERIOD_MAX)
    end
  end
  local curve = bell(st.gaitPhase)
  st.gaitMul = lerp(1.0, curve * 1.2 + 0.25, C.GAIT_CURVE_DEPTH)
end

local function updateMicroPause(dt)
  if not C.MICRO_PAUSE_ENABLE then st.microPauseScale = 1.0; return end
  if st.microPauseHold > 0 then
    st.microPauseHold = st.microPauseHold - dt
    local target = C.MICRO_PAUSE_SCALE
    st.microPauseScale = expDecay(st.microPauseScale, target, 0.020, dt)
    if st.microPauseHold <= 0 then
      st.microPauseTimer = rRange(C.MICRO_PAUSE_TIMER_MIN, C.MICRO_PAUSE_TIMER_MAX)
    end
  else
    st.microPauseTimer = st.microPauseTimer - dt
    if st.microPauseTimer <= 0 then
      if math.random() < C.MICRO_PAUSE_CHANCE then
        st.microPauseHold = rRange(C.MICRO_PAUSE_HOLD_MIN, C.MICRO_PAUSE_HOLD_MAX)
      else
        st.microPauseTimer = rRange(0.30, 0.70)
      end
    end
    st.microPauseScale = expDecay(st.microPauseScale, 1.0, 0.080, dt)
  end
end

local function updateMicroCorrect(dt, eMag)
  if not C.MICRO_CORRECT_ENABLE then return 0, 0 end
  if eMag > C.MICRO_CORRECT_RANGE then return 0, 0 end
  local rangeT = 1 - (eMag / C.MICRO_CORRECT_RANGE)
  rangeT = rangeT * rangeT
  st.microCorrectT = st.microCorrectT + dt
  local fMod = 1 + n1(st.microCorrectT * 0.22, 210) * 0.35
  local mx = math.sin(st.microCorrectT * 2 * math.pi * C.MICRO_CORRECT_FREQ * fMod) * C.MICRO_CORRECT_AMP * rangeT
  local my = math.cos(st.microCorrectT * 2 * math.pi * C.MICRO_CORRECT_FREQ * fMod * 1.13) * C.MICRO_CORRECT_AMP * rangeT * 0.7
  return mx, my
end

local function updateBlink(dt, eMag)
  if not C.BLINK_ENABLE then return 1.0 end
  st.blinkTimer = st.blinkTimer - dt
  if st.blinkTimer <= 0 then
    st.blinkTimer = rRange(C.BLINK_MIN_INTERVAL, C.BLINK_MAX_INTERVAL)
    if eMag > 2.0 and math.random() < C.BLINK_CHANCE then
      st.blinkHold = C.BLINK_DURATION
    end
  end
  if st.blinkHold > 0 then
    st.blinkHold = st.blinkHold - dt
    return C.BLINK_SCALE
  end
  return 1.0
end

local function updateOvershoot(dt, errorX, errorY, eMag)
  if not C.OVERSHOOT_SETTLE_ENABLE then return 0, 0 end
  -- NUEVO: NO overshoot cuando el target está cerca
  if eMag < C.OVERSHOOT_MIN_ERR then
    st.prevErrorX = errorX
    st.prevErrorY = errorY
    st.prevErrorMag = eMag
    return 0, 0
  end
  if st.overshootTimer > 0 then
    st.overshootTimer = st.overshootTimer - dt
    local t = clamp(st.overshootTimer / C.OVERSHOOT_SETTLE_TIME, 0, 1)
    local curve = bell(t)
    local amp = C.OVERSHOOT_SETTLE_AMP * math.min(eMag / C.OVERSHOOT_SETTLE_RANGE, 1.0)
    return st.overshootDirX * amp * curve, st.overshootDirY * amp * curve
  end
  if st.prevErrorMag and st.prevErrorMag > 10.0 and eMag < 2.0 then
    local prevNormX = st.prevErrorX / math.max(st.prevErrorMag, 0.001)
    local prevNormY = st.prevErrorY / math.max(st.prevErrorMag, 0.001)
    st.overshootDirX = -prevNormX
    st.overshootDirY = -prevNormY
    st.overshootTimer = C.OVERSHOOT_SETTLE_TIME
  end
  st.prevErrorX = errorX
  st.prevErrorY = errorY
  st.prevErrorMag = eMag
  return 0, 0
end

local function updateHandShake(dt, eMag)
  if not C.HANDSHAKE_ENABLE then return 0, 0 end
  if eMag > 8.0 then return 0, 0 end
  st.handShakeT = st.handShakeT + dt
  local scale = 1 - (eMag / 8.0)
  scale = scale * scale
  local amp = C.HANDSHAKE_AMP * scale
  local hx = math.sin(st.handShakeT * 2 * math.pi * C.HANDSHAKE_FREQ) * amp
  local hy = math.cos(st.handShakeT * 2 * math.pi * C.HANDSHAKE_FREQ * 1.21) * amp * 0.65
  return hx, hy
end

local function updateFatigue(dt, eMag)
  if not C.FATIGUE_ENABLE then return 0, 0 end
  st.fatigueT = st.fatigueT + dt
  if eMag > 15.0 then
    st.fatigueLevel = math.min(1.0, st.fatigueLevel + dt * C.FATIGUE_RATE)
  else
    st.fatigueLevel = math.max(0.0, st.fatigueLevel - dt * C.FATIGUE_DECAY)
  end
  if st.fatigueLevel < 0.05 then return 0, 0 end
  local fAmp = st.fatigueLevel * C.FATIGUE_DRIFT_AMP
  local fx = fbm1(st.fatigueT * 0.35, 220, 3) * fAmp
  local fy = fbm1(st.fatigueT * 0.32, 221, 3) * fAmp * 0.7
  return fx, fy
end

local function updateAnticipate(dt, errorX, errorY, eMag)
  if not C.ANTICIPATE_ENABLE then return 0, 0 end
  local targetAX, targetAY = 0, 0
  if eMag > 8.0 and eMag < 60.0 then
    local nx, ny = errorX / eMag, errorY / eMag
    targetAX = nx * C.ANTICIPATE_GAIN
    targetAY = ny * C.ANTICIPATE_GAIN
  end
  st.anticipateX = expDecay(st.anticipateX, targetAX, C.ANTICIPATE_TAU, dt)
  st.anticipateY = expDecay(st.anticipateY, targetAY, C.ANTICIPATE_TAU, dt)
  return st.anticipateX, st.anticipateY
end

local function updateSmartFlickScreenVel(dt)
  if not st.targetChar or not st.targetChar.Parent then
    st.smlScreenVelInit = false
    return
  end
  local root = st.targetChar:FindFirstChild("HumanoidRootPart")
  if not root then return end
  local sp = camera:WorldToViewportPoint(root.Position)
  if sp.Z <= 0 then return end
  local now = tick()
  if st.smlScreenVelInit and st.smlPrevTargetScreenT > 0 then
    local dtS = now - st.smlPrevTargetScreenT
    if dtS > 0.001 and dtS < 0.1 then
      local vx = (sp.X - st.smlPrevTargetScreenX) / dtS
      local vy = (sp.Y - st.smlPrevTargetScreenY) / dtS
      local a = 1 - math.exp(-dt / C.SMART_FLICK_VEL_SMOOTH_TAU)
      st.smlTargetScreenVelX = st.smlTargetScreenVelX + (vx - st.smlTargetScreenVelX) * a
      st.smlTargetScreenVelY = st.smlTargetScreenVelY + (vy - st.smlTargetScreenVelY) * a
    end
  end
  st.smlPrevTargetScreenX = sp.X
  st.smlPrevTargetScreenY = sp.Y
  st.smlPrevTargetScreenT = now
  st.smlScreenVelInit = true
end

local function anyFlickActive()
  if C.FLICK_LOCK_SHARED then
    if st.flickTimer > 0 then return true end
    if st.smartFlickTimer > 0 then return true end
    if st.smartFlickActive and st.smartFlickHoldTimer > 0 then return true end
  end
  return false
end

local function updateSmartFlick(dt, cursor, errorX, errorY, eMag)
  if not C.SMART_FLICK_ENABLE then return end
  if eMag < 14.0 then return end
  if st.smartFlickCooldown > 0 then st.smartFlickCooldown = st.smartFlickCooldown - dt end
  if st.smartFlickTimer > 0 then
    st.smartFlickTimer = st.smartFlickTimer - dt
    if st.smartFlickTimer <= 0 then st.smartFlickHoldTimer = C.SMART_FLICK_HOLD_TIME end
  end
  if st.smartFlickHoldTimer > 0 then
    st.smartFlickHoldTimer = st.smartFlickHoldTimer - dt
    if st.smartFlickActive and st.targetChar and st.targetChar.Parent then
      local root = st.targetChar:FindFirstChild("HumanoidRootPart")
      if root then
        local tsp = camera:WorldToViewportPoint(root.Position)
        if tsp.Z > 0 then
          local dx = tsp.X - st.smartFlickParkX
          local dy = tsp.Y - st.smartFlickParkY
          if vlen(dx, dy) < C.SMART_FLICK_RESUME_DIST then
            st.smartFlickHoldTimer = 0
            st.smartFlickActive = false
            st.smartFlickCooldown = C.SMART_FLICK_COOLDOWN
          end
        end
      end
    end
    if st.smartFlickHoldTimer <= 0 then
      st.smartFlickActive = false
      st.smartFlickCooldown = C.SMART_FLICK_COOLDOWN
    end
  end
  if st.smartFlickActive then return end
  if st.smartFlickCooldown > 0 then return end
  if st.smartFlickTimer > 0 then return end
  if st.smartFlickHoldTimer > 0 then return end
  if anyFlickActive() then return end
  if st.userYankTimer > 0 then return end
  if st.userMoveInf > 0.15 then return end
  if st.userPriority > C.USER_INPUT_FULL_STOP_THRESHOLD then return end
  if (st.mouseSpeedSmooth or 0) > C.MANUAL_FULL_SPEED * 0.5 then return end
  local conf = st.predConfidence or 1.0
  local tvMag = st.lastTargetVelMag or 0
  if conf < C.SMART_FLICK_MIN_CONF then return end
  if tvMag < C.SMART_FLICK_MIN_TGT_VEL then return end
  if eMag < C.SMART_FLICK_MIN_ERR then return end
  if eMag > C.SMART_FLICK_MAX_ERR then return end
  if math.random() > C.SMART_FLICK_TRIGGER_CHANCE then return end
  if not st.smlScreenVelInit then return end
  if not st.targetChar or not st.targetChar.Parent then return end
  local root = st.targetChar:FindFirstChild("HumanoidRootPart")
  if not root then return end
  local tsp = camera:WorldToViewportPoint(root.Position)
  if tsp.Z <= 0 then return end
  local parkX = tsp.X + st.smlTargetScreenVelX * C.SMART_FLICK_LEAD_TIME
  local parkY = tsp.Y + st.smlTargetScreenVelY * C.SMART_FLICK_LEAD_TIME
  local leadDx = parkX - tsp.X
  local leadDy = parkY - tsp.Y
  local leadMag = vlen(leadDx, leadDy)
  local maxLead = eMag * C.SMART_FLICK_MAX_LEAD_RATIO
  if leadMag > maxLead and leadMag > 0.001 then
    local s = maxLead / leadMag
    parkX = tsp.X + leadDx * s
    parkY = tsp.Y + leadDy * s
  end
  local startFx = tsp.X - cursor.X
  local startFy = tsp.Y - cursor.Y
  local startMag = vlen(startFx, startFy)
  local endFx = parkX - cursor.X
  local endFy = parkY - cursor.Y
  local endMag = vlen(endFx, endFy)
  if startMag < 3 or endMag < 3 then return end
  if endMag > C.SMART_FLICK_MAX_MAG then
    local s = C.SMART_FLICK_MAX_MAG / endMag
    endFx = endFx * s
    endFy = endFy * s
    parkX = cursor.X + endFx
    parkY = cursor.Y + endFy
    endMag = C.SMART_FLICK_MAX_MAG
  end
  st.smlStartDirX = startFx / startMag
  st.smlStartDirY = startFy / startMag
  st.smlEndDirX = endFx / endMag
  st.smlEndDirY = endFy / endMag
  st.smartFlickDirX = st.smlEndDirX
  st.smartFlickDirY = st.smlEndDirY
  st.smartFlickMag = endMag
  st.smartFlickParkX = parkX
  st.smartFlickParkY = parkY
  st.smartFlickTimer = C.SMART_FLICK_FLICK_TIME
  st.smartFlickActive = true
  st.smartFlickTriggered = true
  st.smartFlickPhaseSeed = math.random() * 100
end

local function updateReturnPulse(dt, errorX, errorY)
  if not C.RETURN_PULSE_ENABLE then st.recentHitTime = nil; return end
  if st.returnCooldown > 0 then st.returnCooldown = st.returnCooldown - dt end
  local eMag = vlen(errorX, errorY)
  if eMag < 8.0 then st.recentHitTime = nil; return end
  local now = tick()
  if eMag < C.RETURN_PULSE_HIT_RANGE then st.recentHitTime = now end
  local overshoot = false
  if st.recentHitTime and (now - st.recentHitTime) < C.RETURN_PULSE_HIT_WINDOW then
    if eMag > C.RETURN_PULSE_MIN_ERR then overshoot = true end
  end
  if overshoot and st.returnCooldown <= 0 and st.returnPauseTimer <= 0 and st.returnPulseTimer <= 0 then
    local proximityT = clamp((eMag - C.RETURN_PULSE_NEAR_SKIP) / math.max(C.RETURN_PULSE_NEAR_FADE - C.RETURN_PULSE_NEAR_SKIP, 1), 0, 1)
    proximityT = proximityT * proximityT
    if proximityT <= 0.02 then
      st.recentHitTime = nil
    else
      st.returnPauseTimer = C.RETURN_PULSE_PAUSE * proximityT
      st.returnCooldown = C.RETURN_PULSE_COOLDOWN
      st.recentHitTime = nil
      st._returnProximityT = proximityT
    end
  end
  if st.returnPauseTimer > 0 then
    st.returnPauseTimer = st.returnPauseTimer - dt
    if st.returnPauseTimer <= 0 then
      local m = vlen(errorX, errorY)
      if m > 0.5 and m < 200 then
        local pt = st._returnProximityT or 1.0
        st.returnPulseDirX = errorX / m
        st.returnPulseDirY = errorY / m
        st.returnPulseMag = m * C.RETURN_PULSE_GAIN * pt
        st.returnPulseTimer = C.RETURN_PULSE_DURATION * lerp(0.5, 1.0, pt)
      end
    end
  end
  if st.returnPulseTimer > 0 then st.returnPulseTimer = st.returnPulseTimer - dt end
end

local function resolveBaseAim(char, cursor, dt)
  local hum = char:FindFirstChildOfClass("Humanoid")
  local root = char:FindFirstChild("HumanoidRootPart")
  if not root then return nil, false end
  local airborne = hum and hum.FloorMaterial == Enum.Material.Air
  st.targetAirborne = airborne
  local rawPos = getAimPoint(char, cursor, dt)
  if not rawPos then
    return Vector3.new(root.Position.X, root.Position.Y + C.AIM_ANCHOR_HEIGHT, root.Position.Z), false
  end
  if C.AIM_POINT_MODE == "Head" then
    st.aimPointPart = findPart(char, "Head")
    st.aimPointName = "Head"
  elseif C.AIM_POINT_MODE == "UpperTorso" then
    st.aimPointPart = findPart(char, "UpperTorso") or findPart(char, "Torso")
    st.aimPointName = st.aimPointPart and st.aimPointPart.Name or "UpperTorso"
  elseif C.AIM_POINT_MODE == "Torso" then
    st.aimPointPart = findPart(char, "Torso") or findPart(char, "UpperTorso")
    st.aimPointName = st.aimPointPart and st.aimPointPart.Name or "Torso"
  elseif C.AIM_POINT_MODE == "Dynamic" then
    st.aimPointPart = root
    st.aimPointName = "Dynamic"
  elseif C.AIM_POINT_MODE == "RootOffset" then
    st.aimPointPart = root
    st.aimPointName = "RootOffset"
  end
  local withOffset = rawPos + st.hitboxOffset
  if C.AIM_SMOOTH_ENABLE then
    if not st.aimSmoothWorld then
      st.aimSmoothWorld = withOffset
    else
      local tau = C.AIM_SMOOTH_TAU
      local a = 1 - math.exp(-dt / math.max(tau, 0.001))
      st.aimSmoothWorld = st.aimSmoothWorld + (withOffset - st.aimSmoothWorld) * a
    end
    return st.aimSmoothWorld, false
  end
  return withOffset, false
end

local function computeAimWorld(char, dt, cursor)
  local root = char:FindFirstChild("HumanoidRootPart")
  if not root then return nil end
  local hum = char:FindFirstChildOfClass("Humanoid")
  if not hum then return nil end
  updateHitboxZone(dt)
  local basePos, isAir = resolveBaseAim(char, cursor, dt)
  if not basePos then return nil end
  local baseX, baseY, baseZ = basePos.X, basePos.Y, basePos.Z
  local eMag = 999
  local spTmp = camera:WorldToViewportPoint(Vector3.new(baseX, baseY, baseZ))
  if spTmp.Z > 0 then
    local dx = spTmp.X - cursor.X
    local dy = spTmp.Y - cursor.Y
    eMag = math.sqrt(dx * dx + dy * dy)
  end
  local bX, bY, bZ = updateBreathing(dt, st.lastTargetVelMag, eMag)
  baseX = baseX + bX
  baseY = baseY + bY
  baseZ = baseZ + bZ
  updateAimSpot(dt)
  return Vector3.new(baseX, baseY, baseZ), true
end

local function computeAimScreen(char, dt, cursor)
  local world = computeAimWorld(char, dt, cursor)
  if not world then return nil end
  local vel = computeBlendedVelocity()
  updatePredictability(vel, dt)
  updateVelocityInertia(vel, dt)
  local predOffset = computePredictionOffset(vel, dt)
  predOffset = applySurfacePrediction(predOffset)
  local finalWorld = world + predOffset
  if C.AIM_VIS_CHECK_ENABLE and C.WALLCHECK then
    local visRaw = canSee(world, char, true)
    local visFinal = canSee(finalWorld, char, true)
    local vis = visRaw and visFinal
    local now = tick()
    if not vis then
      if st.aimPointVisible then
        st.aimPointVisible = false
        st.aimPointNotVisibleSince = now
      end
      -- NUEVO: cuando el target está fuera de FOV y no visible, NO devolvemos nil.
      -- Dejamos que siga trackeando la posición aunque esté oculto.
      -- Solo devolvemos nil si lleva MUCHO tiempo sin verse Y el usuario está jalando
      if (now - st.aimPointNotVisibleSince) > 2.5 then
        return nil
      end
    else
      st.aimPointVisible = true
      st.aimPointNotVisibleSince = 0
    end
  end
  local sp = camera:WorldToViewportPoint(finalWorld)
  if sp.Z <= 0 then return nil end
  local rawX = sp.X + st.spotX
  local rawY = sp.Y + st.spotY
  if st.acquireBlend < 1 then
    st.acquireBlend = math.min(1, st.acquireBlend + dt / math.max(C.ACQUIRE_BLEND_TIME, 0.001))
    local t = st.acquireBlend
    t = t * t * (3 - 2 * t)
    rawX = st.acquireBlendFromX + (rawX - st.acquireBlendFromX) * t
    rawY = st.acquireBlendFromY + (rawY - st.acquireBlendFromY) * t
  end
  if st.switchBlend < 1 then
    local dur = st.switchBlendDuration or C.SWITCH_BLEND_TIME
    st.switchBlend = math.min(1, st.switchBlend + dt / math.max(dur, 0.001))
    local t = st.switchBlend
    t = t * t * (3 - 2 * t)
    rawX = st.switchFromX + (rawX - st.switchFromX) * t
    rawY = st.switchFromY + (rawY - st.switchFromY) * t
  end
  st.aimScreenX, st.aimScreenY = rawX, rawY
  st.aimScreenInit = true
  return st.aimScreenX, st.aimScreenY, vel
end

local function updateManualInfluence(dt)
  local rawSpeed = vlen(st.mouseDeltaX, st.mouseDeltaY) / math.max(dt, C.MOUSE_DT_MIN)
  if rawSpeed > C.MANUAL_DEADZONE then
    st.manualPeakTime = tick()
    st.manualHoldTimer = C.MANUAL_HOLD_TIME
  else
    st.manualHoldTimer = st.manualHoldTimer - dt
  end
  local spd = st.mouseSpeedSmooth
  local demand = 0
  if spd > C.MANUAL_DEADZONE then
    demand = smoothstep(C.MANUAL_DEADZONE, C.MANUAL_FULL_SPEED, spd) * C.MANUAL_MAX_INFLUENCE
  end
  if st.manualHoldTimer > 0 and demand < st.manualInf then demand = st.manualInf end
  local tau = (demand > st.manualInf) and C.MANUAL_TAU_IN or C.MANUAL_TAU_OUT
  st.manualInf = expDecay(st.manualInf, demand, tau, dt)
  if st.manualInf < 0.003 then st.manualInf = 0 end
end

local function updateSoftRelease(dt)
  if not C.SOFT_RELEASE_ENABLE then st.releaseSmooth = 0; return end
  local spd = st.mouseSpeedSmooth or 0
  local target = 0
  if spd > C.SOFT_RELEASE_START then
    local t = clamp((spd - C.SOFT_RELEASE_START) / math.max(C.SOFT_RELEASE_FULL - C.SOFT_RELEASE_START, 1), 0, 1)
    t = t * t * (3 - 2 * t)
    target = t * C.SOFT_RELEASE_MAX
  end
  if target > st.releaseSmooth then
    st.releaseSmooth = expDecay(st.releaseSmooth, target, C.SOFT_RELEASE_ATTACK, dt)
  else
    st.releaseSmooth = expDecay(st.releaseSmooth, target, C.SOFT_RELEASE_DECAY, dt)
  end
end

local function computeManualCut()
  local m = st.manualInf
  if m <= C.MANUAL_CUT_START then return 0 end
  if m >= C.MANUAL_CUT_FULL then return 1 end
  local t = (m - C.MANUAL_CUT_START) / (C.MANUAL_CUT_FULL - C.MANUAL_CUT_START)
  return t * t * (3 - 2 * t)
end

local function solveMovement(cursor, aimX, aimY, dt, targetVel)
  if not st.reactDelayRolled then
    local targetStill = (st.lastTargetVelMag or 0) < 4.0
    if targetStill then
      st.reactDelayCurrent = C.REACT_STILL_MIN + math.random() * (C.REACT_STILL_MAX - C.REACT_STILL_MIN)
    else
      st.reactDelayCurrent = C.REACT_DELAY_MIN + math.random() * (C.REACT_DELAY_MAX - C.REACT_DELAY_MIN)
    end
    st.reactDelayRolled = true
  end
  local reactRamp = 1.0
  if C.REACTION_RAMP_ENABLE and st.reactDelayCurrent > 0 then
    local t = clamp(st.lockAge / st.reactDelayCurrent, 0, 1)
    reactRamp = t * t * (3 - 2 * t)
  end
  st.acquireEnvT = st.acquireEnvT + dt
  local acqEnv = 1.0
  if C.ACQUIRE_ENVELOPE_ENABLE and C.ACQUIRE_ENVELOPE_TIME > 0 then
    local t = clamp(st.acquireEnvT / C.ACQUIRE_ENVELOPE_TIME, 0, 1)
    local curved = 1 - (1 - t) ^ C.ACQUIRE_ENVELOPE_CURVE
    acqEnv = C.ACQUIRE_ENVELOPE_MIN + (1 - C.ACQUIRE_ENVELOPE_MIN) * curved
  end
  local errorX = aimX - cursor.X
  local errorY = aimY - cursor.Y
  local eMag = vlen(errorX, errorY)
  if USER.AIM_MODE == "Instant" then
    return errorX * reactRamp * acqEnv, errorY * reactRamp * acqEnv
  end
  updateManualInfluence(dt)
  updateSoftRelease(dt)
  updateGait(dt)
  updateMicroPause(dt)
  if C.USER_INPUT_PRIORITY_ENABLE then
    local userSpeed = st.mouseSpeedSmooth or 0
    local targetPriority = 0
    if userSpeed > C.USER_INPUT_PRIORITY_MIN_SPEED then
      local t = clamp((userSpeed - C.USER_INPUT_PRIORITY_MIN_SPEED) / math.max(C.USER_INPUT_PRIORITY_MAX_SPEED - C.USER_INPUT_PRIORITY_MIN_SPEED, 1), 0, 1)
      targetPriority = t
    end
    local pTau = (targetPriority > st.userPriority) and C.USER_INPUT_PRIORITY_ATTACK or C.USER_INPUT_PRIORITY_RELEASE
    st.userPriority = expDecay(st.userPriority, targetPriority, pTau, dt)
    if st.userPriority < 0.003 then st.userPriority = 0 end
    local override = 1.0
    if st.userPriority > 0.3 then
      override = lerp(1.0, C.USER_INPUT_PRIORITY_OVERRIDE, st.userPriority)
    end
    errorX = errorX * override
    errorY = errorY * override
    eMag = vlen(errorX, errorY)
  end
  local downSpeed = st.mouseDeltaY / math.max(dt, C.MOUSE_DT_MIN)
  local downTarget = smoothstep(0, C.MANUAL_DOWN_THRESH * 2, downSpeed) * C.MANUAL_DOWN_MAX
  local dTau = (downTarget > st.manualDownInf) and C.MANUAL_DOWN_TAU_IN or C.MANUAL_DOWN_TAU_OUT
  st.manualDownInf = expDecay(st.manualDownInf, downTarget, dTau, dt)
  local manualCutRaw = computeManualCut()
  st.cutSmooth = expDecay(st.cutSmooth, manualCutRaw, C.MANUAL_CUT_SMOOTH_TAU, dt)
  local manualCut = st.cutSmooth

  local nearRange = 8.0
  local nearT = 1 - clamp(eMag / nearRange, 0, 1)
  nearT = nearT * nearT * (3 - 2 * nearT)
  local farT = 1 - nearT

  if C.DIR_LOOKAHEAD_ENABLE and st.targetChar then
    local tvX = st.predVelSmoothX or 0
    local tvZ = st.predVelSmoothZ or 0
    local tvMag = math.sqrt(tvX * tvX + tvZ * tvZ)
    if tvMag > 1.0 then
      local ndx, ndz = tvX / tvMag, tvZ / tvMag
      if st.lastTargetDirSet then
        local dot = ndx * st.lastTargetDirX + ndz * st.lastTargetDirZ
        if dot < C.LIVE_DIR_CHANGE_DOT then
          if not st.dirChangePending then
            st.frozenTargetDirX = st.lastTargetDirX
            st.frozenTargetDirZ = st.lastTargetDirZ
            st.dirChangeTime = tick()
            st.dirChangePending = true
            st.frozenDirValidUntil = tick() + C.DIR_REACTION_DELAY
          end
        end
      end
      st.lastTargetDirX = ndx
      st.lastTargetDirZ = ndz
      st.lastTargetDirSet = true
      local useDirX, useDirZ
      if st.dirChangePending and tick() < st.frozenDirValidUntil then
        useDirX, useDirZ = st.frozenTargetDirX, st.frozenTargetDirZ
      else
        useDirX, useDirZ = ndx, ndz
        if st.dirChangePending then st.dirChangePending = false end
      end
      local lookaheadDist = clamp(C.DIR_LOOKAHEAD_TIME * tvMag, 0, C.DIR_LOOKAHEAD_MAX_ERR)
      local laGain = C.DIR_LOOKAHEAD_GAIN * farT
      local lx = useDirX * lookaheadDist * laGain
      local lz = useDirZ * lookaheadDist * laGain
      if camera and st.targetWorldD and st.targetWorldD > 0 then
        local vp = camera.ViewportSize
        local fov = math.rad(camera.FieldOfView)
        local studsPerPx = (2 * st.targetWorldD * math.tan(fov * 0.5)) / vp.Y
        errorX = errorX + lx / math.max(studsPerPx, 0.001)
        errorY = errorY + lz / math.max(studsPerPx, 0.001)
        eMag = vlen(errorX, errorY)
      end
    end
  end
  if C.HUMANIZE_ENABLE and eMag > 0.05 then
    st.humanCurveT = st.humanCurveT + dt
    local eNormX, eNormY = 0, 0
    if eMag > 0.001 then eNormX = errorX / eMag; eNormY = errorY / eMag end
    local perpX, perpY = -eNormY, eNormX
    local curveMul = clamp(eMag / 30.0, 0.2, 1.0)
    local curveAmt = fbm1(st.humanCurveT * C.HUMAN_CURVE_FREQ, 200, 3) * C.HUMAN_CURVE_AMP * curveMul * farT
    errorX = errorX + perpX * curveAmt
    errorY = errorY + perpY * curveAmt
    if eMag < C.HUMAN_WOBBLE_RANGE then
      st.humanWobbleT = st.humanWobbleT + dt
      local wobbleScale = 1 - (eMag / C.HUMAN_WOBBLE_RANGE)
      wobbleScale = wobbleScale * wobbleScale
      local wobMult = lerp(0.4, 1.0, farT)
      local wobX = math.sin(st.humanWobbleT * C.HUMAN_WOBBLE_FREQ * 2 * math.pi) * C.HUMAN_WOBBLE_AMP * wobbleScale * wobMult
      local wobY = math.cos(st.humanWobbleT * C.HUMAN_WOBBLE_FREQ * 2 * math.pi * 1.13) * C.HUMAN_WOBBLE_AMP * wobbleScale * 0.75 * wobMult
      errorX = errorX + wobX
      errorY = errorY + wobY
    end
    if eMag < C.HUMAN_SETTLE_RANGE * 0.6 then
      st.humanResidualT = st.humanResidualT + dt
      local resScale = 1 - (eMag / (C.HUMAN_SETTLE_RANGE * 0.6))
      resScale = resScale * resScale
      local resX = n1(st.humanResidualT * C.HUMAN_RESIDUAL_FREQ, 201) * C.HUMAN_RESIDUAL_AMP * resScale
      local resY = n1(st.humanResidualT * C.HUMAN_RESIDUAL_FREQ * 0.87, 202) * C.HUMAN_RESIDUAL_AMP * resScale
      errorX = errorX + resX
      errorY = errorY + resY
    end
    eMag = vlen(errorX, errorY)
  end

  if C.ANTICIPATE_ENABLE and farT > 0.3 then
    local ax, ay = updateAnticipate(dt, errorX, errorY, eMag)
    errorX = errorX + ax * farT
    errorY = errorY + ay * farT
  end

  if farT > 0.4 then
    updateReturnPulse(dt, errorX, errorY)
  else
    st.recentHitTime = nil
    st.returnPauseTimer = 0
    st.returnPulseTimer = 0
  end
  updateSmartFlick(dt, cursor, errorX, errorY, eMag)
  if st.smartFlickActive and st.smartFlickHoldTimer > 0 then
    local parkErrX = st.smartFlickParkX - cursor.X
    local parkErrY = st.smartFlickParkY - cursor.Y
    local parkMag = vlen(parkErrX, parkErrY)
    if parkMag > 0.5 then
      errorX = parkErrX
      errorY = parkErrY
      eMag = parkMag
    end
  end
  local flickX, flickY = 0, 0
  if C.FLICK_ENABLE then
    if st.flickCooldown > 0 then st.flickCooldown = st.flickCooldown - dt end
    st.flickTimer = math.max(0, st.flickTimer - dt)
    if eMag > C.FLICK_ERR_MIN and st.flickCooldown <= 0 and reactRamp > 0.5
       and not anyFlickActive() and math.random() < C.FLICK_TRIGGER_CHANCE
       and st.userYankTimer <= 0 and st.userMoveInf < 0.20
       and nearT < 0.4 then
      if st.userPriority < C.USER_INPUT_FULL_STOP_THRESHOLD then
        local t = clamp((eMag - C.FLICK_ERR_MIN) / math.max(C.FLICK_ERR_FAR - C.FLICK_ERR_MIN, 1), 0, 1)
        t = t * t * (3 - 2 * t)
        local frac = C.FLICK_GAIN * (0.5 + 0.5 * t)
        st.flickDirX = errorX / eMag
        st.flickDirY = errorY / eMag
        st.flickMag = math.min(eMag * frac, C.FLICK_MAX_MAG)
        st.flickTimer = C.FLICK_RAMP
        st.flickCooldown = C.FLICK_COOLDOWN
        st.flickPhaseSeed = math.random() * 100
      end
    end
  end
  local pulseX, pulseY = 0, 0
  if C.PULSE_ENABLE then
    st.pulseTimerNext = st.pulseTimerNext - dt
    if st.pulseTimerNext <= 0 then
      local spd = st.mouseSpeedSmooth or 0
      if eMag > C.PULSE_MIN and eMag < C.PULSE_MAX and spd < 60 and nearT < 0.4 then
        st.pulseDirX = errorX / eMag
        st.pulseDirY = errorY / eMag
        if C.PULSE_DIR_WOBBLE > 0 then
          local perpX, perpY = -st.pulseDirY, st.pulseDirX
          local w = n1(st.noiseT * 8, 55) * C.PULSE_DIR_WOBBLE
          st.pulseDirX = st.pulseDirX + perpX * w
          st.pulseDirY = st.pulseDirY + perpY * w
          local m = math.sqrt(st.pulseDirX * st.pulseDirX + st.pulseDirY * st.pulseDirY)
          if m > 0.001 then st.pulseDirX = st.pulseDirX / m; st.pulseDirY = st.pulseDirY / m end
        end
        st.pulseMag = eMag * C.PULSE_GAIN * rRange(1 - C.PULSE_MAG_JITTER, 1 + C.PULSE_MAG_JITTER)
        st.pulseRampCurrent = C.PULSE_RAMP * rRange(1 - C.PULSE_RAMP_JITTER, 1 + C.PULSE_RAMP_JITTER)
        st.pulseSpeedMultCurrent = C.PULSE_SPEED_MULT * rRange(1 - C.PULSE_SPEED_MULT_JITTER, 1 + C.PULSE_SPEED_MULT_JITTER)
        st.pulseTimer = st.pulseRampCurrent
        st.pulseTimerNext = rRange(0.35, 0.75) / C.PULSE_FREQ
      else
        st.pulseTimerNext = rRange(0.15, 0.30)
      end
    end
    st.pulseTimer = math.max(0, st.pulseTimer - dt)
  end
  local totalRamp = reactRamp * acqEnv
  if totalRamp < 1.0 then
    errorX = errorX * totalRamp
    errorY = errorY * totalRamp
    eMag = vlen(errorX, errorY)
  end
  local liveOmegaBoost = 1.0
  if C.LIVE_TRACK_ENABLE then
    local tvX = st.predVelSmoothX or 0
    local tvZ = st.predVelSmoothZ or 0
    local tvMag = math.sqrt(tvX * tvX + tvZ * tvZ)
    if tvMag > 1.0 then
      local ndx, ndz = tvX / tvMag, tvZ / tvMag
      if st.lastTargetDirSet then
        local dot = ndx * st.lastTargetDirX + ndz * st.lastTargetDirZ
        if dot < C.LIVE_DIR_CHANGE_DOT then
          local sev = (C.LIVE_DIR_CHANGE_DOT - dot) / (C.LIVE_DIR_CHANGE_DOT + 1)
          st.liveDirBoost = math.max(st.liveDirBoost, sev)
        end
      end
    end
    st.liveDirBoost = math.max(0, st.liveDirBoost - dt / C.LIVE_DIR_CHANGE_TAU)
    liveOmegaBoost = 1 + st.liveDirBoost * (C.LIVE_DIR_CHANGE_BOOST - 1)
    local targetStill = (st.lastTargetVelMag or 0) < C.LIVE_STILL_TARGET_VEL
    local stillTarget = targetStill and 1 or 0
    st.liveStillFactor = expDecay(st.liveStillFactor, stillTarget, 0.15, dt)
    liveOmegaBoost = liveOmegaBoost * lerp(1.0, C.LIVE_DIR_STILL_OM, st.liveStillFactor)
  end
  st.speedModT = st.speedModT + dt
  local speedMod = 1 + n1(st.speedModT * C.SPRING_SPEED_MOD_FREQ, 300) * C.SPRING_SPEED_MOD_AMP
  local gaitMul = st.gaitMul or 1.0
  local pauseMul = st.microPauseScale or 1.0
  local targetSpeedBoost = 1.0
  if C.TARGET_SPEED_ADAPT_ENABLE then
    local tvMag = st.lastTargetVelMag or 0
    local t = clamp((tvMag - C.TARGET_SPEED_BOOST_MIN) / math.max(C.TARGET_SPEED_BOOST_MAX - C.TARGET_SPEED_BOOST_MIN, 1), 0, 1)
    targetSpeedBoost = 1 + t * C.TARGET_SPEED_BOOST_AMT
  end
  local proximityBoost = 1.0
  if C.PROXIMITY_ADAPT_ENABLE then
    local t = clamp(1 - (eMag / C.PROXIMITY_BOOST_RANGE), 0, 1)
    proximityBoost = 1 + t * C.PROXIMITY_BOOST_AMT
  end
  local totalBoost = liveOmegaBoost * speedMod * gaitMul * pauseMul * targetSpeedBoost * proximityBoost

  if C.ARRIVAL_DAMP_ENABLE and eMag < C.ARRIVAL_DAMP_RANGE then
    local arrT = 1 - (eMag / C.ARRIVAL_DAMP_RANGE)
    arrT = arrT * arrT * (3 - 2 * arrT)
    totalBoost = totalBoost * (1 - arrT * C.ARRIVAL_DAMP_STR)
  end

  totalBoost = math.min(totalBoost, C.TOTAL_BOOST_CAP)
  local baseOmega = (1 / C.SPRING_TAU) * totalBoost
  st.springOmega = expDecay(st.springOmega, baseOmega, C.SPRING_OMEGA_SMOOTH, dt)
  if st.springOmega < 0.01 then st.springOmega = 0.01 end
  local om = st.springOmega
  local k = om * om
  if C.CLOSE_SNAP_ENABLE and eMag < C.CLOSE_SNAP_RANGE and eMag > 0.1 then
    local tClose = 1 - (eMag / C.CLOSE_SNAP_RANGE)
    tClose = tClose * tClose * (3 - 2 * tClose)
    local kMult = 1 + (C.CLOSE_SNAP_K_MULT - 1) * tClose
    local omMult = 1 + (C.CLOSE_SNAP_OM_MULT - 1) * tClose
    k = k * kMult
    om = om * omMult
  end
  local settleT = clamp(1 - eMag / C.HUMAN_SETTLE_RANGE, 0, 1)
  settleT = settleT * settleT * (3 - 2 * settleT)
  st.phaseSettle = settleT
  local zetaBase
  if C.HUMANIZE_ENABLE then
    zetaBase = lerp(C.HUMAN_SETTLE_ZETA, C.HUMAN_MAINTAIN_ZETA, settleT)
  else
    zetaBase = C.SPRING_ZETA
  end
  st.zetaModT = st.zetaModT + dt
  local zetaMod = n1(st.zetaModT * C.SPRING_ZETA_MOD_FREQ, 301) * C.SPRING_ZETA_MOD_AMP
  zetaBase = zetaBase + zetaMod
  local zetaT = clamp(1 - eMag / C.CLOSE_ZETA_RANGE, 0, 1)
  zetaT = zetaT * zetaT * (3 - 2 * zetaT)
  local speedZetaBoost = 0
  if C.TARGET_SPEED_ADAPT_ENABLE then
    local tvZ = st.lastTargetVelMag or 0
    local tz = clamp((tvZ - C.TARGET_SPEED_BOOST_MIN) / math.max(C.TARGET_SPEED_BOOST_MAX - C.TARGET_SPEED_BOOST_MIN, 1), 0, 1)
    tz = tz * tz * (3 - 2 * tz)
    speedZetaBoost = tz * 0.18
  end
  local settleZetaBoost = nearT * 0.15
  local zetaTarget = zetaBase + C.CLOSE_ZETA_BOOST * zetaT + speedZetaBoost + settleZetaBoost
  st.zetaSmooth = expDecay(st.zetaSmooth, zetaTarget, C.ZETA_SMOOTH_TAU, dt)
  local c = 2 * om * st.zetaSmooth
  local vertOmegaMult = errorY < 0 and C.VERT_UP_OMEGA_MULT or C.VERT_DOWN_OMEGA_MULT
  local vertZetaMult = errorY < 0 and C.VERT_UP_ZETA_MULT or C.VERT_DOWN_ZETA_MULT
  local vertEaseMult = 1.0
  if C.VERT_EASE_ENABLE then
    local ay = math.abs(errorY)
    if ay >= C.VERT_EASE_FAR_DIST then vertEaseMult = C.VERT_EASE_FAR_MULT
    elseif ay <= C.VERT_EASE_NEAR_DIST then vertEaseMult = C.VERT_EASE_NEAR_MULT
    else
      local tMid = (ay - C.VERT_EASE_NEAR_DIST) / (C.VERT_EASE_FAR_DIST - C.VERT_EASE_NEAR_DIST)
      local midCurve = bell(tMid)
      vertEaseMult = lerp(C.VERT_EASE_NEAR_MULT, C.VERT_EASE_FAR_MULT, 1 - tMid)
      vertEaseMult = vertEaseMult + (C.VERT_EASE_MID_MULT - 1) * midCurve
    end
  end
  local settleVertMul = lerp(1.0, 0.85, nearT)
  local omY = om * vertOmegaMult * vertEaseMult * settleVertMul
  local kY = omY * omY
  local cY = 2 * omY * st.zetaSmooth * vertZetaMult
  local denomX = 1 + c * dt + k * dt * dt
  local denomY = 1 + cY * dt + kY * dt * dt
  st.springVX = (st.springVX + k * dt * errorX) / denomX
  st.springVY = (st.springVY + kY * dt * errorY) / denomY
  if C.ANTI_BOUNCE_ENABLE and eMag > 0.001 and eMag < C.ANTI_BOUNCE_RANGE then
    local vMag = vlen(st.springVX, st.springVY)
    if vMag > 0.001 then
      local dot = (st.springVX * errorX + st.springVY * errorY) / (vMag * eMag)
      if dot < C.ANTI_BOUNCE_DOT then
        local t = clamp(eMag / C.ANTI_BOUNCE_CLOSE_RANGE, 0, 1)
        t = t * t * (3 - 2 * t)
        local kill = lerp(C.ANTI_BOUNCE_CLOSE_KILL, C.ANTI_BOUNCE_KILL, t)
        local kxm = 1 - kill * C.ANTI_BOUNCE_X_MULT
        local kym = 1 - kill * C.ANTI_BOUNCE_Y_MULT
        if kxm < 0 then kxm = 0 end
        if kym < 0 then kym = 0 end
        st.springVX = st.springVX * kxm
        st.springVY = st.springVY * kym
        st.springVsX = st.springVsX * kxm
        st.springVsY = st.springVsY * kym
      end
    end
  end
  if manualCut > 0.01 then
    local vd = math.exp(-dt * C.CUT_VEL_DAMP_RATE * manualCut)
    st.springVX = st.springVX * vd
    st.springVY = st.springVY * vd
    st.springVsX = st.springVsX * vd
    st.springVsY = st.springVsY * vd
  end
  if not st.springVsInit then
    st.springVsX = st.springVX
    st.springVsY = st.springVY
    st.springVsInit = true
  end
  local dVX = st.springVX - st.springVsX
  local dVY = st.springVY - st.springVsY
  st.springVsX = st.springVsX + dVX
  st.springVsY = st.springVsY + dVY
  local emaA = 1 - math.exp(-dt / C.SPRING_VEL_SMOOTH_TAU)
  st.springVsX = st.springVsX + (st.springVX - st.springVsX) * emaA
  st.springVsY = st.springVsY + (st.springVY - st.springVsY) * emaA

  if C.FLICK_ENABLE and st.flickTimer > 0 then
    local ft = st.flickTimer / C.FLICK_RAMP
    local progress = 1 - ft
    local curve = flickCurve(progress)
    local wobbleAngle = math.sin(progress * math.rad(360) * 1.3 + st.flickPhaseSeed) * C.FLICK_WOBBLE_AMP
    local rx, ry = rotate2D(st.flickDirX, st.flickDirY, wobbleAngle)
    local flickSpeed = st.flickMag * C.FLICK_SPEED_MULT
    flickX = rx * flickSpeed * curve
    flickY = ry * flickSpeed * curve
  end
  if C.PULSE_ENABLE and st.pulseTimer > 0 then
    local ramp = st.pulseRampCurrent
    if ramp <= 0 then ramp = C.PULSE_RAMP end
    local pt = st.pulseTimer / ramp
    local x = 1 - pt
    local attackFrac = math.max(C.PULSE_ATTACK_FRAC, 0.05)
    local attack = clamp(x / attackFrac, 0, 1)
    attack = attack * attack * (3 - 2 * attack)
    local decayX = clamp((x - attackFrac) / (1 - attackFrac), 0, 1)
    local power = 1.6 + C.PULSE_CURVE_ASYM * 1.4
    local decay = (1 - decayX) ^ power
    local curve = attack * decay
    local pulseSpeedMult = st.pulseSpeedMultCurrent
    if pulseSpeedMult <= 0 then pulseSpeedMult = C.PULSE_SPEED_MULT end
    local pulseSpeed = st.pulseMag * pulseSpeedMult
    pulseX = st.pulseDirX * pulseSpeed * curve
    pulseY = st.pulseDirY * pulseSpeed * curve
  end
  local fx = st.springVsX * dt * C.SPRING_OUTPUT_GAIN
  local fy = st.springVsY * dt * C.SPRING_OUTPUT_GAIN
  fx = fx + (flickX + pulseX) * dt
  fy = fy + (flickY + pulseY) * dt
  if st.smartFlickTimer > 0 then
    local sft = st.smartFlickTimer / C.SMART_FLICK_FLICK_TIME
    local sProgress = 1 - sft
    local sCurve = flickCurve(sProgress)
    local curveMix = easeInOutCos(sProgress) * C.FLICK_CURVE_AMOUNT
    local curveDx = lerp(st.smlStartDirX, st.smlEndDirX, curveMix)
    local curveDy = lerp(st.smlStartDirY, st.smlEndDirY, curveMix)
    local cm = math.sqrt(curveDx * curveDx + curveDy * curveDy)
    if cm > 0.001 then curveDx, curveDy = curveDx / cm, curveDy / cm end
    local sWobbleAngle = math.sin(sProgress * math.rad(360) * 1.2 + st.smartFlickPhaseSeed) * C.SMART_FLICK_WOBBLE_AMP
    local srx, sry = rotate2D(curveDx, curveDy, sWobbleAngle)
    local sSpeed = st.smartFlickMag * C.SMART_FLICK_FLICK_SPEED
    fx = fx + srx * sSpeed * sCurve * dt
    fy = fy + sry * sSpeed * sCurve * dt
  end
  if st.smartFlickActive and st.smartFlickHoldTimer > 0 then
    fx = fx * C.SMART_FLICK_HOLD_SCALE
    fy = fy * C.SMART_FLICK_HOLD_SCALE
  end
  if st.returnPauseTimer > 0 then
    fx = fx * C.RETURN_PULSE_PAUSE_SCALE
    fy = fy * C.RETURN_PULSE_PAUSE_SCALE
  end
  if st.returnPulseTimer > 0 then
    local rDur = math.max(C.RETURN_PULSE_DURATION * 0.7, 0.001)
    local rProgress = 1 - (st.returnPulseTimer / rDur)
    local rcurve = bell(rProgress)
    local rSpeed = st.returnPulseMag * C.RETURN_PULSE_SPEED
    fx = fx + st.returnPulseDirX * rSpeed * rcurve * dt
    fy = fy + st.returnPulseDirY * rSpeed * rcurve * dt
  end
  if C.TP_DETECT and st.tpActive > 0.01 then
    local tpScale = 1 - st.tpActive * C.TP_ASSIST_REDUCE
    if tpScale < 0 then tpScale = 0 end
    fx = fx * tpScale
    fy = fy * tpScale
  end
  if manualCut > 0.001 then
    local outScale = 1 - manualCut * C.MANUAL_CUT_MAX
    fx = fx * outScale
    fy = fy * outScale
  end
  if eMag < C.IDLE_MICRO_TARGET_RANGE and eMag > 0.1 then
    st.idleMicroT = st.idleMicroT + dt
    local rangeT = 1 - (eMag / C.IDLE_MICRO_TARGET_RANGE)
    rangeT = rangeT * rangeT * (3 - 2 * rangeT)
    local fModX = 1 + n1(st.idleMicroT * C.IDLE_MICRO_FREQ_MOD_SPEED, 110) * C.IDLE_MICRO_FREQ_MOD_AMP
    local fModY = 1 + n1(st.idleMicroT * C.IDLE_MICRO_FREQ_MOD_SPEED, 111) * C.IDLE_MICRO_FREQ_MOD_AMP
    local aModX = 1 + n1(st.idleMicroT * C.IDLE_MICRO_AMP_MOD_SPEED, 112) * C.IDLE_MICRO_AMP_MOD_AMP
    local aModY = 1 + n1(st.idleMicroT * C.IDLE_MICRO_AMP_MOD_SPEED, 113) * C.IDLE_MICRO_AMP_MOD_AMP
    local mX = fbm1(st.idleMicroT * C.IDLE_MICRO_FREQ_BASE * fModX, 114, 3) * C.IDLE_MICRO_AMP * C.IDLE_MICRO_X_SCALE * rangeT * aModX
    local mY = fbm1(st.idleMicroT * C.IDLE_MICRO_FREQ_BASE * fModY, 115, 3) * C.IDLE_MICRO_AMP * rangeT * aModY
    fx = fx + mX * farT
    fy = fy + mY * farT
  end
  local tvMag = st.lastTargetVelMag or 0
  local microScale
  if tvMag < 0.6 then
    microScale = 0.0
  else
    local t = clamp((tvMag - 0.6) / math.max(C.STILL_VEL_THRESH - 0.6, 0.001), 0, 1)
    microScale = lerp(0.03, 1.0, t)
  end

  if C.MICRO_ADJUST_ENABLE and nearT > 0.15 then
    local madjT = nearT
    local gx = C.MICRO_ADJUST_GAIN_X * errorX * madjT * dt * 60
    local gy = C.MICRO_ADJUST_GAIN_Y * errorY * madjT * dt * 60
    st.smoothErrorX = expDecay(st.smoothErrorX, errorX, 0.10, dt)
    st.smoothErrorY = expDecay(st.smoothErrorY, errorY, 0.10, dt)
    fx = fx + gx * 0.03
    fy = fy + gy * 0.03
  end

  local mcX, mcY = updateMicroCorrect(dt, eMag)
  fx = fx + mcX * microScale
  fy = fy + mcY * microScale

  local hX, hY = updateHandShake(dt, eMag)
  fx = fx + hX * microScale
  fy = fy + hY * microScale

  local fTX, fTY = updateFatigue(dt, eMag)
  fx = fx + fTX * microScale * farT
  fy = fy + fTY * microScale * farT

  -- Overshoot solo si NO estamos cerca (eMag > OVERSHOOT_MIN_ERR)
  if eMag > C.OVERSHOOT_MIN_ERR then
    local oX, oY = updateOvershoot(dt, errorX, errorY, eMag)
    fx = fx + oX * farT
    fy = fy + oY * farT
  else
    st.prevErrorX = errorX
    st.prevErrorY = errorY
    st.prevErrorMag = eMag
  end

  local blinkScale = updateBlink(dt, eMag)
  if blinkScale < 1.0 then
    fx = fx * blinkScale
    fy = fy * blinkScale
  end

  local oscFarMul = lerp(0.22, 1.0, farT)
  local driftX, driftY = updateAimDrift(dt, eMag)
  fx = fx + driftX * microScale * oscFarMul
  fy = fy + driftY * microScale * oscFarMul
  local vMicro = updateVerticalMicro(dt, eMag, errorY)
  fy = fy + vMicro * microScale * oscFarMul
  local sX, sY = updateSaccades(dt, eMag)
  fx = fx + sX * microScale * oscFarMul
  fy = fy + sY * microScale * oscFarMul
  local tX, tY = updateTremor(dt, eMag)
  fx = fx + tX * microScale * oscFarMul
  fy = fy + tY * microScale * oscFarMul
  local dtx, dty = updateDoubleTap(dt, eMag)
  fx = fx + dtx * microScale * oscFarMul
  fy = fy + dty * microScale * oscFarMul

  local nv = st.noiseVar
  st.noiseT = st.noiseT + dt
  local noiseX = n1(st.noiseT * C.NOISE_SPEED_X * 10, 5) * C.NOISE_AMP_X * nv
  local noiseY = n1(st.noiseT * C.NOISE_SPEED_Y * 10, 6) * C.NOISE_AMP_Y * nv
  local jitterX = n1(st.noiseT * C.JITTER_FREQ, 40) * C.JITTER_AMP_X * nv
  local jitterY = n1(st.noiseT * C.JITTER_FREQ, 41) * C.JITTER_AMP_Y * nv
  local jScale = clamp(eMag / 12, 0.15, 1) * microScale
  jitterX = jitterX * jScale
  jitterY = jitterY * jScale
  fx = fx + noiseX + jitterX
  fy = fy + noiseY + jitterY
  if C.DEADZONE_ENABLE and eMag < C.DEADZONE_RADIUS then
    local t = eMag / math.max(C.DEADZONE_RADIUS, 0.001)
    local scale = t * t * (3 - 2 * t)
    scale = lerp(C.DEADZONE_MIN_SCALE, 1.0, scale)
    fx = fx * scale
    fy = fy * scale
  end
  if st.userMoveInf > 0.001 then
    local scale = lerp(1.0, C.USER_MOVE_SCALE, st.userMoveInf)
    scale = math.max(scale, C.USER_MOVE_MIN_INFLUENCE)
    fx = fx * scale
    fy = fy * scale
  end
  if st.userYankTimer > 0 then
    local yankScale = C.USER_YANK_SCALE
    fx = fx * yankScale
    fy = fy * yankScale
  end
  if C.SRC_ENABLE and st.gameEffectActive then
    local gameScale = clamp(1 - st.gameMag * 0.5, 0.3, 1.0)
    fx = fx * gameScale
    fy = fy * gameScale
  end
  if C.USER_INPUT_PRIORITY_ENABLE and st.userPriority > 0.01 then
    local priorityScale = lerp(1.0, C.USER_INPUT_PRIORITY_OVERRIDE, st.userPriority)
    fx = fx * priorityScale
    fy = fy * priorityScale
  end
  local fMag = vlen(fx, fy)
  if fMag > C.SPEED_SOFT_KNEE then
    local over = fMag - C.SPEED_SOFT_KNEE
    local range = math.max(C.SPEED_SOFT_CAP - C.SPEED_SOFT_KNEE, 1)
    local t = 1 - math.exp(-over / range)
    local reduction = 1 - t * C.SPEED_SOFT_STR
    fx = fx * reduction
    fy = fy * reduction
    fMag = vlen(fx, fy)
  end
  if fMag > C.SPEED_HARD_CAP then
    local s = C.SPEED_HARD_CAP / fMag
    fx = fx * s
    fy = fy * s
  end
  if C.VEL_ERROR_CAP_ENABLE and eMag > 0.001 then
    local capFactor = C.VEL_ERROR_CAP
    if eMag < C.ERRCAP_CLOSE_RANGE then capFactor = C.VEL_ERROR_CAP_CLOSE end
    local cap = eMag * capFactor + C.ERRCAP_MIN
    local capX = cap
    local capY = cap * C.VERT_VELCAP_MULT + 0.3
    local fMag2X = math.abs(fx)
    local fMag2Y = math.abs(fy)
    if fMag2X > capX then fx = fx * (capX / fMag2X) end
    if fMag2Y > capY then fy = fy * (capY / fMag2Y) end
  end
  if st.releaseSmooth > 0.001 then
    local mul = 1 - st.releaseSmooth
    fx = fx * mul
    fy = fy * mul
  end
  return fx, fy
end

local function handleLostTarget(dt)
  st.lostTimer = st.lostTimer + dt
  local decay = math.exp(-dt / C.LOST_DECAY_TAU)
  st.springVX = st.springVX * decay
  st.springVY = st.springVY * decay
  local extraDamp = math.exp(-dt * C.LOST_SPRING_DAMP)
  st.springVX = st.springVX * extraDamp
  st.springVY = st.springVY * extraDamp
  st.springVsX = st.springVsX * decay * extraDamp
  st.springVsY = st.springVsY * decay * extraDamp
  st.recoilOffsetY = 0
  st.tpActive = expDecay(st.tpActive, 0, C.TP_TAU, dt)
  if st.lostCoastTimer <= 0 and st.lostTimer < 0.02 then
    st.lostCoastTimer = C.LOST_COAST_TIME
    st.springVsX = st.springVsX * 1.10
    st.springVsY = st.springVsY * 1.10
  end
  if st.lostCoastTimer > 0 then
    st.lostCoastTimer = st.lostCoastTimer - dt
  end
  local fadeScale = st.lostFade
  fadeScale = fadeScale * fadeScale
  local fx = st.springVsX * dt * fadeScale
  local fy = st.springVsY * dt * fadeScale
  local relMag = math.sqrt(fx * fx + fy * fy)
  if relMag > C.RELEASE_MAX_PIXELS then
    local s = C.RELEASE_MAX_PIXELS / relMag
    fx = fx * s
    fy = fy * s
  end
  if st.lostTimer > C.LOST_CLEANUP_TIME then
    st.springVX = 0; st.springVY = 0
    st.springVsX = 0; st.springVsY = 0
    st.recoilOffsetY = 0
    st.hist = {}
    st.tpActive = 0
    st.predVelInit = false
    st.predBlend = 1.0
    st.predConfidence = 1.0
    st.predVelSmoothX = 0; st.predVelSmoothZ = 0
