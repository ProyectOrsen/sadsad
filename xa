end

local function rRange(a, b)
    return a + math.random() * (b - a)
end

local function clamp(v, l, h)
    return v < l and l or (v > h and h or v)
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function takeAccumulator(acc, step)
    if step <= 0 then
        return acc, 0
    end
    if math.abs(acc) < step then
        return 0, acc
    end
    local steps = math.floor(math.abs(acc) / step)
    local send = steps * step
    if acc < 0 then
        send = -send
    end
    return send, acc - send
end

local function sendMouseRelative(x, y)
    x = x * (C.MOUSE_OUTPUT_SCALE or 1.0)
    y = y * (C.MOUSE_OUTPUT_SCALE or 1.0)
    st.moveAccX = (st.moveAccX or 0) + x
    st.moveAccY = (st.moveAccY or 0) + y
    local minStep = C.MOUSE_MIN_STEP or 0.0
    local sendX, remX = takeAccumulator(st.moveAccX, minStep)
    local sendY, remY = takeAccumulator(st.moveAccY, minStep)
    st.moveAccX = remX
    st.moveAccY = remY
    if sendX ~= 0 or sendY ~= 0 then
        pcall(function()
            mousemoverel(sendX, sendY)
        end)
    end
    st.lastCmdX = sendX
    st.lastCmdY = sendY
end

local function createBlock(name, size, color, transparency, visible)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Transparency = visible and transparency or 1
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Anchored = true
    part.Color = color
    part.Parent = workspace
    return part
end

local function createBlocks()
    if C.AIM_BLOCK_ENABLE then
        if st.aimBlock then st.aimBlock:Destroy() end
        st.aimBlock = createBlock("AimBlock", C.AIM_BLOCK_SIZE, C.AIM_BLOCK_COLOR, C.AIM_BLOCK_TRANSPARENCY, C.SHOW_BLOCKS)
        st.aimBlockPos = camera.CFrame.Position + camera.CFrame.LookVector * 50
        st.aimBlock.CFrame = CFrame.new(st.aimBlockPos)
    end
    if C.PREDICT_BLOCK_ENABLE then
        if st.predictBlock then st.predictBlock:Destroy() end
        st.predictBlock = createBlock("PredictBlock", C.PREDICT_BLOCK_SIZE, C.PREDICT_BLOCK_COLOR, C.PREDICT_BLOCK_TRANSPARENCY, C.SHOW_BLOCKS)
        st.predictBlockPos = camera.CFrame.Position + camera.CFrame.LookVector * 50
        st.predictBlock.CFrame = CFrame.new(st.predictBlockPos)
    end
end

local function destroyBlocks()
    if st.aimBlock then st.aimBlock:Destroy(); st.aimBlock = nil end
    if st.predictBlock then st.predictBlock:Destroy(); st.predictBlock = nil end
    st.aimBlockPos = nil
    st.predictBlockPos = nil
end

local function raycastToPosition(from, to, wallStop)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {}
    if player.Character then table.insert(exclude, player.Character) end
    if st.targetChar then table.insert(exclude, st.targetChar) end
    if st.aimBlock then table.insert(exclude, st.aimBlock) end
    if st.predictBlock then table.insert(exclude, st.predictBlock) end
    rp.FilterDescendantsInstances = exclude
    local dir = to - from
    if dir.Magnitude < 0.001 then return to end
    local result = workspace:Raycast(from, dir, rp)
    if result then return result.Position + result.Normal * wallStop end
    return to
end

local function updateAimBlock(targetPos, dt)
    if not C.AIM_BLOCK_ENABLE or not st.aimBlock then return end
    if not st.aimBlockPos then
        st.aimBlockPos = targetPos
    else
        st.aimBlockPos = st.aimBlockPos:Lerp(targetPos, math.min(C.AIM_BLOCK_SMOOTH_SPEED * dt, 1))
    end
    local checkedPos = st.aimBlockPos
    if C.AIM_BLOCK_RAYCAST then
        checkedPos = raycastToPosition(camera.CFrame.Position, st.aimBlockPos, C.AIM_BLOCK_WALL_STOP)
    end
    st.aimBlock.CFrame = CFrame.new(checkedPos)
end

local function updatePredictBlock(predictPos, dt)
    if not C.PREDICT_BLOCK_ENABLE or not st.predictBlock then return end
    if not st.predictBlockPos then
        st.predictBlockPos = predictPos
    else
        st.predictBlockPos = st.predictBlockPos:Lerp(predictPos, math.min(C.PREDICT_BLOCK_SMOOTH_SPEED * dt, 1))
    end
    local checkedPos = st.predictBlockPos
    if C.PREDICT_BLOCK_RAYCAST then
        checkedPos = raycastToPosition(camera.CFrame.Position, st.predictBlockPos, C.PREDICT_BLOCK_WALL_STOP)
    end
    st.predictBlock.CFrame = CFrame.new(checkedPos)
end

