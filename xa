fy = fy + ry * isp * curve * axisMulY * dt
end
if st.airFlickTimer > 0 then
local prog = 1 - st.airFlickTimer / C.AIR_FLICK_TIME
local tri = prog < 0.35 and (prog / 0.35) or ((1 - prog) / 0.65)
