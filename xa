end
local function computeAimScreen(char, dt, cursor)
local world = computeAimWorld(char, dt, cursor)
if not world then return nil end
local vel = computeBlendedVelocity()
updatePredictability(vel, dt); updateVelocityInertia(vel, dt)
local predOffset = computePredictionOffset(vel, dt)
predOffset = applySurfacePrediction(predOffset)
local hm = math.sqrt(predOffset.X * predOffset.X + predOffset.Z * predOffset.Z)
local farT = smoothstep(C.PRED_FAR_START, C.PRED_FAR_END, st.targetWorldD or 0)
local hcap = math.min(lerp(C.PRED_BODY_CAP, C.PRED_BODY_CAP_FAR, farT), C.PRED_MAX)
if hm > hcap then
local s = hcap / hm
predOffset = Vector3.new(predOffset.X * s, predOffset.Y, predOffset.Z * s)
end
predOffset = Vector3.new(predOffset.X, clamp(predOffset.Y, -C.AIR_Y_MAX, C.AIR_Y_MAX), predOffset.Z)
local rrt = char:FindFirstChild("HumanoidRootPart")
if rrt then updatePredLearn(rrt.Position, predOffset) end
local finalWorld = world + predOffset
if C.AIM_VIS_CHECK_ENABLE and C.WALLCHECK then
local t = clock()
local vis, altPos = Vis.modelVisible(char, world, true)
if vis and altPos and altPos ~= world then
world = altPos
finalWorld = world + predOffset
st.aimFallbackPos = altPos
else
st.aimFallbackPos = nil
end
if vis and predOffset.Magnitude > 0.05 then
if not Vis.point(char, "fin", finalWorld, true) then
local half = world + predOffset * 0.5
if Vis.point(char, "fin2", half, true) then finalWorld = half else finalWorld = world end
end
end
if not vis then
if st.aimPointVisible then
st.aimPointVisible = false
st.aimPointNotVisibleSince = t
end
if (t - st.aimPointNotVisibleSince) > C.AIM_VIS_GRACE_TIME then return nil end
else
st.aimPointVisible = true
st.aimPointNotVisibleSince = 0
end
end
local sp = camera:WorldToViewportPoint(finalWorld)
if sp.Z <= 0 then return nil end
local bsp = camera:WorldToViewportPoint(world)
if bsp.Z > 0 then
local ox, oy = sp.X - bsp.X, sp.Y - bsp.Y
local om = vlen(ox, oy)
local pxcap = lerp(C.PRED_SCREEN_MAX_PX, C.PRED_SCREEN_MAX_FAR, smoothstep(C.PRED_FAR_START, C.PRED_FAR_END, st.targetWorldD or 0))
if om > pxcap then
local s = pxcap / om
sp = Vector3.new(bsp.X + ox * s, bsp.Y + oy * s, sp.Z)
end
end
st.aimWorldLast = finalWorld
st.lastVisWorld = finalWorld
st.lastVisVelX = st.predVelSmoothX or 0
st.lastVisVelZ = st.predVelSmoothZ or 0
st.hideT = 0
st.hiddenNow = false
local rawX = sp.X + st.spotX
local rawY = sp.Y + st.spotY
if st.acquireBlend < 1 then
st.acquireBlend = math.min(1, st.acquireBlend + dt / math.max(C.ACQUIRE_BLEND_TIME, 0.001))
local t = st.acquireBlend
t = t * t * (3 - 2 * t)
rawX = st.acquireBlendFromX + (rawX - st.acquireBlendFromX) * t
rawY = st.acquireBlendFromY + (rawY - st.acquireBlendFromY) * t
end
if st.switchBlend < 1 then
local dur = st.switchBlendDuration or C.SWITCH_BLEND_TIME
st.switchBlend = math.min(1, st.switchBlend + dt / math.max(dur, 0.001))
local t = st.switchBlend
t = t * t * (3 - 2 * t)
rawX = st.switchFromX + (rawX - st.switchFromX) * t
rawY = st.switchFromY + (rawY - st.switchFromY) * t
end
st.aimScreenX, st.aimScreenY = rawX, rawY
st.aimScreenInit = true
return st.aimScreenX, st.aimScreenY, vel
end
local function updateManualInfluence(dt)
local rawSpeed = vlen(st.mouseDeltaX, st.mouseDeltaY) / math.max(dt, C.MOUSE_DT_MIN)
