  local vp = camera.ViewportSize
  local cx = vp.X * 0.5 + C.CENTER_X
  local cy = vp.Y * 0.5 + C.CENTER_Y
  return vlen(rm.X - cx, rm.Y - cy) <= C.CENTER_REQUIRE_RADIUS
end

