end
local function getCandidates(cursor, fovR, currentChar, dt)
dt = dt or 0
local mc = player.Character; local mr = mc and mc:FindFirstChild("HumanoidRootPart")
if not mr then return {} end
local list, seen = {}, {}
local t = clock()
local function tryAdd(char, maxD, isCurrent)
if not char or not char.Parent or seen[char] then return end
local hum = char:FindFirstChildOfClass("Humanoid")
if not hum or hum.Health <= 0 then return end
if hum:GetState() == Enum.HumanoidStateType.Dead then return end
local root = char:FindFirstChild("HumanoidRootPart")
if not root then return end
local wd = (root.Position - mr.Position).Magnitude
if wd > maxD then return end
if isJudgeChar(char) and wd > C.RANGE_JUDGE then return end
-- FIX CLAUDE: usar solo partes visibles para el calculo del FOV
local bodyParts = visibleParts(char)
if #bodyParts == 0 then bodyParts = getBodyParts(char) end
local bestSd, bestSpos = math.huge, nil
for _, p in ipairs(bodyParts) do
local sp = camera:WorldToViewportPoint(p.Position)
if sp.Z > 0 then
local spos = Vector2.new(sp.X, sp.Y)
local sd = (spos - cursor).Magnitude
if sd < bestSd then bestSd = sd; bestSpos = spos end
end
end
if not bestSpos or bestSd > fovR then return end
local visTarget = getAimPoint(char, cursor, dt, false) or root.Position
local head = findPart(char, "Head")
local visible, altPos, trueVisible = true, nil, true
if hasFilter("Visible") then
visible, altPos = Vis.modelVisible(char, visTarget, isCurrent)
trueVisible = visible
if not visible and isCurrent and C.VIS_GRACE_TIME > 0 then
if t - (st.lastTargetVisibleTime or 0) < C.VIS_GRACE_TIME then visible = true end
end
end
if not visible and not isCurrent then return end
if hasFilter("Team") then
local plr = Players:GetPlayerFromCharacter(char)
if plr and plr.Team == player.Team then return end
end
if hasFilter("NPC") then
if Players:GetPlayerFromCharacter(char) ~= nil then return end
end
seen[char] = true
table.insert(list, {
head = head or root, char = char, spos = bestSpos, sd = bestSd, root = root, wd = wd,
isCurrent = isCurrent and true or false, visible = visible, trueVisible = trueVisible, altPos = altPos,
})
end
for _, p in Players:GetPlayers() do
if p ~= player then tryAdd(p.Character, C.RANGE_PLAYER, p.Character == currentChar) end
end
if C.AIM_NPC then for _, npc in ipairs(getNPCs()) do tryAdd(npc, C.RANGE_NPC, npc == currentChar) end end
local steer = st.steer or 0
local umx, umy = st.mouseDeltaX, st.mouseDeltaY
local um = vlen(umx, umy)
for _, cd in ipairs(list) do
local score = cd.sd - (cd.isCurrent and C.TARGET_KEEP_BONUS * (1 - steer) or 0)
if um > 0.5 and steer > 0 then
local dx, dy = cd.spos.X - cursor.X, cd.spos.Y - cursor.Y
local dm = vlen(dx, dy)
if dm > 1 then
local along = (dx * umx + dy * umy) / (dm * um)
score = score - along * C.SWITCH_INTENT_BONUS * steer
end
end
cd.score = score
end
table.sort(list, function(a, b) return a.score < b.score end)
return list
end
local function acquireTarget(chosen, wasExisting, isNearSwitch, cursor)
