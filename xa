local connR = RunService.RenderStepped:Connect(function(dt)
  camera = workspace.CurrentCamera or camera
  if not camera then return end

  updateRecoilAlways(dt)

  if not st.on or not player.Character then return end

  local rawDelta = UserInputService:GetMouseDelta()
  local rawX, rawY = rawDelta.X, rawDelta.Y
  local sentX = st.sentAccumX
  local sentY = st.sentAccumY
  local sentMag = st.lastBatchMag

  local userDX = rawX - sentX
  local userDY = rawY - sentY

  local thr = C.MOUSE_MIN_MAG
  if sentMag > 8 then
    local adaptive = sentMag * C.MOUSE_ADAPT_THR_MULT
    if adaptive > thr then thr = adaptive end
  end
  if thr > C.MOUSE_ADAPT_THR_MAX then thr = C.MOUSE_ADAPT_THR_MAX end

  if math.abs(userDX) < thr then userDX = 0 end
  if math.abs(userDY) < thr then userDY = 0 end

  local mag = math.sqrt(userDX * userDX + userDY * userDY)
  if mag < C.MOUSE_MIN_MAG then
    userDX = 0; userDY = 0
  elseif mag > C.MOUSE_MAX_MAG then
    local s = C.MOUSE_MAX_MAG / mag
    userDX = userDX * s
    userDY = userDY * s
  end

  st.mouseDeltaX = math.floor(userDX + 0.5)
  st.mouseDeltaY = math.floor(userDY + 0.5)
  st.mouseDX = st.mouseDeltaX
  st.mouseDY = st.mouseDeltaY

  local dtSafe = math.max(dt, C.MOUSE_DT_MIN)
  local rawSpeed = math.sqrt(userDX * userDX + userDY * userDY) / dtSafe
  if rawSpeed > C.MOUSE_SPEED_CAP then rawSpeed = C.MOUSE_SPEED_CAP end
  st.mouseSpeedRaw = rawSpeed
  st.mouseSpeedSmooth = expDecay(st.mouseSpeedSmooth, rawSpeed, C.MOUSE_SMOOTH_TAU, dt)

  st.lastSentX = sentX
  st.lastSentY = sentY

  if st.recoilCompX ~= 0 or st.recoilCompY ~= 0 then
    sendMouseRelative(st.recoilCompX, st.recoilCompY)
  end

  st.sentAccumX = 0
  st.sentAccumY = 0
  st.lastBatchMag = 0

  updateUserMove(dt)
  if st.holding then updateUserYank(dt) end

  if not st.holding then
    st.manualInf = 0
    st.manualDownInf = 0
    st.manualHoldTimer = 0
    st.cutSmooth = 0
    st.releaseSmooth = 0
    st.springVX = st.springVX * 0.6
    st.springVY = st.springVY * 0.6
    st.springVsX = st.springVsX * 0.6
    st.springVsY = st.springVsY * 0.6
    st.springVsInit = false
    st.predVelInit = false
    st.predBlend = 1.0
    st.predConfidence = 1.0
    st.aimSmoothWorld = nil
    st.acquireEnvT = 0
    st.acquireBlend = 1
    st.dirChangePending = false
    st.flickTimer = 0
    st.pulseTimer = 0
    st.reactDelayRolled = false
    st.tpActive = expDecay(st.tpActive, 0, C.TP_TAU, dt)
    st.microPauseHold = 0
    st.microPauseScale = 1.0
    st.returnPauseTimer = 0
    st.returnPulseTimer = 0
    st.recentHitTime = nil
    st.yankDetected = false
    st.lastTargetScreenInit = false
    st.smartFlickActive = false
    st.smartFlickTimer = 0
    st.smartFlickHoldTimer = 0
    st.smlScreenVelInit = false
    st.userYankTimer = 0
    st.userPriority = 0
    st.aimPointVisible = true
    st.aimPointNotVisibleSince = 0
    st.aimDynamicY = nil
    st.lostCoastTimer = 0
    st.prevErrorMag = nil
    st.overshootTimer = 0
    st.anticipateX = 0
    st.anticipateY = 0
    st.smoothErrorX = 0
    st.smoothErrorY = 0
    st.escapeIntent = 0
    st.escapeHoldTimer = 0
    return
  end

  if not isMouseAtCenter() then return end

  local cursor = getCursor()

  updateYankDetection(dt)
  updateStickyTimers(dt)
  selectTarget(cursor, dt)

  if not st.target or not st.targetChar or not st.targetChar.Parent then
    if st.lostFade > 0 then
      st.lostFade = expDecay(st.lostFade, 0, C.TAU_LOST, dt)
    end
    handleLostTarget(dt)
    return
  end
  local targetRoot = st.targetChar:FindFirstChild("HumanoidRootPart")
  if not targetRoot then
    handleLostTarget(dt)
    return
  end
  pushHistory(targetRoot.Position)
  if C.TP_DETECT then
    local curPos = targetRoot.Position
    if st.lastTargetPos then
      local jumpStuds = (curPos - st.lastTargetPos).Magnitude
      local velStuds = jumpStuds / math.max(dt, 0.001)
      if jumpStuds > C.TP_JUMP_STUDS or velStuds > C.TP_VEL_THRESH then
        st.tpActive = 1.0
        st.tpIgnoreTimer = math.max(st.tpIgnoreTimer, C.PRED_TP_RESET_TIME)
      end
    end
    st.lastTargetPos = curPos
    st.tpActive = expDecay(st.tpActive, 0, C.TP_TAU, dt)
  end
  st.lockAge = st.lockAge + dt

  updateSmartFlickScreenVel(dt)

  local aimX, aimY, targetVel = computeAimScreen(st.targetChar, dt, cursor)
  if not aimX then return end
  local fx, fy = solveMovement(cursor, aimX, aimY, dt, targetVel)
  sendMouseRelative(fx, fy)
end)

