fx = fx * scale
fy = fy * scale
end
do
local u = clamp(eMag / math.max(C.CLOSE_SOFT_RADIUS, 0.001), 0, 1)
u = u * u * (3 - 2 * u)
u = u ^ C.CLOSE_SOFT_POWER
