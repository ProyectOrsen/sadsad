local srx, sry = rotate2D(curveDx, curveDy, sWobbleAngle)
local sSpeed = st.smartFlickMag * C.SMART_FLICK_FLICK_SPEED
fx = fx + srx * sSpeed * sCurve * dt
fy = fy + sry * sSpeed * sCurve * dt
end
if st.smartFlickActive and st.smartFlickHoldTimer > 0 then
fx = fx * C.SMART_FLICK_HOLD_SCALE
fy = fy * C.SMART_FLICK_HOLD_SCALE
end
if st.returnPauseTimer > 0 then
fx = fx * C.RETURN_PULSE_PAUSE_SCALE
fy = fy * C.RETURN_PULSE_PAUSE_SCALE
end
if st.returnPulseTimer > 0 then
local rDur = math.max(C.RETURN_PULSE_DURATION * 0.7, 0.001)
local rProgress = 1 - (st.returnPulseTimer / rDur)
local rcurve = bell(rProgress)
local rSpeed = st.returnPulseMag * C.RETURN_PULSE_SPEED
fx = fx + st.returnPulseDirX * rSpeed * rcurve * dt
fy = fy + st.returnPulseDirY * rSpeed * rcurve * dt
end
if C.TP_DETECT and st.tpActive > 0.01 then
local tpScale = 1 - st.tpActive * C.TP_ASSIST_REDUCE
if tpScale < 0 then tpScale = 0 end
fx = fx * tpScale
fy = fy * tpScale
end
if manualCut > 0.001 then
local outScale = 1 - manualCut * C.MANUAL_CUT_MAX
fx = fx * outScale
fy = fy * outScale
end
if eMag < C.IDLE_MICRO_TARGET_RANGE and eMag > 0.1 then
st.idleMicroT = st.idleMicroT + dt
local rangeT = 1 - (eMag / C.IDLE_MICRO_TARGET_RANGE)
rangeT = rangeT * rangeT * (3 - 2 * rangeT)
local fModX = 1 + n1(st.idleMicroT * C.IDLE_MICRO_FREQ_MOD_SPEED, 110) * C.IDLE_MICRO_FREQ_MOD_AMP
local fModY = 1 + n1(st.idleMicroT * C.IDLE_MICRO_FREQ_MOD_SPEED, 111) * C.IDLE_MICRO_FREQ_MOD_AMP
local aModX = 1 + n1(st.idleMicroT * C.IDLE_MICRO_AMP_MOD_SPEED, 112) * C.IDLE_MICRO_AMP_MOD_AMP
local aModY = 1 + n1(st.idleMicroT * C.IDLE_MICRO_AMP_MOD_SPEED, 113) * C.IDLE_MICRO_AMP_MOD_AMP
local mX = fbm1(st.idleMicroT * C.IDLE_MICRO_FREQ_BASE * fModX, 114, 3) * C.IDLE_MICRO_AMP * C.IDLE_MICRO_X_SCALE * rangeT * aModX
local mY = fbm1(st.idleMicroT * C.IDLE_MICRO_FREQ_BASE * fModY, 115, 3) * C.IDLE_MICRO_AMP * rangeT * aModY
fx = fx + mX; fy = fy + mY
end
