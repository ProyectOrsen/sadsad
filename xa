local partsCache = setmetatable({}, {__mode = "k"})
local PARTS_CACHE_TTL = 0.8
local function getBodyParts(char)
if not char then return {} end
local t = clock()
local c = partsCache[char]
if c and (t - c.t) < PARTS_CACHE_TTL then
local ok = true
for i = 1, #c.parts do
if not c.parts[i].Parent then ok = false break end
end
if ok then return c.parts end
end
local parts = {}
for _, p in ipairs(char:GetChildren()) do
if p:IsA("BasePart") and BODY_PART_NAMES[p.Name] then
table.insert(parts, p)
end
end
partsCache[char] = {t = t, parts = parts}
return parts
end
local _perm = {}
for i = 0, 255 do _perm[i] = i end
for i = 255, 1, -1 do local j = RNG:NextInteger(0, i); _perm[i], _perm[j] = _perm[j], _perm[i] end
for i = 0, 256 do _perm[256 + i] = _perm[i] end
local function _fade(t) return t * t * t * (t * (t * 6 - 15) + 10) end
local function _grad(h, x) return (h % 2 == 0) and x or -x end
local function perlin1d(x)
local xi = math.floor(x) % 256; local xf = x - math.floor(x); local u = _fade(xf)
return _grad(_perm[xi], xf) + u * (_grad(_perm[xi + 1], xf - 1) - _grad(_perm[xi], xf))
end
local function n1(t, seed) return perlin1d(t + seed * 37.13) end
local function fbm1(t, seed, octaves)
octaves = octaves or 3
local sum, amp, freq, norm = 0, 1, 1, 0
for i = 1, octaves do
sum = sum + n1(t * freq, seed + i * 7.3) * amp
norm = norm + amp; amp = amp * 0.55; freq = freq * 2.13
end
return sum / norm
end
