local botY = root.Position.Y + C.AIM_FOOT_OFFSET_Y
if commit then s.noiseT = s.noiseT + dt end
local vary = fbm1(s.noiseT * C.AIM_VARY_FREQ, 400 + s.seed, 2) * C.AIM_VARY_AMP
local lo = C.AIM_CENTER_T - C.AIM_BAND_HALF
local hi = C.AIM_CENTER_T + C.AIM_BAND_HALF
local center = clamp(C.AIM_CENTER_T + s.acqBias + vary, lo, hi)
local t = center
if cursor then
local px, pz = root.Position.X, root.Position.Z
local topS = camera:WorldToViewportPoint(Vector3.new(px, topY, pz))
local botS = camera:WorldToViewportPoint(Vector3.new(px, botY, pz))
local midS = camera:WorldToViewportPoint(Vector3.new(px, (topY + botY) * 0.5, pz))
if topS.Z > 0 and botS.Z > 0 and midS.Z > 0 then
local span = botS.Y - topS.Y
if math.abs(span) >= 1 then
local dxC, dyC = cursor.X - midS.X, cursor.Y - midS.Y
local proxRadius = math.max(math.abs(span) * C.AIM_PROX_RADIUS_MULT, C.AIM_PROX_RADIUS_MIN)
local proxT = clamp(1 - math.sqrt(dxC * dxC + dyC * dyC) / proxRadius, 0, 1)
proxT = proxT * proxT * (3 - 2 * proxT)
local rawT = clamp((cursor.Y - topS.Y) / span, 0, 1)
rawT = rawT ^ (1 + (1 - C.AIM_HEIGHT_CURVE_BIAS) * 0.5)
local follow = proxT * C.AIM_FOLLOW_CURSOR
t = lerp(center, clamp(rawT, C.AIM_HEAD_T, hi + 0.12), follow)
end
end
end
local targetY = lerp(topY, botY, t)
if commit then st.aimDynamicY = targetY end
return targetY
end
