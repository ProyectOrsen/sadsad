-- ===== NUEVO: detecta si el usuario está jalando FUERTE en dirección contraria al aim =====
-- Devuelve 0..1 (0 = no escape, 1 = escape fuerte)
local function computeUserEscapeIntent()
  local userSpd = st.mouseSpeedSmooth or 0
  if userSpd < C.USER_ESCAPE_MIN_SPEED then return 0 end

  local ux = st.mouseDeltaX or 0
  local uy = st.mouseDeltaY or 0
  local uMag = vlen(ux, uy)
  if uMag < 1 then return 0 end
  ux, uy = ux / uMag, uy / uMag

  -- Dirección del aim: hacia dónde está jalando el aim (spring velocity)
  local aimMag = vlen(st.springVsX or 0, st.springVsY or 0)
  local ax, ay
  if aimMag > 0.5 then
    ax, ay = (st.springVsX or 0) / aimMag, (st.springVsY or 0) / aimMag
  else
    -- fallback: usar dirección de la pantalla hacia el punto de aim
    if st.aimScreenInit and camera then
      local vp = camera.ViewportSize
      local dx = st.aimScreenX - (vp.X * 0.5 + C.CENTER_X)
      local dy = st.aimScreenY - (vp.Y * 0.5 + C.CENTER_Y)
      local dm = vlen(dx, dy)
      if dm > 1 then
        ax, ay = dx / dm, dy / dm
      else
        return 0
      end
    else
      return 0
    end
  end

  -- dot negativo = usuario jalando en dirección OPUESTA al aim
  local dot = ux * ax + uy * ay
  if dot > C.USER_ESCAPE_DOT_THRESH then return 0 end

  -- intensidad: más opuesto y más rápido = más fuerte
  local intensity = (-dot) * math.min(userSpd / C.USER_ESCAPE_MIN_SPEED, 2.0)
  return clamp(intensity, 0, 1)
end

local function updateHitboxZone(dt)
  st.hitboxOffsetTimer = st.hitboxOffsetTimer - dt
  if st.hitboxOffsetTimer <= 0 then
    local s = 0.55
    local r = C.HITBOX_SUBZONE_RATIO
    st.hitboxOffsetTarget = Vector3.new(
      rRange(-s * r, s * r), rRange(-s * r, s * r), rRange(-s * r, s * r)
    )
    st.hitboxOffsetTimer = rRange(C.HITBOX_SUBZONE_CHANGE_MIN, C.HITBOX_SUBZONE_CHANGE_MAX)
  end
  local a = 1 - math.exp(-dt / C.HITBOX_SUBZONE_TAU)
  st.hitboxOffset = st.hitboxOffset + (st.hitboxOffsetTarget - st.hitboxOffset) * a
end

local function sendMouseRelative(x, y)
  x = x * C.MOUSE_SCALE
  y = y * C.MOUSE_SCALE
  st.accumX = st.accumX + x
  st.accumY = st.accumY + y
  local ix = st.accumX >= 0 and math.floor(st.accumX + 0.5) or math.ceil(st.accumX - 0.5)
  local iy = st.accumY >= 0 and math.floor(st.accumY + 0.5) or math.ceil(st.accumY - 0.5)
  if ix ~= 0 or iy ~= 0 then
    st.accumX = st.accumX - ix
    st.accumY = st.accumY - iy
    pcall(function() mousemoverel(ix, iy) end)
    st.sentAccumX = st.sentAccumX + ix
    st.sentAccumY = st.sentAccumY + iy
    local m = math.sqrt(ix * ix + iy * iy)
    if m > st.lastBatchMag then st.lastBatchMag = m end
    st.lastSendTime = tick()
    st.lastSentY = iy
  else
    st.lastSentY = 0
  end
end

local function updateRecoilAlways(dt)
  if not C.RECOIL_ENABLE then
    st.recoilActive = false
    st.recoilCompY = 0
    st.recoilCompX = 0
    return 0, 0
  end
  local isFiring = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
  local manualFire = st.m1
  if isFiring or manualFire then
    st.recoilHoldTimer = C.RECOIL_HOLD_MAX
    st.recoilActive = true
    st.recoilShotsThisBurst = st.recoilShotsThisBurst + 1
    st.recoilBurstTimer = 0.15
  else
    if st.recoilBurstTimer > 0 then
      st.recoilBurstTimer = st.recoilBurstTimer - dt
    else
      st.recoilShotsThisBurst = 0
    end
    if st.recoilHoldTimer > 0 then
      st.recoilHoldTimer = st.recoilHoldTimer - dt
    else
      st.recoilActive = false
    end
  end
  if not st.recoilActive then
    st.recoilCompY = expDecay(st.recoilCompY, 0, C.RECOIL_DECAY_TAU, dt)
    st.recoilCompX = expDecay(st.recoilCompX, 0, C.RECOIL_DECAY_TAU, dt)
    return 0, 0
  end
  local compY = 0
  local compX = 0
  if C.RECOIL_USE_FIXED_MOUSEREL then
    compY = C.RECOIL_FIXED_Y * C.RECOIL_STRENGTH_VERT
    compX = C.RECOIL_FIXED_X * C.RECOIL_STRENGTH_HORZ
  elseif C.RECOIL_USE_CAM_DELTA and camera then
    local cf = camera.CFrame
    local look = cf.LookVector
    local pitch = math.asin(clamp(look.Y, -1, 1))
    local yaw = math.atan2(look.X, look.Z)
    if st.recoilPrevCamPitch and st.recoilPrevCamYaw then
      local dPitch = pitch - st.recoilPrevCamPitch
      local dYaw = yaw - st.recoilPrevCamYaw
      if dYaw > math.pi then dYaw = dYaw - 2 * math.pi end
      if dYaw < -math.pi then dYaw = dYaw + 2 * math.pi end
      local ourPitchContrib = (st.lastSentY or 0) * st.recoilSensPitch
      local ourYawContrib = (st.sentAccumX or 0) * st.recoilSensYaw
      local recoilDPitch = dPitch - ourPitchContrib
      local recoilDYaw = dYaw - ourYawContrib
      if math.abs(recoilDPitch) > C.RECOIL_CAM_DELTA_MIN and math.abs(recoilDPitch) < C.RECOIL_CAM_DELTA_MAX then
        st.recoilAccumPitch = st.recoilAccumPitch + recoilDPitch
      end
      if math.abs(recoilDYaw) > C.RECOIL_CAM_DELTA_MIN and math.abs(recoilDYaw) < C.RECOIL_CAM_DELTA_MAX then
        st.recoilAccumYaw = st.recoilAccumYaw + recoilDYaw
      end
      st.recoilAccumPitch = expDecay(st.recoilAccumPitch, 0, C.RECOIL_CAM_SMOOTH_TAU, dt)
      st.recoilAccumYaw = expDecay(st.recoilAccumYaw, 0, C.RECOIL_CAM_SMOOTH_TAU, dt)
    end
    st.recoilPrevCamPitch = pitch
    st.recoilPrevCamYaw = yaw
    compY = st.recoilAccumPitch * C.RECOIL_CAM_PITCH_GAIN * C.RECOIL_STRENGTH_VERT
    compX = st.recoilAccumYaw * C.RECOIL_CAM_YAW_GAIN * C.RECOIL_STRENGTH_HORZ
    local pixelPerDegree = C.RECOIL_PIXEL_PER_FRAME * 60
    compY = compY * pixelPerDegree
    compX = compX * pixelPerDegree
  end
  compY = compY * (1 + st.recoilShotsThisBurst * C.RECOIL_RAMP_UP)
  compX = compX * (1 + st.recoilShotsThisBurst * C.RECOIL_RAMP_UP)
  compY = clamp(compY, -C.RECOIL_MAX_COMP, C.RECOIL_MAX_COMP)
  compX = clamp(compX, -C.RECOIL_MAX_COMP, C.RECOIL_MAX_COMP)
  st.recoilCompY = compY * C.RECOIL_MOUSEREL_MULT
  st.recoilCompX = compX * C.RECOIL_MOUSEREL_MULT
  return st.recoilCompX, st.recoilCompY
end

local function measureHitThickness(result, rayDir)
  local inst = result.Instance
  if not inst or not inst:IsA("BasePart") then return math.huge end
  if not inst.CanCollide then return 0 end
  if inst.Transparency >= C.WALL_TRANSP_MIN then return 0 end
  local rp = RaycastParams.new()
  rp.FilterType = Enum.RaycastFilterType.Include
  rp.FilterDescendantsInstances = {inst}
  rp.IgnoreWater = true
  local exit = workspace:Raycast(result.Position + rayDir * 0.001, rayDir * 50, rp)
  if not exit then return math.huge end
  return (exit.Position - result.Position).Magnitude
end

local function canSeeNative(targetPos, model)
  if not camera then return true end
  local ignore = {camera}
  if player.Character then table.insert(ignore, player.Character) end
  if model then table.insert(ignore, model) end
  local parts = camera:GetPartsObscuringTarget({targetPos}, ignore)
  for _, p in ipairs(parts) do
    if p:IsA("BasePart") then
      local canBypass = false
      if C.WALL_PASS_TRANSP and p.Transparency >= C.WALL_TRANSP_MIN then canBypass = true end
      if not canBypass and C.WALL_PASS_NONCOLLIDE and not p.CanCollide then canBypass = true end
      if not canBypass then return false end
    end
  end
  return true
end

local function canSeeManual(targetPos, model, noCache)
  if not C.WALLCHECK then return true end
  if not targetPos or not model then return true end
  local now = tick()
  if not noCache then
    local c = st.visCache[model]
    if c and now - c.t < C.WALL_CACHE_TTL then
      if c.pos and (targetPos - c.pos).Magnitude < C.WALL_CACHE_POS_EPS then
        return c.r
      end
    end
  end
  local origin = camera.CFrame.Position
  local delta = targetPos - origin
  local dist = delta.Magnitude
  if dist < 0.01 then return true end
  local dir = delta / dist
  local ex = {model}
  if player.Character then table.insert(ex, player.Character) end
  local rp = RaycastParams.new()
  rp.FilterType = Enum.RaycastFilterType.Exclude
  rp.FilterDescendantsInstances = ex
  rp.IgnoreWater = true
  local pos = origin
  local remaining = dist
  local bypass = 0
  local visible = false
  for _ = 1, C.WALL_MAX_BYPASS + 1 do
    if remaining <= 0.01 then break end
    local result = workspace:Raycast(pos, dir * remaining, rp)
    if not result then visible = true; break end
    if result.Instance and result.Instance:IsDescendantOf(model) then
      visible = true; break
    end
    if (result.Position - targetPos).Magnitude < C.VIS_TARGET_RADIUS then
      visible = true; break
    end
    local canBypass = false
    local inst = result.Instance
    if inst and inst:IsA("BasePart") then
      if C.WALL_PASS_TRANSP and inst.Transparency >= C.WALL_TRANSP_MIN then canBypass = true end
      if not canBypass and C.WALL_PASS_NONCOLLIDE and not inst.CanCollide then canBypass = true end
      if not canBypass and C.WALL_PASS_THIN then
        local thick = measureHitThickness(result, dir)
        if thick <= C.WALL_THIN_MAX_THICK then canBypass = true end
      end
    end
    if canBypass and bypass < C.WALL_MAX_BYPASS then
      bypass = bypass + 1
      local advance = (result.Position - pos).Magnitude + C.WALL_STEP
      remaining = remaining - advance
      pos = result.Position + dir * C.WALL_STEP
    else
      visible = false
      break
    end
  end
  if not noCache then
    st.visCache[model] = {t = now, r = visible, pos = targetPos}
  end
  return visible
end

local function canSee(targetPos, model, noCache)
  if not C.WALLCHECK then return true end
  if not targetPos or not model then return true end
  if C.WALL_USE_NATIVE_API then
    local visible = canSeeNative(targetPos, model)
    if visible then return true end
    if C.WALL_PASS_THIN then return canSeeManual(targetPos, model, noCache) end
    return false
  end
  return canSeeManual(targetPos, model, noCache)
end

local function findFolders(root, path, i)
  if i > #path then return {root} end
  local found = {}
  for _, c in ipairs(root:GetChildren()) do
    if c.Name == path[i] and (c:IsA("Folder") or c:IsA("Model")) then
      for _, s in ipairs(findFolders(c, path, i + 1)) do
        table.insert(found, s)
      end
    end
  end
  return found
end

local function getNPCs()
  local now = tick()
  if now - st.npcCacheT > C.NPC_CACHE then
    local result, seen = {}, {}
    for _, path in ipairs(C.NPC_PATHS) do
      for _, folder in ipairs(findFolders(workspace, path, 1)) do
        for _, child in ipairs(folder:GetChildren()) do
          local h = child:FindFirstChildOfClass("Humanoid")
          if h and h.Health > 0 and not seen[child] then
            seen[child] = true
            table.insert(result, child)
          end
        end
      end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
      if obj:IsA("Model") and not seen[obj] then
        local h = obj:FindFirstChildOfClass("Humanoid")
        local isPlayer = false
        for _, p in Players:GetPlayers() do
          if p.Character == obj then isPlayer = true; break end
        end
        if h and h.Health > 0 and not isPlayer then
          seen[obj] = true
          table.insert(result, obj)
        end
      end
    end
    st.npcCache = result
    st.npcCacheT = now
  end
  return st.npcCache
end

local function updateAimRegion(dt)
  st.aimRegionTimer = st.aimRegionTimer - dt
  if st.aimRegionTimer <= 0 then
    st.aimRegionTimer = C.AIM_REGION_SWITCH + rRange(-C.AIM_REGION_SWITCH_J, C.AIM_REGION_SWITCH_J)
    st.aimRegionIndex = math.random(1, C.AIM_REGION_COUNT)
  end
end

local function getRegionT()
  local idx = st.aimRegionIndex
  local baseT = (idx - 1) / math.max(C.AIM_REGION_COUNT - 1, 1)
  local jitter = (math.random() - 0.5) * C.AIM_REGION_JITTER
  return clamp(baseT + jitter, 0, 1)
end

local function updateLateralAim(dt, char)
  if not C.AIM_LATERAL_ENABLE then return 0 end
  local root = char:FindFirstChild("HumanoidRootPart")
  if not root then return 0 end
  local leftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftArm")
  local rightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm") or char:FindFirstChild("RightArm")
  local width = 2.0
  if leftArm and rightArm then
    width = (rightArm.Position - leftArm.Position).Magnitude
  end
  st.aimLateralTimer = st.aimLateralTimer - dt
  if st.aimLateralTimer <= 0 then
    st.aimLateralTimer = rRange(0.8, 2.0)
    local amp = width * C.AIM_LATERAL_AMP
    local newTarget = rRange(-amp, amp)
    if math.abs(newTarget - st.aimLateralTarget) > C.AIM_LATERAL_HYST then
      st.aimLateralTarget = newTarget
    end
  end
  st.aimLateralX = expDecay(st.aimLateralX, st.aimLateralTarget, C.AIM_LATERAL_TAU, dt)
  return st.aimLateralX
end

local function computeDynamicAimY(char, cursor, dt)
  dt = dt or 0
  local head = char:FindFirstChild("Head")
  local root = char:FindFirstChild("HumanoidRootPart")
  if not root then return nil end
  local isR6 = char:FindFirstChild("Torso") ~= nil and char:FindFirstChild("UpperTorso") == nil
  local topY, botY
  if isR6 then
    local torso = char:FindFirstChild("Torso")
    local leftLeg  = char:FindFirstChild("Left Leg")  or char:FindFirstChild("LeftLeg")
    local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLeg")
    if torso then
      topY = torso.Position.Y + torso.Size.Y * 0.5 + C.AIM_HEAD_OFFSET_Y
    else
      topY = (head and head.Position.Y or root.Position.Y + 2.0) + C.AIM_HEAD_OFFSET_Y
    end
    if leftLeg and rightLeg then
      local avgLegY  = (leftLeg.Position.Y + rightLeg.Position.Y) * 0.5
      local legSize  = (leftLeg.Size.Y + rightLeg.Size.Y) * 0.5
      botY = avgLegY - legSize * 0.5 - 0.25
    else
      botY = root.Position.Y - 2.0
    end
  else
    topY = (head and head.Position.Y or root.Position.Y + 2.0) + C.AIM_HEAD_OFFSET_Y
    botY = root.Position.Y - 2.4
  end
  if botY >= topY then botY = topY - 1.0 end
  local topScreen = camera:WorldToViewportPoint(Vector3.new(root.Position.X, topY, root.Position.Z))
  local botScreen = camera:WorldToViewportPoint(Vector3.new(root.Position.X, botY, root.Position.Z))
  if topScreen.Z <= 0 or botScreen.Z <= 0 then
    return root.Position.Y + C.AIM_ROOT_OFFSET_Y
  end
  local span = botScreen.Y - topScreen.Y
  if math.abs(span) < 1 then return root.Position.Y + C.AIM_ROOT_OFFSET_Y end
  local rawT = clamp((cursor.Y - topScreen.Y) / span, 0, 1)
  local cursorInsideBody = cursor.Y >= topScreen.Y - 15 and cursor.Y <= botScreen.Y + 15
  local finalT
  if cursorInsideBody then
    finalT = rawT
  else
    local regionT = getRegionT()
    finalT = lerp(regionT, rawT, 0.5)
  end
  finalT = finalT ^ (1 + (1 - C.AIM_HEIGHT_CURVE_BIAS) * 0.20)
  local targetY = lerp(topY, botY, finalT)
  if not st.aimDynamicY then
    st.aimDynamicY = targetY
  else
    local a = 1 - math.exp(-dt / math.max(C.AIM_HEIGHT_SMOOTH_TAU, 0.001))
    st.aimDynamicY = st.aimDynamicY + (targetY - st.aimDynamicY) * a
  end
  return st.aimDynamicY
end

local function getAimPoint(char, cursor, dt)
  dt = dt or 0
  updateAimRegion(dt)
  if C.AIM_POINT_MODE == "Dynamic" then
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local y = computeDynamicAimY(char, cursor, dt)
    if not y then return nil end
    local lateral = updateLateralAim(dt, char)
    return Vector3.new(root.Position.X + lateral, y, root.Position.Z)
  elseif C.AIM_POINT_MODE == "Head" then
    local p = char:FindFirstChild("Head")
    if p and p:IsA("BasePart") then return p.Position + Vector3.new(0, C.AIM_HEAD_OFFSET_Y, 0) end
    return nil
  elseif C.AIM_POINT_MODE == "UpperTorso" then
    local up = char:FindFirstChild("UpperTorso")
    if up and up:IsA("BasePart") then return up.Position end
    local torso = char:FindFirstChild("Torso")
    if torso and torso:IsA("BasePart") then return torso.Position end
    return nil
  elseif C.AIM_POINT_MODE == "Torso" then
    local torso = char:FindFirstChild("Torso")
    if torso and torso:IsA("BasePart") then return torso.Position end
    local up = char:FindFirstChild("UpperTorso")
    if up and up:IsA("BasePart") then return up.Position end
    return nil
  elseif C.AIM_POINT_MODE == "RootOffset" then
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then return nil end
    return root.Position + Vector3.new(0, C.AIM_ROOT_OFFSET_Y, 0)
  end
  return nil
end

local function computeThreatScore(char, mr)
  if not C.TARGET_THREAT_ENABLE then return 0 end
  local root = char:FindFirstChild("HumanoidRootPart")
  if not root or not mr then return 0 end
  local toMe = (mr.Position - root.Position).Unit
  local charLook = root.CFrame.LookVector
  local dot = toMe:Dot(charLook)
  local angle = math.deg(math.acos(clamp(dot, -1, 1)))
  if angle > C.TARGET_THREAT_ANGLE then return 0 end
  return (1 - angle / C.TARGET_THREAT_ANGLE) * C.TARGET_THREAT_BONUS
end

local function computeHealthScore(char)
  if not C.TARGET_HEALTH_ENABLE then return 0 end
  local hum = char:FindFirstChildOfClass("Humanoid")
  if not hum then return 0 end
  local hpFrac = hum.Health / math.max(hum.MaxHealth, 1)
  return (1 - hpFrac) * C.TARGET_HEALTH_BONUS
end

local function getCandidates(cursor, fovR, currentChar, dt)
  dt = dt or 0
  local mc = player.Character
  local mr = mc and mc:FindFirstChild("HumanoidRootPart")
  if not mr then return {} end
  local list, seen = {}, {}
  local now = tick()
  local function tryAdd(char, maxD, isCurrent)
    if not char or not char.Parent or seen[char] then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local wd = (root.Position - mr.Position).Magnitude
    if wd > maxD then return end
    if isJudgeChar(char) and wd > C.RANGE_JUDGE then return end
    local bodyParts = getBodyParts(char)
    if #bodyParts == 0 then return end
    local bestSd, bestSpos = math.huge, nil
    for _, p in ipairs(bodyParts) do
      local sp = camera:WorldToViewportPoint(p.Position)
      if sp.Z > 0 then
        local spos = Vector2.new(sp.X, sp.Y)
        local sd = (spos - cursor).Magnitude
        if sd < bestSd then bestSd = sd; bestSpos = spos end
      end
    end
    if not bestSpos or bestSd > fovR then return end
    local visTarget = getAimPoint(char, cursor, dt)
    if not visTarget then visTarget = root.Position end
    local head = findPart(char, "Head")
    local visible = true
    if hasFilter("Visible") then
      local visCheckPos = visTarget
      local visPart = char:FindFirstChild("Head") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
      if visPart then visCheckPos = visPart.Position end
      visible = canSee(visCheckPos, char, false)
      if not visible and isCurrent and C.VIS_GRACE_TIME > 0 then
        local sinceVis = now - (st.lastTargetVisibleTime or 0)
        if sinceVis < C.VIS_GRACE_TIME then visible = true end
      end
    end
    if not visible and not isCurrent then return end
    if hasFilter("Team") then
      local plr = Players:GetPlayerFromCharacter(char)
      if plr and plr.Team == player.Team then return end
    end
    if hasFilter("NPC") then
      if Players:GetPlayerFromCharacter(char) ~= nil then return end
    end
    local threatScore = computeThreatScore(char, mr)
    local healthScore = computeHealthScore(char)
    local distScore = bestSd * C.TARGET_DIST_WEIGHT
    local totalScore = distScore - threatScore - healthScore
    if isCurrent then totalScore = totalScore - C.TARGET_KEEP_BONUS end
    if not visible then totalScore = totalScore + 5000 end
    seen[char] = true
    table.insert(list, {
      head = head or root, char = char, spos = bestSpos, sd = bestSd,
      root = root, wd = wd, isCurrent = isCurrent and true or false,
      visible = visible, score = totalScore
    })
  end
  for _, p in Players:GetPlayers() do
    if p ~= player then tryAdd(p.Character, C.RANGE_PLAYER, p.Character == currentChar) end
  end
  if C.AIM_NPC then
    for _, npc in ipairs(getNPCs()) do tryAdd(npc, C.RANGE_NPC, npc == currentChar) end
  end
  table.sort(list, function(a, b) return a.score < b.score end)
  return list
end

