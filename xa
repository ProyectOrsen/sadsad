local function buildHudMessages()
local msgs = {}
local mouseS = st.mouseSpeedSmooth or 0
local mouseR = st.mouseSpeedRaw or 0
local moving = mouseS > C.MANUAL_DEADZONE
if st.target and st.targetChar and st.targetChar.Parent then
local name = st.targetChar.Name
if #name > 12 then name = string.sub(name, 1, 12) end
local dist = math.floor(st.targetWorldD or 0)
local part = st.aimPointName or "?"
local vis = st.aimPointVisible and "" or (st.hiddenNow and " [FADE]" or " [BLOCKED]")
local fb = st.aimFallbackPos and " [ALT]" or ""
local tp = st.tpActive > 0.05 and string.format(" [TP%.0f%%]", st.tpActive * 100) or ""
local yk = st.userYankTimer > 0 and " [YANK]" or ""
local um = st.userMoveInf > 0.10 and string.format(" [UM%d%%]", math.floor(st.userMoveInf * 100)) or ""
local it = st.intentFactor > 0.1 and string.format(" [INT%d%%]", math.floor(st.intentFactor * 100)) or ""
table.insert(msgs, string.format("LOCK %s %dst PART:%s%s%s%s%s%s%s", name, dist, part, vis, fb, tp, yk, um, it))
elseif st.lostFade > 0.02 then
table.insert(msgs, string.format("FADE  %.2f", st.lostFade))
else
table.insert(msgs, "IDLE")
end
table.insert(msgs, string.format("GATE %s  MOUSE %s raw=%.0f sm=%.0f", st.gateOpen and "ON" or "OFF", moving and "MOV" or "STL", mouseR, mouseS))
table.insert(msgs, string.format("SRC user=%.0f aim=%.0f game=%.2f lat=%d g=%.2f/%.2f pl=%.2f",
mouseR, st.srcAimSpeed or 0, st.srcGameRate or 0, Sep.lat or 1, Sep.gx or 1, Sep.gy or 1, st.predLearn or 1))
local rd = st.reactDelayCurrent or 0.07
local reactPct = math.floor(clamp(st.lockAge / math.max(rd, 0.001), 0, 1) * 100)
table.insert(msgs, string.format("REACT %.0fms %d%% BLEND %d%%", rd * 1000, reactPct, math.floor((st.acquireBlend or 1) * 100)))
table.insert(msgs, string.format("OMEGA=%.0f ZETA=%.2f v=(%.0f,%.0f)",
st.springOmega or 0, st.zetaSmooth or 0, st.springVsX or 0, st.springVsY or 0))
local tvMag = st.lastTargetVelMag or 0
table.insert(msgs, string.format("tV=%.1f conf=%.2f  MODE=%s", tvMag, st.predConfidence or 1.0, C.AIM_POINT_MODE))
return msgs
end
