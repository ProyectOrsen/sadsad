local function findTarget(cursor, dt)
    local c = getCandidates(cursor, C.FOV)
    if #c > 0 then
        st.inTrail = false
        st.trailTimer = 0
        local best = c[1]
        local chosen = best
        if st.target then
            local current = nil
            for _, v in ipairs(c) do
                if v.head == st.target then
                    current = v
                    break
                end
            end
            if current then
                if current.head ~= best.head then
                    local clearlyBetter =
                        best.sd < current.sd - C.SWITCH_MARGIN_PX and
                        best.sd < current.sd * C.SWITCH_BETTER_MULT
                    if not clearlyBetter then
                        chosen = current
                    end
                else
                    chosen = current
                end
            end
        end
        if st.target ~= chosen.head then
            local wasExisting = st.target ~= nil
            st.target = chosen.head
            st.targetChar = chosen.char
            st.targetSpos = chosen.spos
            if wasExisting then
                softResetOnSwitch()
            else
                resetOnNew()
            end
        else
            st.targetSpos = chosen.spos
        end
        st.lostFadeActive = false
        return st.target, st.targetSpos, false
    end

    local cBig = getCandidates(cursor, C.FOV_DETECT)
    if #cBig > 0 then
        local currentBig = nil
        if st.target then
            for _, v in ipairs(cBig) do
                if v.head == st.target then
                    currentBig = v
                    break
                end
            end
        end
        if currentBig then
            st.trailTimer = C.TRAIL_HOLD_TIME or 0.65
            st.inTrail = true
            st.lostFadeActive = false
            st.targetSpos = currentBig.spos
            return st.target, st.targetSpos, true
        elseif not st.inTrail and not st.target then
            st.target = cBig[1].head
            st.targetChar = cBig[1].char
            st.targetSpos = cBig[1].spos
            resetOnNew()
            st.trailTimer = C.TRAIL_HOLD_TIME or 0.65
            st.inTrail = true
            return st.target, st.targetSpos, true
        end
    end

    if st.inTrail and st.trailTimer > 0 then
        st.trailTimer = st.trailTimer - dt
        if st.trailTimer <= 0 then
            st.inTrail = false
            if st.target then
                st.lostFadeActive = true
                st.lostFadeTimer = 0
            end
            st.target = nil
            st.targetChar = nil
            st.lockTime = nil
            return nil, nil, false
        end
        return st.target, st.targetSpos, true
    end

    if st.target then
        st.lostFadeActive = true
        st.lostFadeTimer = 0
    end
    st.target = nil
    st.targetChar = nil
    st.lockTime = nil
    st.inTrail = false
    return nil, nil, false
end

local function getVel()
    if #st.history < 2 then
        return Vector3.zero
    end
    local tv = Vector3.zero
    local tw = 0
    for i = 2, #st.history do
        local a = st.history[i - 1]
        local b = st.history[i]
        local w = i / #st.history
        tv = tv + (b.pos - a.pos) / math.max(b.t - a.t, 0.001) * w
        tw = tw + w
    end
    if tw <= 0 then
        return Vector3.zero
    end
    return tv / tw
end

