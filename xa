local function updateSupportY(dt, char, rootPart)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local rawAirborne = hum and hum.FloorMaterial == Enum.Material.Air or false

    if rawAirborne then
        st.airborneRawTimer = st.airborneRawTimer + dt
    else
        st.airborneRawTimer = 0
    end

    local wasConfirmed = st.wasAirborneConfirmed
    local isAirborne = st.airborneRawTimer >= C.AIRBORNE_CONFIRM_TIME
    st.wasAirborneConfirmed = isAirborne

    if isAirborne then
        st.frozenSupportYSet = false
        return rootPart.Position.Y, true
    else
        if wasConfirmed then
            st.landingWindow = C.LANDING_WINDOW_TIME
            st.justLanded = true
        end

        st.landingWindow = math.max(st.landingWindow - dt, 0)
        st.frozenSupportYSet = false

        return rootPart.Position.Y, false
    end
end

local function getAimWorldPos(char, dt, manualDownFactor, isJudge)
    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")

    if not head or not root then
        return nil
    end

    st.aimBiasCD = st.aimBiasCD - dt

    if st.aimBiasCD <= 0 then
        local maxB = isJudge and math.min(C.AIM_BIAS_MAX, C.JUDGE_MAX_BIAS) or C.AIM_BIAS_MAX
        st.aimBiasTarget = rRange(C.AIM_BIAS_MIN, maxB)
        st.aimBiasCD = rRange(C.AIM_BIAS_CHANGE_MIN, C.AIM_BIAS_CHANGE_MAX)
    end

    st.aimBias = st.aimBias + (st.aimBiasTarget - st.aimBias) * math.min(C.AIM_BIAS_LERP * 60 * dt, 1)

    local upVec = root.CFrame.UpVector
    local uprightness = clamp(upVec.Y, 0, 1)
    local bias = st.aimBias

    if uprightness < 0.6 then
        bias = lerp(bias, 0.35, 1 - uprightness)
    end

    bias = lerp(bias, C.SUPPORT_BIAS_MIN, manualDownFactor)

    if isJudge then
        bias = math.min(bias, C.JUDGE_MAX_BIAS)
    end

    local rootY = root.Position.Y
    local supportY, isAirborne = updateSupportY(dt, char, root)

    if isAirborne then
        bias = bias * C.AIRBORNE_BIAS_REDUCE
    end

    if not st.supportFrozenSet and not isAirborne then
        st.supportFrozenY = rootY
        st.supportFrozenSet = true
    end

    if isAirborne and st.supportFrozenSet then
        local maxDrop = C.SUPPORT_MAX_DROP_STUDS or 12.0
        local limitY = st.supportFrozenY - maxDrop

        if rootY < limitY then
            supportY = limitY
        else
            supportY = rootY
        end

        if uprightness < 0.45 then
            bias = bias * (C.SUPPORT_TILTED_REDUCE or 0.45)
        end
    else
        st.supportFrozenY = rootY
    end

    local yOffset = (head.Position.Y - rootY) * bias
    local useY = supportY + yOffset

    local x = lerp(root.Position.X, head.Position.X, bias)
    local z = lerp(root.Position.Z, head.Position.Z, bias)

    return Vector3.new(x, useY, z), isAirborne
end

local function canSeePart(part, char)
    if not C.WALLCHECK then
        return true
    end

    local now = tick()
    local cached = st.visCache[part]

    if cached and cached.time and now - cached.time < 0.08 then
        return cached.result
    end

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude

    local exclude = {char}
    if player.Character then
        table.insert(exclude, player.Character)
    end

    rp.FilterDescendantsInstances = exclude

    local origin = camera.CFrame.Position
    local dir = part.Position - origin

    if dir.Magnitude < 0.001 then
        st.visCache[part] = {time = now, result = true}
        return true
    end

    local result = workspace:Raycast(origin, dir, rp)
    local visible = false

    if not result then
        visible = true
    elseif result.Instance:IsDescendantOf(char) then
        visible = true
    elseif (result.Position - part.Position).Magnitude < 0.35 then
        visible = true
    end

    st.visCache[part] = {time = now, result = visible}
    return visible
end

local function getAimSpotOffset(partName, dt)
    if not C.AIM_SPOT_ENABLE then
        return Vector2.new(0, 0)
    end

    st.aimSpotChangeTimer = st.aimSpotChangeTimer - dt
    if st.aimSpotChangeTimer <= 0 then
        st.aimSpotChangeTimer = rRange(C.AIM_SPOT_CHANGE_TIME_MIN, C.AIM_SPOT_CHANGE_TIME_MAX)

        local rangeX, rangeY
        if partName == "Head" or partName == "HeadCollider" then
            rangeX = C.AIM_SPOT_HEAD_RANGE
            rangeY = C.AIM_SPOT_HEAD_RANGE
        elseif partName == "Torso" then
            rangeX = C.AIM_SPOT_TORSO_RANGE
            rangeY = C.AIM_SPOT_TORSO_RANGE
        elseif string.find(partName, "Arm") or string.find(partName, "Hand") then
            rangeX = C.AIM_SPOT_ARM_RANGE
            rangeY = C.AIM_SPOT_ARM_RANGE
        else
            rangeX = 0.3
            rangeY = 0.3
        end

        st.aimSpotTarget = Vector2.new(
            rRange(-rangeX, rangeX),
            rRange(-rangeY, rangeY)
        )
    end

    st.aimSpotNoiseTime = st.aimSpotNoiseTime + dt * C.AIM_SPOT_NOISE_SPEED
    local noiseX = perlin1d(st.aimSpotNoiseTime) * C.AIM_SPOT_NOISE_AMP
    local noiseY = perlin1d(st.aimSpotNoiseTime + 47.3) * C.AIM_SPOT_NOISE_AMP

    st.aimSpotOffset = st.aimSpotOffset + (st.aimSpotTarget - st.aimSpotOffset) * math.min(C.AIM_SPOT_SMOOTH * 60 * dt, 1)

    return st.aimSpotOffset + Vector2.new(noiseX, noiseY)
end

local function getDynamicAimWorldPos(char, dt, manualDownFactor, isJudge)
    if not C.DYNAMIC_AIM_ENABLE then
        return getAimWorldPos(char, dt, manualDownFactor, isJudge)
    end

    local fallback, air = getAimWorldPos(char, dt, manualDownFactor, isJudge)
    if not fallback then
        return nil
    end

    st.partNoiseTime = st.partNoiseTime + dt * C.PART_NOISE_SPEED
    st.partVariationCD = st.partVariationCD - dt

    if st.partVariationCD <= 0 then
        st.forcePartVariation = true
        st.partVariationCD = rRange(C.PART_VARIATION_MIN, C.PART_VARIATION_MAX)
    end

    local cursor = getAimCursor()
    local bestPart = nil
    local bestScore = math.huge
    local speed = mv.smoothSpeed

    for idx, partName in ipairs(C.AIM_PART_NAMES) do
        local part = char:FindFirstChild(partName)

        if part and canSeePart(part, char) then
            local sp = camera:WorldToViewportPoint(part.Position)

            if sp.Z > 0 then
                local dx = sp.X - cursor.X
                local dy = sp.Y - cursor.Y
                local dist = math.sqrt(dx * dx + dy * dy)

                local headB = C.HEAD_PRIORITY_BONUS
                local armB = C.ARM_PRIORITY_BONUS
                local torsoB = C.TORSO_PRIORITY_BONUS

                if air then
                    headB = headB * 0.75
                    torsoB = torsoB + 1
                end

                if speed > C.MOTION_RUN * 0.75 then
                    headB = headB * 0.80
                    torsoB = torsoB + 1
                end

                if mv.motionClass == "strafe" then
                    headB = headB * 0.85
                    armB = armB + 1.5
                end

                if speed < C.HEAD_LOCK_MAX_SPEED then
                    headB = headB + 2
                end

                local bonus = 0
                local n = part.Name

                if n == "Head" or n == "HeadCollider" then
                    bonus = headB
                elseif n:find("Arm") or n:find("Hand") then
                    bonus = armB
                elseif n == "Torso" or n:find("Torso") then
                    bonus = torsoB
                end

                local noise = perlin1d(st.partNoiseTime + idx * 19.7) * C.PART_NOISE_AMP
                local score = dist - bonus + noise

                if st.aimPartName == n then
                    if st.forcePartVariation then
                        score = score + C.PART_VARIATION_SCORE
                    else
                        score = score - C.AIM_PART_STICKY
                    end
                end

                if score < bestScore then
                    bestScore = score
                    bestPart = part
                end
            end
        end
    end

    if not bestPart then
        return fallback, air
    end

    local oldPart = st.aimPartName
    st.aimPartName = bestPart.Name

    if st.forcePartVariation then
        st.forcePartVariation = false
    end

    local spotOffset = getAimSpotOffset(bestPart.Name, dt)
    local right = camera.CFrame.RightVector
    local up = camera.CFrame.UpVector
    local spotOffsetWorld = right * spotOffset.X + up * spotOffset.Y

    local targetPos = bestPart.Position + spotOffsetWorld

    if not st.dynamicAimInit then
        st.dynamicAimPos = targetPos
        st.dynamicAimInit = true
    else
        local alpha = C.AIM_PART_LERP

        if oldPart ~= bestPart.Name then
            alpha = math.min(0.92, alpha * 1.5)
        end

        st.dynamicAimPos = st.dynamicAimPos:Lerp(
            targetPos,
            math.min(alpha * 60 * dt, 1)
        )
    end

    return st.dynamicAimPos, air
end

local function getSilhouette(char)
    if not char then
        return nil
    end

    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")

    if not head or not root then
        return nil
    end

    local topV3 = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6 + C.BODY_TOP_EXTRA, 0))
    local botV3 = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.2 + C.BODY_BOT_EXTRA, 0))

    if topV3.Z <= 0 or botV3.Z <= 0 then
        return nil
    end

    local sideW = root.Position + camera.CFrame.RightVector * (C.BODY_WIDTH_STUDS * 0.5)
    local sideSp = camera:WorldToViewportPoint(sideW)
    local ctrSp = camera:WorldToViewportPoint(root.Position)

    local wPx = math.max(
        (Vector2.new(sideSp.X, sideSp.Y) - Vector2.new(ctrSp.X, ctrSp.Y)).Magnitude,
        10
    )

    return {
        top = Vector2.new(topV3.X, topV3.Y),
        bot = Vector2.new(botV3.X, botV3.Y),
        hw = wPx + C.BODY_MARGIN_PX,
    }
end

local function checkBody(cursor, sil)
    if not sil then
        return false, cursor, 0
    end

    local seg = sil.bot - sil.top
    local lenSq = seg.X * seg.X + seg.Y * seg.Y
    local t = 0

    if lenSq > 0.001 then
        t = clamp(
            ((cursor.X - sil.top.X) * seg.X + (cursor.Y - sil.top.Y) * seg.Y) / lenSq,
            0,
            1
        )
    end

    local cl = Vector2.new(sil.top.X + seg.X * t, sil.top.Y + seg.Y * t)
    local dist = (cursor - cl).Magnitude

    return dist <= sil.hw, cl, math.max(dist - sil.hw, 0)
end

local function findFolders(root, path, i)
    if i > #path then
        return {root}
    end

    local found = {}

    for _, c in ipairs(root:GetChildren()) do
        if c.Name == path[i] and (c:IsA("Folder") or c:IsA("Model")) then
            for _, s2 in ipairs(findFolders(c, path, i + 1)) do
                table.insert(found, s2)
            end
        end
    end

    return found
end

local function getNPCs()
    local now = tick()

    if now - st.npcCacheTime > C.NPC_CACHE_TIME then
        local result = {}
        local seen = {}

        for _, path in ipairs(C.NPC_PATHS or {}) do
            for _, folder in ipairs(findFolders(workspace, path, 1)) do
                for _, child in ipairs(folder:GetChildren()) do
                    local h = child:FindFirstChildOfClass("Humanoid")

                    if h and h.Health > 0 and not seen[child] then
                        seen[child] = true
                        table.insert(result, child)
                    end
                end
            end
        end

        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and not seen[obj] then
                local h = obj:FindFirstChildOfClass("Humanoid")
                local isPlayer = false

                for _, p in Players:GetPlayers() do
                    if p.Character == obj then
                        isPlayer = true
                        break
                    end
                end

                if h and h.Health > 0 and not isPlayer then
                    seen[obj] = true
                    table.insert(result, obj)
                end
            end
        end

        st.npcCache = result
        st.npcCacheTime = now
    end

    return st.npcCache
end

local function getCandidates(cursor, fovR)
    local mc = player.Character
    local mr = mc and mc:FindFirstChild("HumanoidRootPart")

    if not mr then
        return {}
    end

    local list = {}

    local function tryAdd(char, maxD)
        if not char then
            return
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            return
        end

        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")

        if not head or not root then
            return
        end

        local worldD = (root.Position - mr.Position).Magnitude
        if worldD > maxD then
            return
        end

        if isJudgeChar(char) and worldD > C.JUDGE_MAX_DIST then
            return
        end

        local spV3 = camera:WorldToViewportPoint(head.Position)
        if spV3.Z <= 0 then
            return
        end

        local spos = Vector2.new(spV3.X, spV3.Y)
        local sd = (spos - cursor).Magnitude

        if sd > (fovR or C.FOV) then
            return
        end

        if not canSee(head, char) then
            return
        end

        table.insert(list, {
            head = head,
            char = char,
            spos = spos,
            sd = sd,
            root = root,
        })
    end

    for _, p in Players:GetPlayers() do
        if p ~= player and not isFriend(p) then
            tryAdd(p.Character, C.MAX_DIST)
        end
    end

    if C.AIM_NPC then
        for _, npc in ipairs(getNPCs()) do
            tryAdd(npc, C.MAX_DIST_NPC)
        end
    end

    table.sort(list, function(a, b)
        return a.sd < b.sd
    end)

    return list
end

