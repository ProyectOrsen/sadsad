local sft = st.smartFlickTimer / C.SMART_FLICK_FLICK_TIME
local sProgress = 1 - sft
local sCurve = bell(sProgress)
local curveMix = easeInOutCos(sProgress) * C.FLICK_CURVE_AMOUNT
local curveDx = lerp(st.smlStartDirX, st.smlEndDirX, curveMix)
local curveDy = lerp(st.smlStartDirY, st.smlEndDirY, curveMix)
local cm = math.sqrt(curveDx * curveDx + curveDy * curveDy)
if cm > 0.001 then curveDx, curveDy = curveDx / cm, curveDy / cm end
