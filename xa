local ddx, ddy = tx - st.outX, ty - st.outY
local dm = vlen(ddx, ddy)
if dm > maxD and dm > 0 then
local s = maxD / dm
tx = st.outX + ddx * s
ty = st.outY + ddy * s
end
st.outX, st.outY = tx, ty
return tx, ty
end
local function handleLostTarget(dt)
st.lostTimer = st.lostTimer + dt
local decay = math.exp(-dt / C.LOST_DECAY_TAU)
st.springVX = st.springVX * decay; st.springVY = st.springVY * decay
