end
end)
local function coastBlocked(dt)
st.lostTimer = 0
st.hiddenNow = true
st.hideT = st.hideT + dt
if st.lastVisWorld ~= nil and st.hideT <= C.HIDE_KEEP_TIME then
local w = math.exp(-st.hideT / C.HIDE_FADE_TAU)
local ex = math.min(st.hideT, C.HIDE_EXTRAP_MAX) * 0.8
local wp = st.lastVisWorld + Vector3.new(st.lastVisVelX, 0, st.lastVisVelZ) * ex
local sp = camera:WorldToViewportPoint(wp)
if sp.Z > 0 then
st.aimWorldLast = wp
local fx, fy = solveMovement(getCursor(), sp.X, sp.Y, dt, nil)
sendMouseRelative(fx * w, fy * w)
return
end
end
local decay = math.exp(-dt / C.LOST_DECAY_TAU)
st.outX, st.outY = st.outX * decay, st.outY * decay
st.springVX = st.springVX * decay; st.springVY = st.springVY * decay
st.springVsX = st.springVsX * decay; st.springVsY = st.springVsY * decay
local fx, fy = st.springVsX * dt, st.springVsY * dt
local m = vlen(fx, fy)
if m > C.RELEASE_MAX_PIXELS then
local s = C.RELEASE_MAX_PIXELS / m
fx, fy = fx * s, fy * s
end
if math.abs(fx) > 0.001 or math.abs(fy) > 0.001 then sendMouseRelative(fx, fy) end
if st.hideT > C.HIDE_KEEP_TIME + 0.25 then dropTarget() end
end
local function step(dt)
if MY.dead then return end
camera = workspace.CurrentCamera or camera
if not camera then return end
Src.update(dt)
if not st.on or not player.Character then return end
Vis.beginFrame()
updateUserMove(dt)
if st.holding then updateUserYank(dt) end
if MY.notis == false then
hudGui.Enabled = false
else
hudGui.Enabled = true
hudState.lastUpdate = hudState.lastUpdate + dt
if hudState.lastUpdate > 0.05 then
hudState.lastUpdate = 0
hudLabel.Text = table.concat(buildHudMessages(), "\n")
if st.target and st.targetChar and st.targetChar.Parent and st.aimPointVisible then
hudStroke.Color = Color3.fromRGB(80, 255, 140)
elseif st.target and not st.aimPointVisible then
hudStroke.Color = Color3.fromRGB(255, 120, 120)
elseif st.lostFade > 0.02 then
hudStroke.Color = Color3.fromRGB(255, 200, 60)
else
hudStroke.Color = Color3.fromRGB(120, 140, 180)
end
for _, e in ipairs(hudVals) do
e.label.Text = string.format(e.var.fmt, e.var.get())
end
end
end
if C.AUTO and not st.holding then beginHold() end
st.gateOpen = aimGateOpen()
if not st.holding or not st.gateOpen then
releaseAll(dt)
return
end
local cursor = getCursor()
updateYankDetection(dt)
updateStickyTimers(dt)
selectTarget(cursor, dt)
if not st.target or not st.targetChar or not st.targetChar.Parent then
if st.lostFade > 0 then st.lostFade = expDecay(st.lostFade, 0, C.TAU_LOST, dt) end
handleLostTarget(dt); return
end
local targetRoot = st.targetChar:FindFirstChild("HumanoidRootPart")
if not targetRoot then handleLostTarget(dt); return end
pushHistory(targetRoot.Position)
if C.TP_DETECT then
local curPos = targetRoot.Position
if st.lastTargetPos then
local jumpStuds = (curPos - st.lastTargetPos).Magnitude
local velStuds = jumpStuds / math.max(dt, 0.001)
if jumpStuds > C.TP_JUMP_STUDS or velStuds > C.TP_VEL_THRESH then
st.tpActive = 1.0
st.tpIgnoreTimer = math.max(st.tpIgnoreTimer, C.PRED_TP_RESET_TIME)
end
end
st.lastTargetPos = curPos
st.tpActive = expDecay(st.tpActive, 0, C.TP_TAU, dt)
end
st.lockAge = st.lockAge + dt
updateSmartFlickScreenVel(dt)
local aimX, aimY, targetVel = computeAimScreen(st.targetChar, dt, cursor)
if not aimX then coastBlocked(dt); return end
local fx, fy = solveMovement(cursor, aimX, aimY, dt, targetVel)
sendMouseRelative(fx, fy)
end
rerollAll()
local bound = pcall(function()
RunService:BindToRenderStep("AA_Main", Enum.RenderPriority.Last.Value, step)
end)
if bound then
MY.unbind = function() pcall(function() RunService:UnbindFromRenderStep("AA_Main") end) end
else
table.insert(MY.conns, RunService.RenderStepped:Connect(step))
end
