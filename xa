local function buildHudMessages()
  local msgs = {}
  local mouseS = st.mouseSpeedSmooth or 0
  local mouseR = st.mouseSpeedRaw or 0
  local moving = mouseS > C.MANUAL_DEADZONE

  if st.target and st.targetChar and st.targetChar.Parent then
    local name = st.targetChar.Name
    if #name > 12 then name = string.sub(name, 1, 12) end
    local dist = math.floor(st.targetWorldD or 0)
    local part = st.aimPointName or (st.aimPointPart and st.aimPointPart.name) or "Root"
    local occ = st.occluded and " [OCCL]" or ""
    local tp = st.tpActive > 0.05 and string.format(" [TP%.0f%%]", st.tpActive * 100) or ""
    local pulseTxt = st.pulseTimer > 0 and " [PLS]" or ""
    local retTxt = ""
    if st.returnPauseTimer > 0 then retTxt = " [RT-PAUSE]"
    elseif st.returnPulseTimer > 0 then retTxt = " [RT-PULSE]" end
    local gaitTxt = string.format(" [G%.2f]", st.gaitMul or 1.0)
    local pauseTxt = st.microPauseHold > 0 and " [PAUSE]" or ""
    table.insert(msgs, string.format("◆ %s  %dst  →%s%s%s%s%s%s%s", name, dist, part, occ, tp, pulseTxt, retTxt, gaitTxt, pauseTxt))
  elseif st.lostFade > 0.02 then
    table.insert(msgs, string.format("◆ FADE  %.2f", st.lostFade))
  else
    table.insert(msgs, "◆ IDLE")
  end

  table.insert(msgs, string.format("MOUSE %s raw=%.0f sm=%.0f", moving and "MOV" or "STL", mouseR, mouseS))

  local rd = st.reactDelayCurrent or 0.07
  local reactPct = math.floor(clamp(st.lockAge / math.max(rd, 0.001), 0, 1) * 100)
  table.insert(msgs, string.format("REACT %.0fms %d%%  BLEND %d%%", rd * 1000, reactPct, math.floor((st.acquireBlend or 1) * 100)))

  table.insert(msgs, string.format("ω=%.0f ζ=%.2f  v=(%.0f,%.0f)",
    st.springOmega or 0, st.zetaSmooth or 0, st.springVsX or 0, st.springVsY or 0))

  table.insert(msgs, string.format("PRED conf=%.2f  lead=%.2f  retCD=%.2f",
    st.predConfidence or 1.0, C.PRED_LEAD, st.returnCooldown or 0))

  return msgs
end

local connB = UserInputService.InputBegan:Connect(function(i, gp)
  if i.KeyCode == C.TOGGLE and not st.toggleCooldown then
    st.toggleCooldown = true; st.on = not st.on
    if not st.on then
      st.m1, st.m2, st.holding = false, false, false
      st.target, st.targetChar = nil, nil
      releaseOcclusion()
    else
      st.holding = st.m1 or st.m2
    end
    return
  end
  if gp then return end
  if i.UserInputType == Enum.UserInputType.MouseButton2 and C.CLICK_R then
    st.m2 = true
    if not st.holding then
      st.holding = true; st.visCache = {}
      st.lockAge = 0
      st.acquireEnvT = 0
      st.reactDelayRolled = false
      -- FIX: primera sesión de aim, no blendear desde posición vieja
      st.aimScreenInit = false
      st.aimScreenX = 0
      st.aimScreenY = 0
      st.returnPauseTimer = 0
      st.returnPulseTimer = 0
      st.returnPulseMag = 0
      st.recentHitTime = nil
    end
  end
  if i.UserInputType == Enum.UserInputType.MouseButton1 and C.CLICK_L then
    st.m1 = true
    if not st.holding then
      st.holding = true; st.visCache = {}
      st.lockAge = 0
      st.acquireEnvT = 0
      st.reactDelayRolled = false
      -- FIX: primera sesión de aim
      st.aimScreenInit = false
      st.aimScreenX = 0
      st.aimScreenY = 0
      st.returnPauseTimer = 0
      st.returnPulseTimer = 0
      st.returnPulseMag = 0
      st.recentHitTime = nil
    end
  end
end)

local connE = UserInputService.InputEnded:Connect(function(i)
  if i.KeyCode == C.TOGGLE then st.toggleCooldown = false end
  if i.UserInputType == Enum.UserInputType.MouseButton2 then
    st.m2 = false
    if not C.AUTO and not st.m1 then
      st.holding = false; st.target, st.targetChar = nil, nil; releaseOcclusion()
      st.aimScreenInit = false
      st.returnPauseTimer = 0
      st.returnPulseTimer = 0
      st.recentHitTime = nil
    end
  end
  if i.UserInputType == Enum.UserInputType.MouseButton1 then
    st.m1 = false
    if not C.AUTO and not st.m2 then
      st.holding = false; st.target, st.targetChar = nil, nil; releaseOcclusion()
      st.aimScreenInit = false
      st.returnPauseTimer = 0
      st.returnPulseTimer = 0
      st.recentHitTime = nil
    end
  end
end)

local connR = RunService.RenderStepped:Connect(function(dt)
  camera = workspace.CurrentCamera or camera
  if not camera then return end
  updateRecoilTracker(dt)
  if not st.on or not player.Character then return end

  local rawDelta = UserInputService:GetMouseDelta()
  local rawX, rawY = rawDelta.X, rawDelta.Y
  local sentX = st.sentAccumX
  local sentY = st.sentAccumY
  local sentMag = st.lastBatchMag
  st.sentAccumX = 0; st.sentAccumY = 0; st.lastBatchMag = 0

  local userDX = rawX - sentX
  local userDY = rawY - sentY

  local thr = C.MOUSE_MIN_MAG
  if sentMag > 8 then
    local adaptive = sentMag * C.MOUSE_ADAPT_THR_MULT
    if adaptive > thr then thr = adaptive end
  end
  if thr > C.MOUSE_ADAPT_THR_MAX then thr = C.MOUSE_ADAPT_THR_MAX end

  if math.abs(userDX) < thr then userDX = 0 end
  if math.abs(userDY) < thr then userDY = 0 end

  local mag = math.sqrt(userDX * userDX + userDY * userDY)
  if mag < C.MOUSE_MIN_MAG then
    userDX = 0; userDY = 0
  elseif mag > C.MOUSE_MAX_MAG then
    local s = C.MOUSE_MAX_MAG / mag
    userDX = userDX * s; userDY = userDY * s
  end

  st.mouseDeltaX = math.floor(userDX + 0.5)
  st.mouseDeltaY = math.floor(userDY + 0.5)
  st.mouseDX = st.mouseDeltaX
  st.mouseDY = st.mouseDeltaY

  local dtSafe = math.max(dt, C.MOUSE_DT_MIN)
  local rawSpeed = math.sqrt(userDX * userDX + userDY * userDY) / dtSafe
  if rawSpeed > C.MOUSE_SPEED_CAP then rawSpeed = C.MOUSE_SPEED_CAP end
  st.mouseSpeedRaw = rawSpeed
  st.mouseSpeedSmooth = expDecay(st.mouseSpeedSmooth, rawSpeed, C.MOUSE_SMOOTH_TAU, dt)

  if _G.AA and _G.AA.notis == false then
    hudGui.Enabled = false
  else
    hudGui.Enabled = true
    hudState.lastUpdate = hudState.lastUpdate + dt
    if hudState.lastUpdate > 0.05 then
      hudState.lastUpdate = 0
      hudLabel.Text = table.concat(buildHudMessages(), "\n")
      if st.target and st.targetChar and st.targetChar.Parent then
        hudStroke.Color = Color3.fromRGB(80, 255, 140)
      elseif st.lostFade > 0.02 then
        hudStroke.Color = Color3.fromRGB(255, 200, 60)
      else
        hudStroke.Color = Color3.fromRGB(120, 140, 180)
      end
      for i, e in ipairs(hudVals) do
        e.label.Text = string.format(e.var.fmt, e.var.get())
      end
    end
  end

  if not st.holding then
    st.manualInf = 0; st.manualDownInf = 0
    st.manualHoldTimer = 0
    st.cutSmooth = 0
    st.releaseSmooth = 0
    st.springVX = st.springVX * 0.6; st.springVY = st.springVY * 0.6
    st.springVsX = st.springVsX * 0.6; st.springVsY = st.springVsY * 0.6
    st.springVsInit = false
    st.predVelInit = false; st.predBlend = 1.0
    st.predConfidence = 1.0
    st.lastFx = 0; st.lastFy = 0
    st.aimSmoothWorld = nil
    st.acquireEnvT = 0
    st.acquireBlend = 1
    st.dirChangePending = false
    st.flickTimer = 0
    st.pulseTimer = 0
    st.reactDelayRolled = false
    st.tpActive = expDecay(st.tpActive, 0, C.TP_TAU, dt)
    st.microPauseHold = 0
    st.microPauseScale = 1.0
    st.returnPauseTimer = 0
    st.returnPulseTimer = 0
    st.recentHitTime = nil
    releaseOcclusion()
    return
  end

  if not isMouseAtCenter() then return end

  local cursor = getCursor()
  selectTarget(cursor, dt)

  if not st.target or not st.targetChar or not st.targetChar.Parent then
    if st.lostFade > 0 then st.lostFade = expDecay(st.lostFade, 0, C.TAU_LOST, dt) end
    handleLostTarget(dt); return
  end
  local targetRoot = st.targetChar:FindFirstChild("HumanoidRootPart")
  if not targetRoot then handleLostTarget(dt); return end
  pushHistory(targetRoot.Position)
  if C.TP_DETECT then
    local curPos = targetRoot.Position
    if st.lastTargetPos then
      local jumpStuds = (curPos - st.lastTargetPos).Magnitude
      local velStuds = jumpStuds / math.max(dt, 0.001)
      if jumpStuds > C.TP_JUMP_STUDS or velStuds > C.TP_VEL_THRESH then
        st.tpActive = 1.0
        st.tpIgnoreTimer = math.max(st.tpIgnoreTimer, C.PRED_TP_RESET_TIME)
      end
    end
    st.lastTargetPos = curPos
    st.tpActive = expDecay(st.tpActive, 0, C.TP_TAU, dt)
  end
  st.lockAge = st.lockAge + dt
  local aimX, aimY, targetVel = computeAimScreen(st.targetChar, dt, cursor)
  if not aimX then return end
  local fx, fy = solveMovement(cursor, aimX, aimY, dt, targetVel)
  sendMouseRelative(fx, fy)
end)

rerollAll()

_G.AA = _G.AA or {}
_G.AA.conns = {connR, connB, connE}
_G.AA.user = USER
_G.AA.notis = false
_G.AA.hud = hudGui
