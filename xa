if not root then return nil end
local y = computeDynamicAimY(char, cursor, dt, commit)
if not y then return nil end
return Vector3.new(root.Position.X, y, root.Position.Z)
end
return getAimPoint(char, cursor, dt, commit)
end
local function clampToBody(char, pos)
if not C.BODY_CLAMP_ENABLE or not pos then return pos end
local parts = getBodyParts(char)
local n = #parts
if n == 0 then return pos end
local root = char:FindFirstChild("HumanoidRootPart")
local rp = root and root.Position or parts[1].Position
local minY, maxY, maxR = math.huge, -math.huge, 0
for i = 1, n do
local p = parts[i]
local ps, sz = p.Position, p.Size
local top = ps.Y + sz.Y * 0.5
local bot = ps.Y - sz.Y * 0.5
if top > maxY then maxY = top end
if bot < minY then minY = bot end
local dx, dz = ps.X - rp.X, ps.Z - rp.Z
local r = math.sqrt(dx * dx + dz * dz) + math.max(sz.X, sz.Z) * 0.5
if r > maxR then maxR = r end
end
local pad = C.BODY_CLAMP_PAD
local lo, hi = minY + pad, maxY - pad
if lo > hi then lo = (minY + maxY) * 0.5; hi = lo end
local y = clamp(pos.Y, lo, hi)
local dx, dz = pos.X - rp.X, pos.Z - rp.Z
local d = math.sqrt(dx * dx + dz * dz)
local lim = math.max(maxR - pad, 0.3)
if d > lim then local s = lim / d; dx, dz = dx * s, dz * s end
return Vector3.new(rp.X + dx, y, rp.Z + dz)
end
local function targetAlive(char)
if not char or not char.Parent then return false end
