local function computeAimWorld(char, dt, cursor)
local root = char:FindFirstChild("HumanoidRootPart")
if not root then return nil end
local hum = char:FindFirstChildOfClass("Humanoid")
if not hum then return nil end
if C.HITBOX_SUBZONE_ENABLE then updateHitboxZone(dt) end
local basePos = resolveBaseAim(char, cursor, dt)
if not basePos then return nil end
local baseX, baseY, baseZ = basePos.X, basePos.Y, basePos.Z
local eMag = 999
local spTmp = camera:WorldToViewportPoint(Vector3.new(baseX, baseY, baseZ))
if spTmp.Z > 0 then
local dx = spTmp.X - cursor.X; local dy = spTmp.Y - cursor.Y
eMag = math.sqrt(dx * dx + dy * dy)
end
local bX, bY, bZ = updateBreathing(dt, st.lastTargetVelMag, eMag)
baseX = baseX + bX; baseY = baseY + bY; baseZ = baseZ + bZ
updateAimSpot(dt)
