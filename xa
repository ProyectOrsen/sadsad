local function isFriend(p)
    if not C.IGNORE_FRIENDS then
        return false
    end
    local uid = p.UserId
    local now = tick()
    local e = st.fCache[uid]
    if e and e.exp > now then
        return e.val
    end
    local ok, r = pcall(function()
        return player:IsFriendsWith(uid)
    end)
    local val = ok and r or false
    st.fCache[uid] = {val = val, exp = now + 30}
    return val
end

local function isEdgeThin(result, fromPos)
    local inst = result.Instance
    if not inst or not inst:IsA("BasePart") then
        return false
    end
    if inst.Transparency >= C.TRANSPARENCY_BYPASS then
        return true
    end
    local rp2 = RaycastParams.new()
    rp2.FilterType = Enum.RaycastFilterType.Include
    rp2.FilterDescendantsInstances = {inst}
    local dir = fromPos - result.Position
    if dir.Magnitude < 0.001 then
        return true
    end
    local exit = workspace:Raycast(result.Position, dir * 1.05, rp2)
    local thickness
    if not exit then
        local sz = inst.Size
        thickness = math.min(sz.X, sz.Y, sz.Z)
    else
        thickness = (result.Position - exit.Position).Magnitude
    end
    return thickness <= C.EDGE_THICKNESS
end

local function canSee(head, model)
    if not C.WALLCHECK then
        return true
    end
    local now = tick()
    local cached = st.visCache[model]
    if cached and (now - cached.time) < (C.VIS_CACHE_TIME or 0.15) then
        return cached.result
    end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local excludeList = {model}
    if player.Character then
        table.insert(excludeList, player.Character)
    end
    rp.FilterDescendantsInstances = excludeList
    local pos = camera.CFrame.Position
    local thinCount = 0
    local visible = false
    for _ = 1, C.WALL_BOUNCES do
        local dir = head.Position - pos
        if dir.Magnitude < 0.001 then
            visible = true
            break
        end
        local result = workspace:Raycast(pos, dir, rp)
        if not result then
            visible = true
            break
        end
        if (result.Position - head.Position).Magnitude < 0.08 then
            visible = true
            break
        end
        if result.Instance:IsDescendantOf(model) then
            visible = true
            break
        end
        if isEdgeThin(result, head.Position) then
            thinCount = thinCount + 1
            if thinCount > C.MAX_THIN_LAYERS then
                visible = false
                break
            end
            local newEx = {table.unpack(rp.FilterDescendantsInstances)}
            table.insert(newEx, result.Instance)
            rp.FilterDescendantsInstances = newEx
            pos = result.Position
        else
            visible = false
            break
        end
    end
    st.visCache[model] = {time = now, result = visible}
    return visible
end

local function isJudgeChar(char)
    if not char then
        return false
    end
    for _, kw in ipairs(C.JUDGE_NAME_KEYWORDS) do
        if string.find(char.Name, kw) then
            return true
        end
    end
    return false
end

local function updateSupportY(dt, char, rootPart)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local rawAirborne = hum and hum.FloorMaterial == Enum.Material.Air or false
    if rawAirborne then
        st.airborneRawTimer = st.airborneRawTimer + dt
    else
        st.airborneRawTimer = 0
    end
    local wasConfirmed = st.wasAirborneConfirmed
    local isAirborne = st.airborneRawTimer >= C.AIRBORNE_CONFIRM_TIME
    st.wasAirborneConfirmed = isAirborne
    if isAirborne then
        st.frozenSupportYSet = false
        return rootPart.Position.Y, true
    else
        if wasConfirmed then
            st.landingWindow = C.LANDING_WINDOW_TIME
            st.justLanded = true
        end
        st.landingWindow = math.max(st.landingWindow - dt, 0)
        st.frozenSupportYSet = false
        return rootPart.Position.Y, false
    end
end

local function getAimWorldPos(char, dt, manualDownFactor, isJudge)
    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not head or not root then
        return nil
    end
    st.aimBiasCD = st.aimBiasCD - dt
    if st.aimBiasCD <= 0 then
        local maxB = isJudge and math.min(C.AIM_BIAS_MAX, C.JUDGE_MAX_BIAS) or C.AIM_BIAS_MAX
        st.aimBiasTarget = rRange(C.AIM_BIAS_MIN, maxB)
        st.aimBiasCD = rRange(C.AIM_BIAS_CHANGE_MIN, C.AIM_BIAS_CHANGE_MAX)
    end
    st.aimBias = st.aimBias + (st.aimBiasTarget - st.aimBias) * math.min(C.AIM_BIAS_LERP * 60 * dt, 1)
    local upVec = root.CFrame.UpVector
    local uprightness = clamp(upVec.Y, 0, 1)
    local bias = st.aimBias
    if uprightness < 0.55 then
        bias = lerp(bias, 0.68, 1 - uprightness)
    end
    bias = lerp(bias, C.SUPPORT_BIAS_MIN, manualDownFactor)
    if isJudge then
        bias = math.min(bias, C.JUDGE_MAX_BIAS)
    end
    local rootY = root.Position.Y
    local supportY, isAirborne = updateSupportY(dt, char, root)
    -- En aire: casi no reduce bias (sigue al head)
    if isAirborne then
        bias = bias * C.AIRBORNE_BIAS_REDUCE
    end
    if not st.supportFrozenSet and not isAirborne then
        st.supportFrozenY = rootY
        st.supportFrozenSet = true
    end
    if isAirborne and st.supportFrozenSet then
        local maxDrop = C.SUPPORT_MAX_DROP_STUDS or 7.0
        local limitY = st.supportFrozenY - maxDrop
        if rootY < limitY then
            supportY = limitY
        else
            supportY = rootY
        end
        if uprightness < 0.4 then
            bias = bias * (C.SUPPORT_TILTED_REDUCE or 0.88)
        end
    else
        st.supportFrozenY = rootY
    end
    local yOffset = (head.Position.Y - rootY) * bias
    local useY = supportY + yOffset
    local x = lerp(root.Position.X, head.Position.X, bias)
    local z = lerp(root.Position.Z, head.Position.Z, bias)
    return Vector3.new(x, useY, z), isAirborne
end

local function canSeePart(part, char)
    if not C.WALLCHECK then
        return true
    end
    local now = tick()
    local cached = st.visCache[part]
    if cached and cached.time and now - cached.time < (C.VIS_CACHE_TIME or 0.15) then
        return cached.result
    end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {char}
    if player.Character then
        table.insert(exclude, player.Character)
    end
    rp.FilterDescendantsInstances = exclude
    local origin = camera.CFrame.Position
    local dir = part.Position - origin
    if dir.Magnitude < 0.001 then
        st.visCache[part] = {time = now, result = true}
        return true
    end
    local result = workspace:Raycast(origin, dir, rp)
    local visible = false
    if not result then
        visible = true
    elseif result.Instance:IsDescendantOf(char) then
        visible = true
    elseif (result.Position - part.Position).Magnitude < 0.4 then
        visible = true
    end
    st.visCache[part] = {time = now, result = visible}
    return visible
end

local function getAimSpotOffset(partName, dt)
    if not C.AIM_SPOT_ENABLE then
        return Vector2.new(0, 0)
    end
    st.aimSpotChangeTimer = st.aimSpotChangeTimer - dt
    if st.aimSpotChangeTimer <= 0 then
        st.aimSpotChangeTimer = rRange(C.AIM_SPOT_CHANGE_TIME_MIN, C.AIM_SPOT_CHANGE_TIME_MAX)
        local rangeX, rangeY
        if partName == "Head" or partName == "HeadCollider" then
            rangeX = C.AIM_SPOT_HEAD_RANGE
            rangeY = C.AIM_SPOT_HEAD_RANGE
        elseif partName == "Torso" or partName == "UpperTorso" then
            rangeX = C.AIM_SPOT_TORSO_RANGE
            rangeY = C.AIM_SPOT_TORSO_RANGE
        else
            rangeX = 0.12
            rangeY = 0.12
        end
        st.aimSpotTarget = Vector2.new(
            rRange(-rangeX, rangeX),
            rRange(-rangeY, rangeY)
        )
    end
    st.aimSpotNoiseTime = st.aimSpotNoiseTime + dt * C.AIM_SPOT_NOISE_SPEED
    local noiseX = perlin1d(st.aimSpotNoiseTime) * C.AIM_SPOT_NOISE_AMP
    local noiseY = perlin1d(st.aimSpotNoiseTime + 47.3) * C.AIM_SPOT_NOISE_AMP
    st.aimSpotOffset = st.aimSpotOffset + (st.aimSpotTarget - st.aimSpotOffset) * math.min(C.AIM_SPOT_SMOOTH * 60 * dt, 1)
    return st.aimSpotOffset + Vector2.new(noiseX, noiseY)
end

local function getDynamicAimWorldPos(char, dt, manualDownFactor, isJudge)
    if not C.DYNAMIC_AIM_ENABLE then
        return getAimWorldPos(char, dt, manualDownFactor, isJudge)
    end
    local fallback, air = getAimWorldPos(char, dt, manualDownFactor, isJudge)
    if not fallback then
        return nil
    end
    local speed = mv.smoothSpeed
    local isMoving = speed > C.HEAD_LOCK_MAX_SPEED
    -- En aire o moviéndose: prioriza Head siempre
    if isMoving or air then
        local head = char:FindFirstChild("Head") or char:FindFirstChild("HeadCollider")
        if head and canSeePart(head, char) then
            st.aimPartName = head.Name
            local spotOffset = getAimSpotOffset(head.Name, dt)
            local right = camera.CFrame.RightVector
            local up = camera.CFrame.UpVector
            local spotOffsetWorld = right * spotOffset.X + up * spotOffset.Y
            local targetPos = head.Position + spotOffsetWorld
            if not st.dynamicAimInit then
                st.dynamicAimPos = targetPos
                st.dynamicAimInit = true
            else
                st.dynamicAimPos = st.dynamicAimPos:Lerp(targetPos, math.min(0.78 * 60 * dt, 1))
            end
            return st.dynamicAimPos, air
        end
    end
    st.partNoiseTime = st.partNoiseTime + dt * C.PART_NOISE_SPEED
    st.partVariationCD = st.partVariationCD - dt
    if st.partVariationCD <= 0 and not isMoving and not air then
        st.forcePartVariation = true
        st.partVariationCD = rRange(C.PART_VARIATION_MIN, C.PART_VARIATION_MAX)
    end
    local cursor = getAimCursor()
    local bestPart = nil
    local bestScore = math.huge
    for idx, partName in ipairs(C.AIM_PART_NAMES) do
        local part = char:FindFirstChild(partName)
        if part and canSeePart(part, char) then
            local sp = camera:WorldToViewportPoint(part.Position)
            if sp.Z > 0 then
                local dx = sp.X - cursor.X
                local dy = sp.Y - cursor.Y
                local dist = math.sqrt(dx * dx + dy * dy)
                local bonus = 0
                local n = part.Name
                if n == "Head" or n == "HeadCollider" then
                    bonus = C.HEAD_PRIORITY_BONUS
                elseif n == "Torso" or n == "UpperTorso" or n:find("Torso") then
                    bonus = C.TORSO_PRIORITY_BONUS
                end
                local noise = perlin1d(st.partNoiseTime + idx * 19.7) * C.PART_NOISE_AMP
                local score = dist - bonus + noise
                if st.aimPartName == n then
                    score = score - C.AIM_PART_STICKY
                end
                if st.forcePartVariation and st.aimPartName == n then
                    score = score + C.PART_VARIATION_SCORE
                end
                if score < bestScore then
                    bestScore = score
                    bestPart = part
                end
            end
        end
    end
    if not bestPart then
        return fallback, air
    end
    local oldPart = st.aimPartName
    st.aimPartName = bestPart.Name
    if st.forcePartVariation then
        st.forcePartVariation = false
    end
    local spotOffset = getAimSpotOffset(bestPart.Name, dt)
    local right = camera.CFrame.RightVector
    local up = camera.CFrame.UpVector
    local spotOffsetWorld = right * spotOffset.X + up * spotOffset.Y
    local targetPos = bestPart.Position + spotOffsetWorld
    if not st.dynamicAimInit then
        st.dynamicAimPos = targetPos
        st.dynamicAimInit = true
    else
        local alpha = C.AIM_PART_LERP
        if oldPart ~= bestPart.Name then
            alpha = math.min(0.8, alpha * 1.15)
        end
        st.dynamicAimPos = st.dynamicAimPos:Lerp(targetPos, math.min(alpha * 60 * dt, 1))
    end
    return st.dynamicAimPos, air
end

local function getSilhouette(char)
    if not char then
        return nil
    end
    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not head or not root then
        return nil
    end
    local topV3 = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6 + C.BODY_TOP_EXTRA, 0))
    local botV3 = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 1.9 + C.BODY_BOT_EXTRA, 0))
    if topV3.Z <= 0 or botV3.Z <= 0 then
        return nil
    end
    local sideW = root.Position + camera.CFrame.RightVector * (C.BODY_WIDTH_STUDS * 0.5)
    local sideSp = camera:WorldToViewportPoint(sideW)
    local ctrSp = camera:WorldToViewportPoint(root.Position)
    local wPx = math.max(
        (Vector2.new(sideSp.X, sideSp.Y) - Vector2.new(ctrSp.X, ctrSp.Y)).Magnitude,
        10
    )
    return {
        top = Vector2.new(topV3.X, topV3.Y),
        bot = Vector2.new(botV3.X, botV3.Y),
        hw = wPx + C.BODY_MARGIN_PX,
    }
end

local function checkBody(cursor, sil)
    if not sil then
        return false, cursor, 0
    end
    local seg = sil.bot - sil.top
    local lenSq = seg.X * seg.X + seg.Y * seg.Y
    local t = 0
    if lenSq > 0.001 then
        t = clamp(
            ((cursor.X - sil.top.X) * seg.X + (cursor.Y - sil.top.Y) * seg.Y) / lenSq,
            0,
            1
        )
    end
    local cl = Vector2.new(sil.top.X + seg.X * t, sil.top.Y + seg.Y * t)
    local dist = (cursor - cl).Magnitude
    return dist <= sil.hw, cl, math.max(dist - sil.hw, 0)
end

local function findFolders(root, path, i)
    if i > #path then
        return {root}
    end
    local found = {}
    for _, c in ipairs(root:GetChildren()) do
        if c.Name == path[i] and (c:IsA("Folder") or c:IsA("Model")) then
            for _, s2 in ipairs(findFolders(c, path, i + 1)) do
                table.insert(found, s2)
            end
        end
    end
    return found
end

local function getNPCs()
    local now = tick()
    if now - st.npcCacheTime > C.NPC_CACHE_TIME then
        local result = {}
        local seen = {}
        for _, path in ipairs(C.NPC_PATHS or {}) do
            for _, folder in ipairs(findFolders(workspace, path, 1)) do
                for _, child in ipairs(folder:GetChildren()) do
                    local h = child:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 and not seen[child] then
                        seen[child] = true
                        table.insert(result, child)
                    end
                end
            end
        end
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and not seen[obj] then
                local h = obj:FindFirstChildOfClass("Humanoid")
                local isPlayer = false
                for _, p in Players:GetPlayers() do
                    if p.Character == obj then
                        isPlayer = true
                        break
                    end
                end
                if h and h.Health > 0 and not isPlayer then
                    seen[obj] = true
                    table.insert(result, obj)
                end
            end
        end
        st.npcCache = result
        st.npcCacheTime = now
    end
    return st.npcCache
end

local function getCandidates(cursor, fovR)
    local mc = player.Character
    local mr = mc and mc:FindFirstChild("HumanoidRootPart")
    if not mr then
        return {}
    end
    local list = {}
    local function tryAdd(char, maxD)
        if not char then
            return
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            return
        end
        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not head or not root then
            return
        end
        local worldD = (root.Position - mr.Position).Magnitude
        if worldD > maxD then
            return
        end
        if isJudgeChar(char) and worldD > C.JUDGE_MAX_DIST then
            return
        end
        local spV3 = camera:WorldToViewportPoint(head.Position)
        if spV3.Z <= 0 then
            return
        end
        local spos = Vector2.new(spV3.X, spV3.Y)
        local sd = (spos - cursor).Magnitude
        if sd > (fovR or C.FOV) then
            return
        end
        if not canSee(head, char) then
            return
        end
        table.insert(list, {
            head = head,
            char = char,
            spos = spos,
            sd = sd,
            root = root,
        })
    end
    for _, p in Players:GetPlayers() do
        if p ~= player and not isFriend(p) then
            tryAdd(p.Character, C.MAX_DIST)
        end
    end
    if C.AIM_NPC then
        for _, npc in ipairs(getNPCs()) do
            tryAdd(npc, C.MAX_DIST_NPC)
        end
    end
    table.sort(list, function(a, b)
        return a.sd < b.sd
    end)
    return list
end

local function triggerFlick(reason)
    if not C.FLICK_ENABLE then
        return
    end
    if fk.active or fk.cooldown > 0 then
        return
    end
    if st.manualOverride > 0.32 then
        return
    end
    if st.motionReactActive then
        return
    end
    fk.active = true
    fk.phase = 0
    fk.timer = 0
    fk.delay = rRange(0.012, 0.028)
    fk.burst = rRange(0.032, 0.052)
    fk.recover = rRange(0.045, 0.085)
    fk.boost = rRange(C.FLICK_BOOST_MIN, C.FLICK_BOOST_MAX)
    local style = math.random()
    if style < 0.38 then
        fk.overshoot = -rRange(0.015, 0.14)
    elseif style < 0.88 then
        fk.overshoot = rRange(0.08, 0.42)
    else
        fk.overshoot = rRange(0.28, 0.72)
    end
    fk.angleOffset = rRange(-C.FLICK_ANGLE_MAX, C.FLICK_ANGLE_MAX)
    if reason == "screen" then
        fk.delay = fk.delay * 0.88
        fk.boost = fk.boost * 1.02
    elseif reason == "turn" then
        fk.angleOffset = fk.angleOffset * 1.02
    elseif reason == "stop" then
        fk.delay = fk.delay * 0.92
        fk.boost = fk.boost * 0.84
        fk.overshoot = fk.overshoot * 0.25
    elseif reason == "strafe" then
        fk.overshoot = fk.overshoot * 0.5
    end
end

local function startHumanReaction(isJudge, isLanding, extraDelay)
    st.reactState = "DELAY"
    st.reactTimer = 0
    local delayMult = 1.0
    if isJudge then
        delayMult = C.JUDGE_REACT_SCALE
    end
    if isLanding then
        delayMult = delayMult + C.LANDING_REACT_PENALTY
    end
    local baseDelay = rRange(C.REACT_DELAY_MIN, C.REACT_DELAY_MAX) * delayMult
    if extraDelay then
        baseDelay = baseDelay + extraDelay
    end
    st.reactDelayDur = baseDelay
    local ang = math.random() * 6.28
    local overScale = 1.0
    if st.targetSpos then
        local cursor = getAimCursor()
        local dist = (st.targetSpos - cursor).Magnitude
        local closePx = C.REACT_OVERSHOOT_CLOSE_PX or 7
        local farPx = C.REACT_OVERSHOOT_FAR_PX or 40
        overScale = clamp((dist - closePx) / math.max(farPx - closePx, 0.001), 0, 1)
    end
    if isLanding then
        overScale = overScale * 0.35
    end
    local errMag = rRange(0.04, C.REACT_OVERSHOOT_PX) * overScale
    st.reactErrorOffset = Vector2.new(math.cos(ang) * errMag, math.sin(ang) * errMag)
end

local function getReactionMultiplier(dt)
    if st.reactState == "IDLE" then
        return 1.0
    end
    st.reactTimer = st.reactTimer + dt
    if st.reactState == "DELAY" then
        if st.reactTimer >= st.reactDelayDur then
            st.reactState = "ACCEL"
            st.reactTimer = 0
        end
        return 0.0
    elseif st.reactState == "ACCEL" then
        local p = clamp(st.reactTimer / math.max(C.REACT_ACCEL_TIME, 0.001), 0, 1)
        local curveVal = p ^ math.max(C.REACT_ACCEL_CURVE, 0.001)
        if p >= 1 then
            st.reactState = "CORRECT"
            st.reactTimer = 0
        end
        return curveVal * 0.88
    elseif st.reactState == "CORRECT" then
        local correctTime = math.max(C.REACT_OVERSHOOT_PX / math.max(C.REACT_CORRECT_SPEED, 0.001), 0.02)
        local p = clamp(st.reactTimer / correctTime, 0, 1)
        if p >= 1 then
            st.reactState = "TRACK"
        end
        return 0.88 + (p * 0.12)
    elseif st.reactState == "TRACK" then
        return 1.0
    end
    return 1.0
end

