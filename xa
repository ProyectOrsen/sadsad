local function triggerFlick(reason)
    if not C.FLICK_ENABLE then
        return
    end

    if fk.active or fk.cooldown > 0 then
        return
    end

    if st.manualOverride > 0.45 then
        return
    end

    if st.motionReactActive then
        return
    end

    fk.active = true
    fk.phase = 0
    fk.timer = 0

    fk.delay = rRange(0.025, 0.055)
    fk.burst = rRange(0.045, 0.075)
    fk.recover = rRange(0.070, 0.120)
    fk.boost = rRange(C.FLICK_BOOST_MIN, C.FLICK_BOOST_MAX)

    local style = math.random()

    if style < 0.25 then
        fk.overshoot = -rRange(0.03, 0.40)
    elseif style < 0.80 then
        fk.overshoot = rRange(0.15, 0.95)
    else
        fk.overshoot = rRange(0.60, 1.60)
    end

    fk.angleOffset = rRange(-C.FLICK_ANGLE_MAX, C.FLICK_ANGLE_MAX)

    if reason == "screen" then
        fk.delay = fk.delay * 0.90
        fk.boost = fk.boost * 1.02
    elseif reason == "turn" then
        fk.angleOffset = fk.angleOffset * 1.03
    elseif reason == "stop" then
        fk.delay = fk.delay * 0.95
        fk.boost = fk.boost * 0.95
        fk.overshoot = fk.overshoot * 0.55
    elseif reason == "strafe" then
        fk.overshoot = fk.overshoot * 0.70
    end
end

local function startHumanReaction(isJudge, isLanding, extraDelay)
    st.reactState = "DELAY"
    st.reactTimer = 0

    local delayMult = 1.0

    if isJudge then
        delayMult = C.JUDGE_REACT_SCALE
    end

    if isLanding then
        delayMult = delayMult + C.LANDING_REACT_PENALTY
    end

    local baseDelay = rRange(C.REACT_DELAY_MIN, C.REACT_DELAY_MAX) * delayMult

    if extraDelay then
        baseDelay = baseDelay + extraDelay
    end

    st.reactDelayDur = baseDelay

    local ang = math.random() * 6.28
    local overScale = 1.0

    if st.targetSpos then
        local cursor = getAimCursor()
        local dist = (st.targetSpos - cursor).Magnitude

        local closePx = C.REACT_OVERSHOOT_CLOSE_PX or 25
        local farPx = C.REACT_OVERSHOOT_FAR_PX or 110

        overScale = clamp((dist - closePx) / math.max(farPx - closePx, 0.001), 0, 1)
    end

    if isLanding then
        overScale = overScale * 0.55
    end

    local errMag = rRange(0.3, C.REACT_OVERSHOOT_PX) * overScale
    st.reactErrorOffset = Vector2.new(math.cos(ang) * errMag, math.sin(ang) * errMag)
end

local function getReactionMultiplier(dt)
    if st.reactState == "IDLE" then
        return 1.0
    end

    st.reactTimer = st.reactTimer + dt

    if st.reactState == "DELAY" then
        if st.reactTimer >= st.reactDelayDur then
            st.reactState = "ACCEL"
            st.reactTimer = 0
        end

        return 0.0
    elseif st.reactState == "ACCEL" then
        local p = clamp(st.reactTimer / math.max(C.REACT_ACCEL_TIME, 0.001), 0, 1)
        local curveVal = p ^ math.max(C.REACT_ACCEL_CURVE, 0.001)

        if p >= 1 then
            st.reactState = "CORRECT"
            st.reactTimer = 0
        end

        return curveVal * 0.82
    elseif st.reactState == "CORRECT" then
        local correctTime = math.max(C.REACT_OVERSHOOT_PX / math.max(C.REACT_CORRECT_SPEED, 0.001), 0.03)
        local p = clamp(st.reactTimer / correctTime, 0, 1)

        if p >= 1 then
            st.reactState = "TRACK"
        end

        return 0.82 + (p * 0.18)
    elseif st.reactState == "TRACK" then
        return 1.0
    end

    return 1.0
end

