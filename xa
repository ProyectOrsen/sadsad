if relMag > C.RELEASE_MAX_PIXELS then
local s = C.RELEASE_MAX_PIXELS / relMag
fx = fx * s; fy = fy * s
end
if math.abs(fx) > 0.001 or math.abs(fy) > 0.001 then sendMouseRelative(fx, fy) end
if st.lostTimer > C.LOST_CLEANUP_TIME then
st.springVX = 0; st.springVY = 0; st.springVsX = 0; st.springVsY = 0
st.recoilOffsetY = 0
st.hist = {}; st.tpActive = 0; st.predVelInit = false; st.predBlend = 1.0
st.predConfidence = 1.0
st.predVelSmoothX = 0; st.predVelSmoothZ = 0
st.predVelYSmooth = 0; st.predYSmooth = 0
