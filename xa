local _perm = {}
for i = 0, 255 do
    _perm[i] = i
end
for i = 255, 1, -1 do
    local j = math.random(0, i)
    _perm[i], _perm[j] = _perm[j], _perm[i]
end
for i = 0, 255 do
    _perm[256 + i] = _perm[i]
end

local function _fade(t)
    return t * t * t * (t * (t * 6 - 15) + 10)
end

local function _grad(h, x)
    return (h % 2 == 0) and x or -x
end

local function perlin1d(x)
    local xi = math.floor(x) % 256
    local xf = x - math.floor(x)
    local u = _fade(xf)
    local a = _grad(_perm[xi], xf)
    local b = _grad(_perm[xi + 1], xf - 1)
    return a + u * (b - a)
end

