px = px * closeScale; py = py * closeScale; pz = pz * closeScale
end
local hMag = math.sqrt(px * px + pz * pz)
if hMag > C.PRED_MAX then
local s = C.PRED_MAX / hMag; px, pz = px * s, pz * s
end
return Vector3.new(px, py, pz)
end
local function applySurfacePrediction(predOffset)
if not C.SURFACE_PREDICT_ENABLE then return predOffset end
if not st.targetChar or not st.targetChar.Parent then return predOffset end
local root = st.targetChar:FindFirstChild("HumanoidRootPart")
if not root then return predOffset end
local velX = st.predVelSmoothX or 0
local velZ = st.predVelSmoothZ or 0
local velMag = math.sqrt(velX * velX + velZ * velZ)
if velMag < C.SURFACE_PREDICT_VEL_MIN then return predOffset end
local dirX, dirZ = velX / velMag, velZ / velMag
local horizPx = predOffset.X; local horizPz = predOffset.Z
local horizMag = math.sqrt(horizPx * horizPx + horizPz * horizPz)
if horizMag < 0.1 then return predOffset end
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
local ex = {}
if st.targetChar then table.insert(ex, st.targetChar) end
if player.Character then table.insert(ex, player.Character) end
rp.FilterDescendantsInstances = ex; rp.IgnoreWater = true
pcall(function() rp.RespectCanCollide = C.WB_RESPECT_CANCOLLIDE end)
local castLen = math.min(C.SURFACE_PREDICT_MAX_CAST, horizMag + C.SURFACE_PREDICT_MARGIN * 2 + 3)
local castVec = Vector3.new(dirX, 0, dirZ) * castLen
local result = workspace:Raycast(root.Position, castVec, rp)
if result then
local hitDist = (result.Position - root.Position).Magnitude
local maxHoriz = math.max(0, hitDist - C.SURFACE_PREDICT_MARGIN)
if maxHoriz < horizMag then
local capScale = maxHoriz / horizMag
predOffset = Vector3.new(predOffset.X * capScale, predOffset.Y, predOffset.Z * capScale)
end
end
if C.SURFACE_PREDICT_GROUND_ENABLE and predOffset.Y < -0.5 then
local downCast = Vector3.new(0, predOffset.Y - 2, 0)
local gres = workspace:Raycast(root.Position, downCast, rp)
if gres then
local groundDist = (root.Position - gres.Position).Magnitude
if math.abs(predOffset.Y) > groundDist then
local newY = -math.max(0, groundDist - C.SURFACE_PREDICT_GROUND_MARGIN)
predOffset = Vector3.new(predOffset.X, newY, predOffset.Z)
end
end
end
return predOffset
end
local function updateAimDrift(dt, eMag)
st.aimDriftT = st.aimDriftT + dt
if eMag > C.AIM_DRIFT_RANGE then return 0, 0 end
local nearMul = 1.0
if eMag < 4.0 then nearMul = C.AIM_DRIFT_NEAR_MULT end
local fMod = 1 + n1(st.aimDriftT * 0.15, 130) * C.AIM_DRIFT_FREQ_MOD
local dx = fbm1(st.aimDriftT * C.AIM_DRIFT_FREQ * fMod, 131, 3) * C.AIM_DRIFT_AMP_X * nearMul
local dy = fbm1(st.aimDriftT * C.AIM_DRIFT_FREQ * fMod * 0.87, 132, 3) * C.AIM_DRIFT_AMP_Y * nearMul
