scale = scale * st.predLearn * lerp(1, C.PRED_FAR_MULT, smoothstep(C.PRED_FAR_START, C.PRED_FAR_END, st.targetWorldD or 0))
local px = pvx * scale
local pz = pvz * scale
if C.PRED_CLOSE_ENABLE and st.targetWorldD then
local t = clamp((st.targetWorldD - C.PRED_CLOSE_NEAR) / math.max(C.PRED_CLOSE_FAR - C.PRED_CLOSE_NEAR, 1), 0, 1)
t = t * t * (3 - 2 * t)
