local PART_BIAS = { Head = 10, UpperTorso = 0, Torso = 0, LowerTorso = -4 }
local function visibleParts(char)
local out = {}
for _, p in ipairs(getBodyParts(char)) do
if p.Name ~= "HumanoidRootPart" and p.Transparency < 0.9 and p.Size.Magnitude > 0.2 then
out[#out + 1] = p
end
