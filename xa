if fMag2X > capX then fx = fx * (capX / fMag2X) end
if fMag2Y > capY then fy = fy * (capY / fMag2Y) end
end
if st.releaseSmooth > 0.001 then
local mul = 1 - st.releaseSmooth
fx = fx * mul; fy = fy * mul
end
local fovFade = 1 - smoothstep(C.FOV * C.FOV_FADE_START, C.FOV * C.FOV_FADE_END, eMag)
local lf = smoothstep(0, 1, clamp(st.lostFade, 0, 1))
