local function updateHitboxZone(dt)
  st.hitboxOffsetTimer = st.hitboxOffsetTimer - dt
  if st.hitboxOffsetTimer <= 0 then
    local s = 0.55
    local r = C.HITBOX_SUBZONE_RATIO
    st.hitboxOffsetTarget = Vector3.new(
      rRange(-s * r, s * r),
      rRange(-s * r, s * r),
      rRange(-s * r, s * r)
    )
    st.hitboxOffsetTimer = rRange(C.HITBOX_SUBZONE_CHANGE_MIN, C.HITBOX_SUBZONE_CHANGE_MAX)
  end
  local a = 1 - math.exp(-dt / C.HITBOX_SUBZONE_TAU)
  st.hitboxOffset = st.hitboxOffset + (st.hitboxOffsetTarget - st.hitboxOffset) * a
end

local function sendMouseRelative(x, y)
  x = x * C.MOUSE_SCALE; y = y * C.MOUSE_SCALE
  st.accumX = st.accumX + x; st.accumY = st.accumY + y
  local ix = st.accumX >= 0 and math.floor(st.accumX + 0.5) or math.ceil(st.accumX - 0.5)
  local iy = st.accumY >= 0 and math.floor(st.accumY + 0.5) or math.ceil(st.accumY - 0.5)
  if ix ~= 0 or iy ~= 0 then
    st.accumX = st.accumX - ix; st.accumY = st.accumY - iy
    pcall(function() mousemoverel(ix, iy) end)
    st.sentAccumX = st.sentAccumX + ix
    st.sentAccumY = st.sentAccumY + iy
    local m = math.sqrt(ix * ix + iy * iy)
    if m > st.lastBatchMag then st.lastBatchMag = m end
    st.lastSendTime = tick()
    st.lastSentY = iy
  else
    st.lastSentY = 0
  end
end

local function isEdgeThin(result, fromPos)
  local inst = result.Instance
  if not inst or not inst:IsA("BasePart") then return false end
  if inst.Transparency >= C.TRANSP_BYPASS then return true end
  if not inst.CanCollide then return true end
  local rp = RaycastParams.new()
  rp.FilterType = Enum.RaycastFilterType.Include
  rp.FilterDescendantsInstances = {inst}
  local dir = fromPos - result.Position
  if dir.Magnitude < 0.001 then return true end
  local exit = workspace:Raycast(result.Position, dir * 1.05, rp)
  if not exit then return false end
  return (result.Position - exit.Position).Magnitude <= C.EDGE_THIN
end
local function canSee(targetPos, model)
  if not C.WALLCHECK then return true end
  if not targetPos or not model then return true end
  local now = tick()
  local c = st.visCache[model]
  if c and now - c.t < C.VIS_CACHE then
    if c.pos and (targetPos - c.pos).Magnitude < C.VIS_POS_INVALIDATE then return c.r end
  end
  local origin = camera.CFrame.Position
  local delta = targetPos - origin; local dist = delta.Magnitude
  if dist < 0.01 then st.visCache[model] = {t = now, r = true, pos = targetPos}; return true end
  local dir = delta / dist
  local ex = {model}
  if player.Character then table.insert(ex, player.Character) end
  local rp = RaycastParams.new()
  rp.FilterType = Enum.RaycastFilterType.Exclude
  rp.FilterDescendantsInstances = ex; rp.IgnoreWater = true
  local visible = true; local thinCount = 0; local pos = origin
  for _ = 1, C.MAX_BOUNCE + 1 do
    local remaining = targetPos - pos
    if remaining.Magnitude < 0.01 then break end
    local result = workspace:Raycast(pos, remaining, rp)
    if not result then visible = true break end
    if (result.Position - targetPos).Magnitude < C.VIS_TARGET_RADIUS then visible = true break end
    if result.Instance and result.Instance:IsDescendantOf(model) then visible = true break end
    if isEdgeThin(result, targetPos) then
      thinCount = thinCount + 1
      if thinCount > C.MAX_THIN then visible = false break end
      pos = result.Position + dir * 0.05
    else visible = false break end
  end
  st.visCache[model] = {t = now, r = visible, pos = targetPos}
  return visible
end
local function updateRecoilTracker(dt)
  if not C.RECOIL_DETECT or not camera then
    st.camPitchVel = 0; st.recoilSignal = expDecay(st.recoilSignal, 0, 0.02, dt); return
  end
  local look = camera.CFrame.LookVector
  local pitch = math.asin(clamp(look.Y, -1, 1))
  if st.lastPitch then
    local rawVel = (pitch - st.lastPitch) / math.max(dt, 0.001)
    st.camPitchVel = st.camPitchVel + (rawVel - st.camPitchVel) * math.min(dt * 60, 1)
  end
  st.lastPitch = pitch
  local ourPitchVel = st.lastSentY * 60 * C.RECOIL_SENS
  local recoilRaw = clamp(st.camPitchVel - ourPitchVel, -C.RECOIL_SIGNAL_CLAMP, C.RECOIL_SIGNAL_CLAMP)
  st.recoilSignal = expDecay(st.recoilSignal, recoilRaw, 0.06, dt)
end
local function findFolders(root, path, i)
  if i > #path then return {root} end
  local found = {}
  for _, c in ipairs(root:GetChildren()) do
    if c.Name == path[i] and (c:IsA("Folder") or c:IsA("Model")) then
      for _, s in ipairs(findFolders(c, path, i + 1)) do table.insert(found, s) end
    end
  end
  return found
end
local function getNPCs()
  local now = tick()
  if now - st.npcCacheT > C.NPC_CACHE then
    local result, seen = {}, {}
    for _, path in ipairs(C.NPC_PATHS) do
      for _, folder in ipairs(findFolders(workspace, path, 1)) do
        for _, child in ipairs(folder:GetChildren()) do
          local h = child:FindFirstChildOfClass("Humanoid")
          if h and h.Health > 0 and not seen[child] then
            seen[child] = true; table.insert(result, child)
          end
        end
      end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
      if obj:IsA("Model") and not seen[obj] then
        local h = obj:FindFirstChildOfClass("Humanoid")
        local isPlayer = false
        for _, p in Players:GetPlayers() do
          if p.Character == obj then isPlayer = true break end
        end
        if h and h.Health > 0 and not isPlayer then
          seen[obj] = true; table.insert(result, obj)
        end
      end
    end
    st.npcCache = result; st.npcCacheT = now
  end
  return st.npcCache
end

local function getCandidates(cursor, fovR, currentChar)
  local mc = player.Character; local mr = mc and mc:FindFirstChild("HumanoidRootPart")
  if not mr then return {} end
  local list, seen = {}, {}
  local now = tick()
  local function tryAdd(char, maxD, isCurrent)
    if not char or not char.Parent or seen[char] then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local wd = (root.Position - mr.Position).Magnitude
    if wd > maxD then return end
    if isJudgeChar(char) and wd > C.RANGE_JUDGE then return end

    local bodyParts = getBodyParts(char)
    if #bodyParts == 0 then return end
    local bestSd, bestSpos = math.huge, nil
    for _, p in ipairs(bodyParts) do
      local sp = camera:WorldToViewportPoint(p.Position)
      if sp.Z > 0 then
        local spos = Vector2.new(sp.X, sp.Y)
        local sd = (spos - cursor).Magnitude
        if sd < bestSd then bestSd = sd; bestSpos = spos end
      end
    end
    if not bestSpos or bestSd > fovR then return end

    local visTarget = root.Position
    local head = findPart(char, "Head")
    if head then visTarget = head.Position end

    local visible = true
    if hasFilter("Visible") then
      visible = canSee(visTarget, char)
      if not visible and isCurrent then
        local sinceVis = now - (st.lastTargetVisibleTime or 0)
        if sinceVis < C.VIS_GRACE_TIME then visible = true end
      end
    end
    if not visible then return end
    if isCurrent then st.lastTargetVisibleTime = now end

    if hasFilter("Team") then
      local plr = Players:GetPlayerFromCharacter(char)
      if plr and plr.Team == player.Team then return end
    end
    if hasFilter("NPC") then
      if Players:GetPlayerFromCharacter(char) ~= nil then return end
    end
    seen[char] = true
    table.insert(list, {head = head or root, char = char, spos = bestSpos, sd = bestSd, root = root, wd = wd, isCurrent = isCurrent and true or false, visible = visible})
  end
  for _, p in Players:GetPlayers() do
    if p ~= player then tryAdd(p.Character, C.RANGE_PLAYER, p.Character == currentChar) end
  end
  if C.AIM_NPC then for _, npc in ipairs(getNPCs()) do tryAdd(npc, C.RANGE_NPC, npc == currentChar) end end
  table.sort(list, function(a, b)
    local aScore = a.sd - (a.isCurrent and C.TARGET_KEEP_BONUS or 0)
    local bScore = b.sd - (b.isCurrent and C.TARGET_KEEP_BONUS or 0)
    return aScore < bScore
  end)
  return list
end

