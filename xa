local camOk = behavior ~= Enum.MouseBehavior.Default
local raw = UserInputService:GetMouseDelta()
local look = camera.CFrame.LookVector
local pitch = math.asin(clamp(look.Y, -1, 1))
local yaw = math.atan2(-look.X, -look.Z)
Sep.step(raw.X, raw.Y, yaw, pitch, dt, camOk)
st.mouseRawX, st.mouseRawY = raw.X, raw.Y
local ux, uy = Sep.userX, Sep.userY
local mag = vlen(ux, uy)
if mag > C.MOUSE_MAX_MAG then
local s = C.MOUSE_MAX_MAG / mag
ux, uy, mag = ux * s, uy * s, C.MOUSE_MAX_MAG
end
st.mouseDeltaX, st.mouseDeltaY = ux, uy
local dtSafe = math.max(dt, C.MOUSE_DT_MIN)
st.userVelX = expDecay(st.userVelX, ux / dtSafe, C.USER_VEL_TAU, dt)
st.userVelY = expDecay(st.userVelY, uy / dtSafe, C.USER_VEL_TAU, dt)
if vlen(st.userVelX, st.userVelY) >= vlen(st.userMomX, st.userMomY) then
st.userMomX, st.userMomY = st.userVelX, st.userVelY
else
st.userMomX = expDecay(st.userMomX, 0, C.HANDOFF_MOM_TAU, dt)
st.userMomY = expDecay(st.userMomY, 0, C.HANDOFF_MOM_TAU, dt)
end
local rawSpeed = math.min(mag / dtSafe, C.MOUSE_SPEED_CAP)
st.mouseSpeedRaw = rawSpeed
st.mouseSpeedSmooth = expDecay(st.mouseSpeedSmooth, rawSpeed, C.MOUSE_SMOOTH_TAU, dt)
st.srcAimSpeed = vlen(Sep.aimX, Sep.aimY) / dtSafe
st.camPitchVel = Sep.camDPitch / dtSafe
local gRate = Sep.gamePitch / dtSafe
st.srcGameRate = gRate
if C.RECOIL_DETECT and camOk then
local sig = clamp(gRate, -C.RECOIL_SIGNAL_CLAMP, C.RECOIL_SIGNAL_CLAMP)
st.recoilSignal = expDecay(st.recoilSignal, sig, C.GAME_PITCH_TAU, dt)
